---
// 存在しないURL用のページ。Cloudflare Pages は dist/404.html を HTTP 404 で返す。
// これが無いと、どのURLにもトップページが 200 で返り「中身が同じページが無数にある」状態になる。
import Layout from '../layouts/Layout.astro';
import { tools, toolCategories } from '../data/tools';

const categories = toolCategories
  .filter((c) => c.id !== 'all')
  .map((c) => ({ ...c, tools: tools.filter((t) => t.category === c.id) }));
---

<Layout
  title="ページが見つかりません - ZeroLeak Tools"
  description="お探しのページは見つかりませんでした。ZeroLeak Tools の全ツール一覧からお探しください。"
  canonicalPath="/404/"
  noindex
>
  <div class="max-w-3xl mx-auto py-2 sm:py-6 space-y-6 text-left">
    <section class="bg-white border border-slate-200 rounded-2xl p-5 sm:p-7 space-y-3">
      <p class="text-xs font-semibold text-slate-700">エラー 404</p>
      <h1 class="text-xl sm:text-3xl font-extrabold text-slate-900 tracking-tight leading-tight">
        お探しのページは見つかりませんでした
      </h1>
      <p class="text-sm text-slate-700 leading-relaxed">
        URLが変わったか、削除された可能性があります。下の一覧から目的のツールを選んでください。
      </p>
      <div class="flex flex-wrap gap-2 pt-1">
        <a
          href="/"
          class="inline-flex items-center min-h-[44px] px-4 rounded-xl bg-slate-900 hover:bg-slate-800 text-white text-sm font-bold transition"
        >
          トップページでツールを検索する
        </a>
        <a
          href="/about/"
          class="inline-flex items-center min-h-[44px] px-4 rounded-xl bg-white hover:bg-slate-50 border border-slate-300 text-slate-900 text-sm font-bold transition"
        >
          お問い合わせ
        </a>
      </div>
    </section>

    {categories.map((c) => (
      <section class="space-y-2">
        <h2 class="text-lg font-bold text-slate-900">
          <a href={c.hubPath} class="hover:underline">{c.icon} {c.label}</a>
        </h2>
        <ul class="grid grid-cols-1 sm:grid-cols-2 gap-2">
          {c.tools.map((t) => (
            <li>
              <a
                href={t.href}
                class="flex items-center gap-2.5 min-h-[44px] px-3 py-2 rounded-xl bg-white hover:bg-slate-50 border border-slate-200 transition"
              >
                <span class="text-lg shrink-0" aria-hidden="true">{t.icon}</span>
                <span class="min-w-0">
                  <span class="block text-sm font-bold text-slate-900 truncate">{t.shortName ?? t.name}</span>
                  <span class="block text-xs text-slate-700 truncate">{t.tagline}</span>
                </span>
              </a>
            </li>
          ))}
        </ul>
      </section>
    ))}
  </div>
</Layout>
