---
import ToolShell from '../components/ToolShell.astro';

const howToSteps = [
  {
    name: '身分証画像（免許証・マイナンバー・保険証）を選択またはドロップ',
    text: 'スマートフォンで撮影した運転免許証やマイナンバーカード、健康保険証の画像をドラッグ＆ドロップまたはファイル選択で読み込みます。',
  },
  {
    name: '透かし文字と日付・不透明度・角度を調整',
    text: '「〇〇提出用 悪用禁止」などの提出先企業名や今日の日付を指定し、文字が読める範囲で透かしの濃度（20〜30%推奨）や斜めリピートパターンをプレビューしながら調整します。',
  },
  {
    name: '透かし入り画像をワンクリックで安全に保存',
    text: 'Canvas上で完全に一体化された画像をダウンロードして提出先に送信します。外部サーバーを一切経由しないため生画像流出リスクは0%です。',
  },
];

const faqs = [
  {
    question: '身分証の画像に「透かし」を入れるのはなぜ安全対策として有効なのですか？',
    answer:
      '運転免許証やマイナンバーカードの無加工画像が流出した場合、第三者に勝手に格安SIMの契約やオンライン銀行口座開設、消費者金融での不正借入れに使い回される重大な被害が発生します。「2026/10/20 〇〇社提出用 他目的使用禁止」と斜めに文字を焼き込んでおくことで、万が一提出先から画像が外部流出しても、別の審査で不正利用されることを物理的に防ぐことができます。',
  },
  {
    question: '透かしを入れた身分証は、公式の本人確認審査で受理されますか？',
    answer:
      '大半の正規企業やサービス（バイト採用、賃貸契約、フリマ本人確認等）では、氏名・生年月日・住所・有効期限・顔写真が目視で明瞭に確認できる状態であれば、悪用防止目的の半透明透かし入り画像を受理しています。ただし、提出先の自動AI審査（eKYC等）の要件によっては再提出を求められる場合があるため、ダウンロード前に重要項目が隠れていないか必ず目視でご確認ください。',
  },
  {
    question: '透かしを入れるために無料の画像加工サイトを使うのは危険ですか？',
    answer:
      '極めて危険です。一般的な無料Web画像編集サイトは、アップロードされた身分証画像をサーバーへ送信・保存して処理しています。悪用を防ぐために行ったはずの操作で、最も機密性の高い身分証の生データを運営企業や海外クラウドへ預けることになります。ZeroLeak Toolsはお使いのブラウザ内部（HTML5 Canvas）だけで処理し、外部通信は1バイトも発生しません。',
  },
  {
    question: 'マイナンバーカードの裏面（12桁のマイナンバー）も透かしで保護できますか？',
    answer:
      'はい。表面・裏面を問わず任意の画像に透かしを焼き込めます。なお、マイナンバー法により、法律で定められた公的機関や雇用主等の正規の手続きを除き、マイナンバーカード裏面（12桁の個人番号）の提出・コピーを求めることは禁止されています。一般的な本人確認では表面のみの提出が推奨されます。',
  },
];
---

<ToolShell
  slug="id-watermark"
  title="身分証・マイナンバー 悪用防止透かし焼き込み | ブラウザ完結・サーバー送信なし"
  description="運転免許証やマイナンバーカード提出時の不正利用・使い回し防止。「〇〇提出用 悪用禁止」の透かしをブラウザ内だけで斜め全面に焼き込み。外部サーバー送信0バイト。"
  canonicalPath="/id-watermark/"
  h1="身分証・マイナンバー 悪用防止透かし焼き込み"
  subtitle="バイト応募、賃貸契約、フリマ本人確認で送る免許証・マイナンバー・保険証に、「〇〇提出用 転載・悪用禁止」をブラウザ内で不可逆焼き込み。通信0バイトで安全に出力。"
  whyTitle="提出した身分証画像は「そのまま別の契約」に使い回されるリスクがある"
  howToSteps={howToSteps}
  faqs={faqs}
>
  <!-- ワンクリック検証用サンプルボタン -->
  <button
    slot="sample-button"
    id="loadSampleIdBtn"
    type="button"
    class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-xl bg-blue-50 hover:bg-blue-100 text-blue-900 border border-blue-300 text-xs font-bold transition shadow-xs cursor-pointer shrink-0"
  >
    <span>🧪</span>
    <span>見本運転免許証で試す</span>
  </button>

  <!-- メイン操作ワークスペース (2カラム: 設定コントロール ＆ リアルタイムプレビュー) -->
  <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 items-start">
    
    <!-- 左カラム：透かし設定コントロール (5カラム) -->
    <div class="lg:col-span-5 bg-white rounded-2xl border border-slate-200 shadow-xs p-5 space-y-5">
      
      <!-- ファイル選択 ＆ ドロップエリア -->
      <div class="space-y-2">
        <label class="block text-xs font-bold text-slate-800">
          1. 身分証画像を選択（免許証・マイナンバー等）
        </label>
        <div
          id="dropZone"
          class="border-2 border-dashed border-slate-300 hover:border-blue-500 rounded-xl p-4 text-center transition bg-slate-50/70 hover:bg-blue-50/20 cursor-pointer group"
        >
          <input
            type="file"
            id="imageFileInput"
            accept="image/*"
            class="hidden"
          />
          <div class="flex flex-col items-center gap-1.5 pointer-events-none">
            <span class="text-2xl group-hover:scale-110 transition-transform">📷</span>
            <p class="font-bold text-slate-700 text-xs sm:text-sm">画像をドロップ または クリックして選択</p>
            <p class="text-[11px] text-slate-600">JPEG, PNG, WebP対応 • スマホ撮影写真OK</p>
          </div>
        </div>
      </div>

      <!-- 透かしテキスト入力 -->
      <div class="space-y-2">
        <div class="flex items-center justify-between">
          <label for="watermarkText" class="block text-xs font-bold text-slate-800">
            2. 焼き込む透かし文字列
          </label>
          <button
            type="button"
            id="insertDateBtn"
            class="text-[11px] text-blue-700 hover:underline font-semibold cursor-pointer"
          >
            + 今日の日付を挿入
          </button>
        </div>
        <textarea
          id="watermarkText"
          rows="2"
          class="w-full px-3 py-2 text-xs sm:text-sm rounded-xl border border-slate-300 focus:ring-2 focus:ring-blue-500 focus:border-blue-500 font-mono"
          placeholder="〇〇社 提出用 悪用禁止"
        >〇〇提出用 悪用禁止</textarea>

        <!-- クイック挿入プリセット -->
        <div class="flex flex-wrap gap-1.5 pt-1">
          <button type="button" class="preset-btn px-2 py-0.5 rounded-lg bg-slate-100 hover:bg-slate-200 text-[11px] text-slate-700 border border-slate-200 transition">
            〇〇社 提出用 悪用禁止
          </button>
          <button type="button" class="preset-btn px-2 py-0.5 rounded-lg bg-slate-100 hover:bg-slate-200 text-[11px] text-slate-700 border border-slate-200 transition">
            本人確認用 転載禁止
          </button>
          <button type="button" class="preset-btn px-2 py-0.5 rounded-lg bg-slate-100 hover:bg-slate-200 text-[11px] text-slate-700 border border-slate-200 transition">
            賃貸契約用 他目的使用不可
          </button>
        </div>
      </div>

      <!-- 透かしレイアウトパターン -->
      <div class="space-y-2">
        <label class="block text-xs font-bold text-slate-800">
          3. 透かしの配置パターン
        </label>
        <div class="grid grid-cols-3 gap-2">
          <label class="pattern-label flex flex-col items-center justify-center p-2.5 rounded-xl border border-blue-500 bg-blue-50/50 cursor-pointer text-center transition">
            <input type="radio" name="pattern" value="repeat" checked class="hidden" />
            <span class="text-base mb-1">📐</span>
            <span class="text-xs font-bold text-slate-800">全面リピート</span>
            <span class="text-[10px] text-slate-600">（推奨）</span>
          </label>
          <label class="pattern-label flex flex-col items-center justify-center p-2.5 rounded-xl border border-slate-200 hover:border-slate-300 bg-white cursor-pointer text-center transition">
            <input type="radio" name="pattern" value="center" class="hidden" />
            <span class="text-base mb-1">➖</span>
            <span class="text-xs font-bold text-slate-800">中央1本</span>
            <span class="text-[10px] text-slate-600">（控えめ）</span>
          </label>
          <label class="pattern-label flex flex-col items-center justify-center p-2.5 rounded-xl border border-slate-200 hover:border-slate-300 bg-white cursor-pointer text-center transition">
            <input type="radio" name="pattern" value="cross" class="hidden" />
            <span class="text-base mb-1">✖️</span>
            <span class="text-xs font-bold text-slate-800">クロスX字</span>
            <span class="text-[10px] text-slate-600">（強力防御）</span>
          </label>
        </div>
      </div>

      <!-- 濃度（透明度）＆ 文字サイズ ＆ 角度スライダー -->
      <div class="space-y-3.5 pt-1 border-t border-slate-100">
        <div>
          <div class="flex justify-between text-xs mb-1">
            <span class="font-bold text-slate-700">文字の濃さ（不透明度）：</span>
            <span id="opacityVal" class="font-mono text-blue-600 font-bold">25%</span>
          </div>
          <input
            type="range"
            id="opacitySlider"
            min="10"
            max="60"
            value="25"
            class="w-full accent-blue-600 cursor-pointer"
          />
          <div class="flex justify-between text-[10px] text-slate-600">
            <span>薄め (10%)</span>
            <span>推奨 (20〜30%)</span>
            <span>濃いめ (60%)</span>
          </div>
        </div>

        <div>
          <div class="flex justify-between text-xs mb-1">
            <span class="font-bold text-slate-700">文字サイズ：</span>
            <span id="fontSizeVal" class="font-mono text-blue-600 font-bold">小</span>
          </div>
          <input
            type="range"
            id="fontSizeSlider"
            min="20"
            max="60"
            value="34"
            class="w-full accent-blue-600 cursor-pointer"
          />
        </div>

        <div>
          <div class="flex justify-between text-xs mb-1">
            <span class="font-bold text-slate-700">文字の傾き（角度）：</span>
            <span id="angleVal" class="font-mono text-blue-600 font-bold">-25°</span>
          </div>
          <input
            type="range"
            id="angleSlider"
            min="-60"
            max="60"
            value="-25"
            class="w-full accent-blue-600 cursor-pointer"
          />
        </div>

        <!-- 文字色選択 -->
        <div>
          <span class="block text-xs font-bold text-slate-700 mb-1.5">文字の色：</span>
          <div class="flex items-center gap-3">
            <label class="flex items-center gap-1.5 text-xs text-slate-700 cursor-pointer">
              <input type="radio" name="colorMode" value="red" checked class="accent-rose-600" />
              <span class="w-3.5 h-3.5 rounded-full bg-rose-600 inline-block"></span>
              <span>赤色 (警戒・目立つ)</span>
            </label>
            <label class="flex items-center gap-1.5 text-xs text-slate-700 cursor-pointer">
              <input type="radio" name="colorMode" value="dark" class="accent-slate-800" />
              <span class="w-3.5 h-3.5 rounded-full bg-slate-800 inline-block"></span>
              <span>黒色 (シック)</span>
            </label>
            <label class="flex items-center gap-1.5 text-xs text-slate-700 cursor-pointer">
              <input type="radio" name="colorMode" value="white" class="accent-slate-400" />
              <span class="w-3.5 h-3.5 rounded-full bg-white border border-slate-300 inline-block"></span>
              <span>白色 (反転)</span>
            </label>
          </div>
        </div>
      </div>

      <!-- ダウンロード ＆ アクション -->
      <div class="pt-2 border-t border-slate-100 space-y-2">
        <button
          type="button"
          id="downloadBtn"
          disabled
          class="w-full py-3 px-4 rounded-xl font-bold text-sm text-white bg-blue-600 hover:bg-blue-700 disabled:bg-slate-300 disabled:cursor-not-allowed transition shadow-xs flex items-center justify-center gap-2 cursor-pointer"
        >
          <span>📥</span>
          <span>透かし入り画像を保存（PNG）</span>
        </button>
        <div class="flex items-center gap-2 p-2.5 rounded-xl bg-blue-50 border border-blue-200 text-xs text-blue-950 font-medium">
          <span class="text-base select-none shrink-0">🛡️</span>
          <span><strong>ゼロリークくん：</strong>透かし処理はCanvas上で直接描画されています。画像が外部へ送られる心配はありません。</span>
        </div>
      </div>

    </div>

    <!-- 右カラム：リアルタイムプレビュー (7カラム) -->
    <div class="lg:col-span-7 bg-white rounded-2xl border border-slate-200 shadow-xs p-5 space-y-4">
      
      <!-- プレビューヘッダー -->
      <div class="flex items-center justify-between pb-3 border-b border-slate-100">
        <div class="flex items-center gap-2">
          <h2 class="text-sm sm:text-base font-bold text-slate-900 flex items-center gap-1.5">
            <span>🖼️ リアルタイム完成プレビュー</span>
          </h2>
          <span id="imageResolutionBadge" class="text-[11px] font-semibold px-2 py-0.5 rounded-full bg-slate-100 text-slate-600">
            画像未選択
          </span>
        </div>
        <span class="text-xs text-slate-600">提出先で文字が読めるか確認</span>
      </div>

      <!-- Canvas表示コンテナ -->
      <div class="relative bg-slate-100/70 rounded-xl border border-slate-200 overflow-hidden flex items-center justify-center min-h-[360px] p-2">
        <div id="emptyNotice" class="text-center text-slate-600 space-y-2 p-8">
          <span class="text-4xl block">🪪</span>
          <p class="text-sm font-bold text-slate-700">身分証画像が選択されていません</p>
          <p class="text-xs text-slate-600 max-w-sm mx-auto">
            左の「身分証を選択」から免許証等の写真を読み込むか、上の「🧪 見本運転免許証で試す」ボタンを押してください。
          </p>
        </div>
        <canvas id="previewCanvas" class="max-w-full max-h-[500px] object-contain rounded shadow-xs hidden"></canvas>
      </div>

      <!-- 目視確認チェックボックス ＆ アラート -->
      <div class="bg-blue-50/60 border border-blue-200 rounded-xl p-3 text-xs text-blue-900 space-y-1.5">
        <div class="font-bold flex items-center gap-1 text-blue-950">
          <span>⚠️ 提出前のチェックリスト</span>
        </div>
        <ul class="list-disc list-inside space-y-0.5 text-blue-800 text-[11px]">
          <li>氏名・生年月日・住所・有効期限・写真が透かし文字で隠れて潰れていませんか？</li>
          <li>濃すぎる場合は、左のスライダーで不透明度（20〜25%）を下げてください。</li>
          <li>「〇〇提出用」と指定した提出先企業名・日付が正しく入っていますか？</li>
        </ul>
      </div>

    </div>

  </div>

  <!-- クライアントサイドスクリプト -->
  <script>
    import {
      applyWatermarkToCanvas,
      getTodayDateString,
      generateDummyIdSvgUri,
      DEFAULT_WATERMARK_OPTIONS,
      type WatermarkOptions,
      type WatermarkPattern
    } from '../utils/id-watermark';

    const imageFileInput = document.getElementById('imageFileInput') as HTMLInputElement;
    const dropZone = document.getElementById('dropZone') as HTMLElement;
    const loadSampleIdBtn = document.getElementById('loadSampleIdBtn') as HTMLButtonElement;
    const insertDateBtn = document.getElementById('insertDateBtn') as HTMLButtonElement;
    const watermarkText = document.getElementById('watermarkText') as HTMLTextAreaElement;
    const opacitySlider = document.getElementById('opacitySlider') as HTMLInputElement;
    const opacityVal = document.getElementById('opacityVal') as HTMLElement;
    const fontSizeSlider = document.getElementById('fontSizeSlider') as HTMLInputElement;
    const fontSizeVal = document.getElementById('fontSizeVal') as HTMLElement;
    const angleSlider = document.getElementById('angleSlider') as HTMLInputElement;
    const angleVal = document.getElementById('angleVal') as HTMLElement;
    const previewCanvas = document.getElementById('previewCanvas') as HTMLCanvasElement;
    const emptyNotice = document.getElementById('emptyNotice') as HTMLElement;
    const downloadBtn = document.getElementById('downloadBtn') as HTMLButtonElement;
    const imageResolutionBadge = document.getElementById('imageResolutionBadge') as HTMLElement;
    const presetButtons = document.querySelectorAll('.preset-btn');
    const patternLabels = document.querySelectorAll('.pattern-label');

    let currentLoadedImage: HTMLImageElement | null = null;
    let originalFileName: string = 'watermarked_id.png';

    function getCurrentOptions(): WatermarkOptions {
      const selectedPatternRadio = document.querySelector('input[name="pattern"]:checked') as HTMLInputElement;
      const pattern = (selectedPatternRadio ? selectedPatternRadio.value : 'repeat') as WatermarkPattern;

      const selectedColorRadio = document.querySelector('input[name="colorMode"]:checked') as HTMLInputElement;
      const colorMode = selectedColorRadio ? selectedColorRadio.value : 'red';
      const color = colorMode === 'red' ? '#dc2626' : colorMode === 'dark' ? '#0f172a' : '#ffffff';

      const opacity = parseInt(opacitySlider.value, 10) / 100;
      const fontSize = parseInt(fontSizeSlider.value, 10);
      const angle = parseInt(angleSlider.value, 10);

      return {
        text: watermarkText.value.trim() || '〇〇提出用 悪用禁止',
        opacity,
        fontSize,
        angle,
        pattern,
        color,
      };
    }

    function renderWatermark() {
      if (!currentLoadedImage) return;

      const width = currentLoadedImage.naturalWidth || currentLoadedImage.width;
      const height = currentLoadedImage.naturalHeight || currentLoadedImage.height;

      previewCanvas.width = width;
      previewCanvas.height = height;

      const ctx = previewCanvas.getContext('2d');
      if (!ctx) return;

      ctx.clearRect(0, 0, width, height);
      ctx.drawImage(currentLoadedImage, 0, 0, width, height);

      const opts = getCurrentOptions();
      applyWatermarkToCanvas(ctx, width, height, opts);

      emptyNotice.classList.add('hidden');
      previewCanvas.classList.remove('hidden');
      downloadBtn.removeAttribute('disabled');
      imageResolutionBadge.textContent = `${width} × ${height} px`;
    }

    function loadImageFromSrc(src: string, fileName: string = 'sample_id.png') {
      const img = new Image();
      img.onload = () => {
        currentLoadedImage = img;
        originalFileName = fileName;
        renderWatermark();
      };
      img.src = src;
    }

    // ファイル選択
    imageFileInput.addEventListener('change', (e) => {
      const file = (e.target as HTMLInputElement).files?.[0];
      if (file) {
        const reader = new FileReader();
        reader.onload = (event) => {
          loadImageFromSrc(event.target?.result as string, file.name);
        };
        reader.readAsDataURL(file);
      }
    });

    // ドラッグ＆ドロップ
    dropZone.addEventListener('click', () => imageFileInput.click());
    dropZone.addEventListener('dragover', (e) => {
      e.preventDefault();
      dropZone.classList.add('border-blue-500', 'bg-blue-50/40');
    });
    dropZone.addEventListener('dragleave', () => {
      dropZone.classList.remove('border-blue-500', 'bg-blue-50/40');
    });
    dropZone.addEventListener('drop', (e) => {
      e.preventDefault();
      dropZone.classList.remove('border-blue-500', 'bg-blue-50/40');
      const file = e.dataTransfer?.files[0];
      if (file && file.type.startsWith('image/')) {
        const reader = new FileReader();
        reader.onload = (event) => {
          loadImageFromSrc(event.target?.result as string, file.name);
        };
        reader.readAsDataURL(file);
      }
    });

    // スライダー連動
    opacitySlider.addEventListener('input', () => {
      opacityVal.textContent = `${opacitySlider.value}%`;
      renderWatermark();
    });

    fontSizeSlider.addEventListener('input', () => {
      const val = parseInt(fontSizeSlider.value, 10);
      fontSizeVal.textContent = val < 30 ? '小' : val < 45 ? '中' : '大';
      renderWatermark();
    });

    angleSlider.addEventListener('input', () => {
      angleVal.textContent = `${angleSlider.value}°`;
      renderWatermark();
    });

    watermarkText.addEventListener('input', renderWatermark);

    document.querySelectorAll('input[name="pattern"]').forEach((el) => {
      el.addEventListener('change', () => {
        patternLabels.forEach((lbl) => {
          const radio = lbl.querySelector('input') as HTMLInputElement;
          if (radio.checked) {
            lbl.className = 'pattern-label flex flex-col items-center justify-center p-2.5 rounded-xl border border-blue-500 bg-blue-50/50 cursor-pointer text-center transition';
          } else {
            lbl.className = 'pattern-label flex flex-col items-center justify-center p-2.5 rounded-xl border border-slate-200 hover:border-slate-300 bg-white cursor-pointer text-center transition';
          }
        });
        renderWatermark();
      });
    });

    document.querySelectorAll('input[name="colorMode"]').forEach((el) => {
      el.addEventListener('change', renderWatermark);
    });

    // プリセットボタン
    presetButtons.forEach((btn) => {
      btn.addEventListener('click', () => {
        watermarkText.value = btn.textContent?.trim() || '';
        renderWatermark();
      });
    });

    // 日付挿入
    insertDateBtn.addEventListener('click', () => {
      const today = getTodayDateString();
      if (!watermarkText.value.includes(today)) {
        watermarkText.value = `${watermarkText.value} ${today}`.trim();
        renderWatermark();
      }
    });

    // サンプル投入
    loadSampleIdBtn?.addEventListener('click', () => {
      const sampleUri = generateDummyIdSvgUri();
      loadImageFromSrc(sampleUri, '見本_運転免許証.png');
    });

    // ダウンロード
    downloadBtn.addEventListener('click', () => {
      if (!currentLoadedImage) return;
      const dataUrl = previewCanvas.toDataURL('image/png');
      const a = document.createElement('a');
      a.href = dataUrl;
      const baseName = originalFileName.replace(/\.[^/.]+$/, '');
      a.download = `${baseName}_watermarked.png`;
      document.body.appendChild(a);
      a.click();
      document.body.removeChild(a);
    });
  </script>
</ToolShell>
