---
import Layout from '../../layouts/Layout.astro';
import Mascot from '../../components/Mascot.astro';
import SecuritySpecModal from '../../components/SecuritySpecModal.astro';
import { tools, toolCategories } from '../../data/tools';

// 本人確認・個人情報・画像カテゴリのツール一覧（tools.ts と完全一致）
const categoryTools = tools.filter((t) => t.category === 'id_privacy');

const otherCategories = toolCategories.filter((c) => c.id !== 'all' && c.id !== 'id_privacy');

const title = '本人確認・個人情報・写真のプライバシー保護ツール一覧 | サーバー送信なし・ブラウザ完結';
const description = '身分証透かし焼き込み、給与明細PDF解除、マイナンバー伏字化、写真EXIF・GPS削除をブラウザ内完結で。サーバー送信0バイト保証で情報漏洩を物理遮断。';
const canonicalPath = '/privacy/';

const extraSchemaGraph = [
  {
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'ホーム', item: 'https://zeroleaktools.com/' },
      { '@type': 'ListItem', position: 2, name: '本人確認・個人情報・画像', item: 'https://zeroleaktools.com/privacy/' },
    ],
  },
  {
    '@type': 'CollectionPage',
    name: '本人確認・個人情報・写真のプライバシー保護ツール一覧',
    description,
    url: 'https://zeroleaktools.com/privacy/',
  },
  {
    '@type': 'FAQPage',
    mainEntity: [
      {
        '@type': 'Question',
        name: '免許証やマイナンバーの写真を無料サイトで加工するのは危険ですか？',
        acceptedAnswer: {
          '@type': 'Answer',
          text: '極めて危険です。一般的な無料画像加工サイトや透かしツールは、画像を海外クラウドサーバーへアップロードして処理します。身分証明書の生データが第三者サーバーへ保存されると、不正借入れや口座開設に悪用される恐れがあります。ZeroLeak Toolsは端末内完結で外部送信は0バイトです。',
        },
      },
      {
        '@type': 'Question',
        name: '写真の位置情報（EXIF）を削除しないと自宅が特定されますか？',
        acceptedAnswer: {
          '@type': 'Answer',
          text: 'はい。スマートフォンで撮影した写真にはGPS座標（緯度・経度）が記録されており、SNSやフリマアプリに投稿すると自宅や職場がピンポイントで特定されるストーカー被害のリスクがあります。投稿前のEXIF消去が必須です。',
        },
      },
    ],
  },
];
---

<Layout
  title={title}
  description={description}
  canonicalPath={canonicalPath}
  extraSchemaGraph={extraSchemaGraph}
>
  <div class="max-w-5xl mx-auto space-y-6 sm:space-y-8">
    
    <!-- パンくずリスト -->
    <nav aria-label="Breadcrumb" class="text-xs text-slate-600">
      <ol class="flex items-center gap-1.5">
        <li><a href="/" class="hover:text-slate-900 font-medium transition">ホーム</a></li>
        <li aria-hidden="true">/</li>
        <li class="font-bold text-slate-900">本人確認・個人情報・画像</li>
      </ol>
    </nav>

    <!-- ハブヘッダー -->
    <section class="bg-white border border-slate-200 rounded-2xl sm:rounded-3xl p-4 sm:p-6 shadow-sm space-y-3 text-left">
      <div class="flex items-center justify-between gap-2">
        <span class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full bg-blue-50 border border-blue-200 text-blue-900 text-xs font-semibold">
          <span aria-hidden="true">🪪</span>
          <span>本人確認・身分証・個人情報・写真</span>
        </span>
        <button
          type="button"
          onclick="window.openSecurityModal && window.openSecurityModal()"
          class="inline-flex items-center gap-1 px-2.5 py-1.5 min-h-[38px] rounded-lg bg-slate-50 hover:bg-slate-100 text-slate-800 text-xs font-semibold border border-slate-200 shadow-sm transition cursor-pointer shrink-0"
        >
          <span aria-hidden="true">🏢</span>
          <span>情シス仕様書</span>
        </button>
      </div>

      <div class="flex flex-row items-center justify-between gap-3">
        <div class="space-y-1.5 text-left min-w-0 flex-1">
          <h1 class="text-xl sm:text-2xl lg:text-3xl font-extrabold text-slate-900 tracking-tight leading-tight">
            本人確認・個人情報 <span class="text-blue-700">保護ツール</span>
          </h1>
          <p class="text-slate-700 text-xs sm:text-sm leading-snug line-clamp-2 sm:line-clamp-none">
            身分証の提出用透かし、給与明細解除、写真EXIF/GPS削除、名簿CSV伏字化をブラウザ内完結で実行。
          </p>
        </div>
        <Mascot name="tool-watermark" fallback="🪪" width={160} eager class="w-16 sm:w-28 lg:w-36 aspect-[4/3] object-cover rounded-xl shadow-sm border border-slate-100 shrink-0" />
      </div>

      <!-- 保証バナー -->
      <div class="flex items-center gap-2 px-3 py-2 rounded-xl bg-blue-50/70 border border-blue-200/80 text-xs text-blue-950">
        <span class="text-sm select-none shrink-0" aria-hidden="true">🛡️</span>
        <p class="leading-tight">
          <strong class="font-bold">外部送信0バイト保証：</strong>ツール実行ページは広告スクリプトも読まず端末内だけで動作します。
        </p>
      </div>
    </section>

    <!-- よくある情報漏洩事故 vs ZeroLeak -->
    <details class="group bg-blue-50/50 border border-blue-200/80 rounded-xl px-3.5 py-1.5 text-xs md:hidden text-left">
      <summary class="flex items-center justify-between min-h-[44px] font-bold text-slate-900 cursor-pointer list-none select-none">
        <span class="flex items-center gap-1.5 text-xs font-bold text-slate-900">
          <span aria-hidden="true">⚠️</span>
          <span>よくある3大情報漏洩インシデント（タップで確認）</span>
        </span>
        <span class="text-slate-600 group-open:rotate-180 transition-transform text-xs shrink-0">▼</span>
      </summary>
      <div class="mt-2 pt-2.5 pb-2 border-t border-blue-200/60 space-y-2">
        <div class="p-2.5 rounded-lg bg-white border border-slate-200 space-y-1">
          <span class="font-bold text-rose-700 text-xs flex items-center gap-1">
            <span>🚨</span>
            <span>身分証コピーの不正転用</span>
          </span>
          <p class="text-slate-700 text-xs leading-relaxed">
            提出先の無加工免許証画像が流出し、借入れ等に悪用される事故。→「身分証透かし焼き込み」で提出目的を印字
          </p>
        </div>
        <div class="p-2.5 rounded-lg bg-white border border-slate-200 space-y-1">
          <span class="font-bold text-rose-700 text-xs flex items-center gap-1">
            <span>🚨</span>
            <span>写真のGPSから自宅特定</span>
          </span>
          <p class="text-slate-700 text-xs leading-relaxed">
            フリマ出品等の写真EXIFから自宅が特定される被害。→「写真EXIF一括削除」で位置情報を抹消
          </p>
        </div>
        <div class="p-2.5 rounded-lg bg-white border border-slate-200 space-y-1">
          <span class="font-bold text-rose-700 text-xs flex items-center gap-1">
            <span>🚨</span>
            <span>年収・マイナンバーの海外送信</span>
          </span>
          <p class="text-slate-700 text-xs leading-relaxed">
            無料PDF解除サイトで源泉徴収票が外部送信される事故。→「給与明細PDF解除」でローカル端末内解除
          </p>
        </div>
      </div>
    </details>

    <section class="hidden md:block p-5 rounded-2xl bg-slate-50/80 border border-slate-200 space-y-4 text-left">
      <div class="flex items-center gap-2">
        <span class="text-lg" aria-hidden="true">⚠️</span>
        <h2 class="text-base font-bold text-slate-900">
          本人確認・個人情報取り扱いで多発する3大インシデント
        </h2>
      </div>
      <div class="grid grid-cols-3 gap-4 text-xs">
        <div class="p-3.5 rounded-xl bg-white border border-slate-200 space-y-1.5 shadow-sm">
          <span class="font-bold text-rose-700 flex items-center gap-1">
            <span>🚨</span>
            <span>身分証コピーの不正転用</span>
          </span>
          <p class="text-slate-700 leading-relaxed text-xs">
            提出先に保存された無加工の免許証画像が流出し、勝手に消費者金融の借入れや口座開設に悪用される事故。
          </p>
          <div class="pt-1 text-xs text-blue-700 font-bold">
            👉 「身分証透かし焼き込み」で提出目的を不可逆印字
          </div>
        </div>

        <div class="p-3.5 rounded-xl bg-white border border-slate-200 space-y-1.5 shadow-sm">
          <span class="font-bold text-rose-700 flex items-center gap-1">
            <span>🚨</span>
            <span>写真のGPSから自宅特定</span>
          </span>
          <p class="text-slate-700 leading-relaxed text-xs">
            フリマ出品やSNS投稿写真に含まれるEXIFデータから、緯度経度が抜き出されて自宅が特定される被害。
          </p>
          <div class="pt-1 text-xs text-blue-700 font-bold">
            👉 「写真EXIF一括削除」で位置情報を完全抹消
          </div>
        </div>

        <div class="p-3.5 rounded-xl bg-white border border-slate-200 space-y-1.5 shadow-sm">
          <span class="font-bold text-rose-700 flex items-center gap-1">
            <span>🚨</span>
            <span>年収・マイナンバーの海外送信</span>
          </span>
          <p class="text-slate-700 leading-relaxed text-xs">
            住宅ローンやe-Taxのため、無料PDF解除サイトに源泉徴収票をアップロードし機密が外部サーバーへ漏洩。
          </p>
          <div class="pt-1 text-xs text-blue-700 font-bold">
            👉 「給与明細PDF解除」でローカル端末内解除
          </div>
        </div>
      </div>
    </section>

    <!-- ツール一覧：スマホでは薄型リスト、PCでは2列カード -->
    <section class="space-y-3 sm:space-y-4 text-left">
      <div class="flex items-center justify-between border-b border-slate-200 pb-2">
        <h2 class="text-base sm:text-lg font-bold text-slate-900 flex items-center gap-2">
          <span aria-hidden="true">🛠️</span>
          <span>利用可能なツール（{categoryTools.length}件）</span>
        </h2>
        <span class="text-xs text-slate-600 font-mono">通信0バイト保証</span>
      </div>

      <!-- 1. スマホ表示用：薄型リスト -->
      <div class="grid grid-cols-1 gap-2 sm:hidden">
        {categoryTools.map((t) => (
          <a
            href={t.href}
            class="flex items-center justify-between p-2 min-h-[64px] rounded-xl bg-white hover:bg-slate-50 border border-slate-200 border-l-4 border-l-blue-600 shadow-sm transition-colors group"
          >
            <div class="flex items-center gap-2.5 min-w-0 pr-2">
              <Mascot
                name={t.image}
                fallback={t.icon}
                alt=""
                width={96}
                class="w-12 h-12 rounded-lg object-cover shrink-0 shadow-sm border border-slate-200/60"
              />
              <div class="min-w-0">
                <div class="text-sm font-bold text-slate-900 truncate group-hover:text-blue-700">
                  {t.shortName ?? t.name}
                </div>
                <div class="text-xs text-slate-700 truncate mt-0.5">
                  {t.tagline}
                </div>
              </div>
            </div>
            <span class="text-xs font-bold text-white bg-blue-700 px-3 py-2 rounded-lg shadow-sm shrink-0 group-hover:bg-blue-800 transition-colors">
              開く ▶
            </span>
          </a>
        ))}
      </div>

      <!-- 2. PC・タブレット表示用：2列カードグリッド -->
      <div class="hidden sm:grid sm:grid-cols-2 gap-4">
        {categoryTools.map((t) => (
          <div class="p-5 rounded-2xl bg-white border border-slate-200 hover:border-blue-500 hover:shadow-md transition space-y-3 flex flex-col justify-between">
            <div class="space-y-2">
              <div class="flex items-start gap-3">
                <div class="w-10 h-10 rounded-xl bg-blue-50 border border-blue-200 flex items-center justify-center text-xl shrink-0">
                  {t.icon}
                </div>
                <div>
                  <h3 class="font-bold text-slate-900 text-base leading-snug">
                    <a href={t.href} class="hover:text-blue-700 transition">
                      {t.name}
                    </a>
                  </h3>
                  <p class="text-xs text-slate-600 font-mono mt-0.5">{t.tagline}</p>
                </div>
              </div>
              <p class="text-xs text-slate-700 leading-relaxed">
                {t.panels[2].text}
              </p>
            </div>

            <div class="pt-2 border-t border-slate-100 flex items-center justify-between">
              <span class="text-[11px] font-semibold text-emerald-900 bg-emerald-50 px-2.5 py-0.5 rounded border border-emerald-200">
                ✔ 通信0バイト
              </span>
              <a
                href={t.href}
                class="inline-flex items-center gap-1.5 px-4 py-2 min-h-[40px] rounded-xl text-xs font-bold text-white bg-blue-700 hover:bg-blue-800 transition shadow-sm cursor-pointer"
              >
                <span>ツールを開く</span>
                <span aria-hidden="true">▶</span>
              </a>
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- 他カテゴリハブへの相互案内 -->
    <section class="space-y-3 pt-4 border-t border-slate-200 text-left">
      <h2 class="text-sm font-bold text-slate-900">他のカテゴリハブを見る：</h2>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-3.5">
        {otherCategories.map((c) => (
          <a
            href={c.hubPath}
            class="p-4 min-h-[64px] rounded-xl bg-white border border-slate-200 hover:border-slate-400 hover:shadow-sm transition flex items-center justify-between group"
          >
            <div class="flex items-center gap-3 min-w-0">
              <span class="text-2xl shrink-0" aria-hidden="true">{c.icon}</span>
              <div class="min-w-0">
                <p class="font-bold text-slate-900 text-xs sm:text-sm group-hover:text-blue-700 transition truncate">{c.label}</p>
                <p class="text-xs text-slate-600 mt-0.5 truncate">{c.tagline}</p>
              </div>
            </div>
            <span class="text-slate-600 group-hover:translate-x-1 transition-transform text-sm shrink-0" aria-hidden="true">▶</span>
          </a>
        ))}
      </div>
    </section>

  </div>

  <SecuritySpecModal />
</Layout>
