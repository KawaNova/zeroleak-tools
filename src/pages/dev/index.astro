---
import Layout from '../../layouts/Layout.astro';
import Mascot from '../../components/Mascot.astro';
import SecuritySpecModal from '../../components/SecuritySpecModal.astro';
import { tools, toolCategories } from '../../data/tools';

// ITセキュリティ・開発者カテゴリのツール一覧
const targetSlugs = ['log-masking', 'ai-prompt-sanitizer', 'local-mosaic', 'csv-masking'];
const categoryTools = targetSlugs.map(slug => tools.find(t => t.slug === slug)!).filter(Boolean);

const otherCategories = toolCategories.filter(c => c.id !== 'all' && c.id !== 'dev_security');

const title = 'ITセキュリティ・開発者向け機密保護ツール一覧 | サーバー送信なし・ブラウザ完結';
const description = 'HAR・エラーログ・.envマスク、ChatGPT送信前の固有名詞匿名化、管理画面スクショのモザイク加工をブラウザ内完結で。外部送信0バイト保証で安全開発。';
const canonicalPath = '/dev/';

const extraSchemaGraph = [
  {
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'ホーム', item: 'https://zeroleaktools.com/' },
      { '@type': 'ListItem', position: 2, name: 'ITセキュリティ・開発者', item: 'https://zeroleaktools.com/dev/' },
    ],
  },
  {
    '@type': 'CollectionPage',
    name: 'ITセキュリティ・開発者向け機密保護ツール一覧',
    description,
    url: 'https://zeroleaktools.com/dev/',
  },
  {
    '@type': 'FAQPage',
    mainEntity: [
      {
        '@type': 'Question',
        name: '障害調査でベンダーへHARファイルをそのまま送るとどうなりますか？',
        acceptedAnswer: {
          '@type': 'Answer',
          'text': 'ブラウザのNetworkタブから保存したHARファイルには、ログイン中のCookie（セッションID）やAuthorization: Bearerトークン、CSRFトークンが生のまま記録されています。第三者に渡るとアカウント乗っ取り（セッションハイジャック）が即座に発生します。提出前のマスキングが不可欠です。',
        },
      },
      {
        '@type': 'Question',
        name: 'ChatGPTやClaudeに社外秘データを貼り付けても安全ですか？',
        acceptedAnswer: {
          '@type': 'Answer',
          'text': 'プロンプトに社名、取引先名、個人名、APIキーが含まれていると、利用規約やオプトアウト設定に関わらずログ保管や情報流出のコンプライアンスリスクになります。AIプロンプトサニタイザーで{{COMPANY_A}}等に仮名化してから送信し、AIの回答をワンクリックで実名復元するフローが安全です。',
        },
      },
    ],
  },
];
---

<Layout
  title={title}
  description={description}
  canonicalPath={canonicalPath}
  extraSchemaGraph={extraSchemaGraph}
>
  <div class="max-w-5xl mx-auto space-y-10">
    
    <!-- パンくずリスト -->
    <nav aria-label="Breadcrumb" class="text-[11px] text-slate-500">
      <ol class="flex items-center gap-1.5">
        <li><a href="/" class="hover:text-slate-800 transition">ホーム</a></li>
        <li><span>/</span></li>
        <li class="font-semibold text-slate-800">ITセキュリティ・開発者</li>
      </ol>
    </nav>

    <!-- ハブヘッダー：スマホでは横並びで省スペース＆マスコット大型化・PCでは2カラム -->
    <section class="bg-white border border-slate-200 rounded-2xl sm:rounded-3xl p-3.5 sm:p-6 shadow-xs space-y-3">
      <div class="flex items-center justify-between gap-2">
        <span class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full bg-cyan-50 border border-cyan-200 text-cyan-800 text-[10px] sm:text-xs font-semibold">
          <span>💻</span>
          <span>ログ・APIキー・AIプロンプト・開発セキュリティ</span>
        </span>
        <button
          type="button"
          onclick="window.openSecurityModal && window.openSecurityModal()"
          class="inline-flex items-center gap-1 px-2.5 py-1 rounded-lg bg-slate-50 hover:bg-slate-100 text-slate-700 text-[11px] font-semibold border border-slate-200 shadow-2xs transition cursor-pointer"
        >
          <span>🏢</span>
          <span>情シス仕様書</span>
        </button>
      </div>

      <div class="flex flex-row items-center justify-between gap-3">
        <div class="space-y-1.5 text-left min-w-0 flex-1">
          <h1 class="text-base sm:text-2xl lg:text-3xl font-extrabold text-slate-900 tracking-tight leading-snug">
            ITセキュリティ・開発者向け<br class="hidden sm:inline" />
            <span class="text-cyan-700">安心データ無害化ツール一覧</span>
          </h1>
          <p class="text-slate-600 text-[11px] sm:text-xs leading-relaxed line-clamp-2 sm:line-clamp-none">
            HARや.envのシークレットマスク、ChatGPT前の固有名詞仮名化＆復元、画面スクショの不可逆モザイクをブラウザ内で提供。
          </p>
        </div>
        <Mascot name="tool-log" fallback="💻" width={160} eager class="w-20 sm:w-28 lg:w-36 aspect-[4/3] object-cover rounded-xl shadow-2xs border border-slate-100 shrink-0" />
      </div>

      <!-- ゼロリークくん見守り保証バナー（コンパクト化） -->
      <div class="flex items-center gap-2 px-3 py-1.5 rounded-xl bg-cyan-50/70 border border-cyan-200/80 text-[11px] text-cyan-950">
        <span class="text-sm select-none shrink-0">🛡️</span>
        <p class="leading-tight">
          <strong class="font-bold">外部送信0バイト保証：</strong>全ツールはお使いの端末メモリ上でのみ動作します。
        </p>
      </div>
    </section>

    <!-- よくある情報漏洩事故 vs ZeroLeakの物理遮断 -->
    <!-- 1. スマホ表示用：折りたたみアコーディオン（スクロール圧迫を劇的解消） -->
    <details class="group bg-cyan-50/50 border border-cyan-200/70 rounded-xl p-3 text-xs md:hidden">
      <summary class="flex items-center justify-between font-bold text-slate-800 cursor-pointer list-none select-none">
        <span class="flex items-center gap-1.5 text-[11px] font-bold text-slate-800">
          <span>⚠️</span>
          <span>開発・AI利用で多発する3大インシデント（タップで確認）</span>
        </span>
        <span class="text-slate-400 group-open:rotate-180 transition-transform text-xs">▼</span>
      </summary>
      <div class="mt-2.5 pt-2.5 border-t border-cyan-200/60 space-y-2">
        <div class="p-2.5 rounded-lg bg-white border border-slate-200 space-y-1">
          <span class="font-bold text-rose-700 text-[11px] flex items-center gap-1">
            <span>🚨</span>
            <span>HARからのセッション乗っ取り</span>
          </span>
          <p class="text-slate-600 text-[10px] leading-relaxed">
            提出したHARにCookieが生のまま残りセッション乗っ取り被害。→「HAR・ログマスク」でCookieを無害化
          </p>
        </div>
        <div class="p-2.5 rounded-lg bg-white border border-slate-200 space-y-1">
          <span class="font-bold text-rose-700 text-[11px] flex items-center gap-1">
            <span>🚨</span>
            <span>生成AIへの機密プロンプト誤爆</span>
          </span>
          <p class="text-slate-600 text-[10px] leading-relaxed">
            社外秘プロジェクト名をChatGPTへ貼り付けて重大なコンプラ違反に。→「AIプロンプト仮名化」で記号置換＆復元
          </p>
        </div>
        <div class="p-2.5 rounded-lg bg-white border border-slate-200 space-y-1">
          <span class="font-bold text-rose-700 text-[11px] flex items-center gap-1">
            <span>🚨</span>
            <span>管理画面スクショの個人情報流出</span>
          </span>
          <p class="text-slate-600 text-[10px] leading-relaxed">
            マニュアル作成スクショの顧客名が丸見えのまま共有。→「画面モザイク・黒塗り」で不可逆ピクセル消去
          </p>
        </div>
      </div>
    </details>

    <!-- 2. PC・タブレット表示用：美しい3列インシデントカード -->
    <section class="hidden md:block p-5 rounded-2xl bg-gradient-to-br from-cyan-50/50 to-slate-50 border border-cyan-100 space-y-4">
      <div class="flex items-center gap-2">
        <span class="text-lg">⚠️</span>
        <h2 class="text-sm sm:text-base font-bold text-slate-900">
          開発・障害対応・AI利用で多発する3大インシデント
        </h2>
      </div>
      <div class="grid grid-cols-3 gap-4 text-xs">
        <div class="p-3.5 rounded-xl bg-white border border-slate-200 space-y-1.5 shadow-2xs">
          <span class="font-bold text-rose-700 flex items-center gap-1">
            <span>🚨</span>
            <span>HARファイルからのセッション乗っ取り</span>
          </span>
          <p class="text-slate-600 leading-relaxed text-[11px]">
            サポートへ提出したHAR内にCookieやBearerが生のまま残っており、セッションハイジャックされる事故。
          </p>
          <div class="pt-1 text-[10px] text-cyan-700 font-semibold">
            👉 「HAR・ログマスク」でCookie・Bearerを完全無害化
          </div>
        </div>

        <div class="p-3.5 rounded-xl bg-white border border-slate-200 space-y-1.5 shadow-2xs">
          <span class="font-bold text-rose-700 flex items-center gap-1">
            <span>🚨</span>
            <span>生成AIへの機密プロンプト誤爆</span>
          </span>
          <p class="text-slate-600 leading-relaxed text-[11px]">
            社外秘プロジェクト名や実名入り議事録をChatGPTへ貼り付けてしまい、企業の重大コンプラ違反に。
          </p>
          <div class="pt-1 text-[10px] text-cyan-700 font-semibold">
            👉 「AIプロンプト仮名化」で記号置換＆後から実名復元
          </div>
        </div>

        <div class="p-3.5 rounded-xl bg-white border border-slate-200 space-y-1.5 shadow-2xs">
          <span class="font-bold text-rose-700 flex items-center gap-1">
            <span>🚨</span>
            <span>管理画面スクショの個人情報流出</span>
          </span>
          <p class="text-slate-600 leading-relaxed text-[11px]">
            マニュアル作成やバグ報告スクショの顧客名・メールアドレス・売上金額が丸見えのまま外部共有。
          </p>
          <div class="pt-1 text-[10px] text-cyan-700 font-semibold">
            👉 「画面モザイク・黒塗り」で不可逆ピクセル消去
          </div>
        </div>
      </div>
    </section>

    <!-- ツール一覧：スマホではサムネイル付き薄型リスト、PCでは2列カード -->
    <section class="space-y-3 sm:space-y-4">
      <div class="flex items-center justify-between border-b border-slate-200 pb-2">
        <h2 class="text-sm sm:text-base font-bold text-slate-900 flex items-center gap-2">
          <span>🛠️</span>
          <span>利用可能なツール（{categoryTools.length}件）</span>
        </h2>
        <span class="text-[11px] text-slate-500 font-mono">通信0バイト保証</span>
      </div>

      <!-- 1. スマホ表示用：ZeroLeakくんサムネイル付き薄型リスト（縦スクロール激減） -->
      <div class="grid grid-cols-1 gap-2 sm:hidden">
        {categoryTools.map((t) => (
          <a
            href={t.href}
            class="flex items-center justify-between p-2 rounded-xl bg-white hover:bg-slate-50 border border-slate-200 shadow-2xs transition-colors group"
          >
            <div class="flex items-center gap-2.5 min-w-0 pr-2">
              <Mascot
                name={t.image}
                fallback={t.icon}
                alt=""
                width={96}
                class="w-12 h-12 rounded-lg object-cover shrink-0 shadow-2xs border border-slate-200/60"
              />
              <div class="min-w-0">
                <div class="text-xs font-bold text-slate-900 truncate group-hover:text-cyan-700">
                  {t.shortName ?? t.name}
                </div>
                <div class="text-[11px] text-slate-500 truncate mt-0.5">
                  {t.tagline}
                </div>
              </div>
            </div>
            <span class="text-[11px] font-bold text-white bg-cyan-600 px-2.5 py-1.5 rounded-lg shadow-2xs shrink-0 group-hover:bg-cyan-700 transition-colors">
              開く ▶
            </span>
          </a>
        ))}
      </div>

      <!-- 2. PC・タブレット表示用：美しい2列カードグリッド -->
      <div class="hidden sm:grid sm:grid-cols-2 gap-4">
        {categoryTools.map((t) => (
          <div class="p-5 rounded-2xl bg-white border border-slate-200 hover:border-cyan-400 hover:shadow-md transition space-y-3 flex flex-col justify-between">
            <div class="space-y-2">
              <div class="flex items-start justify-between gap-3">
                <div class="flex items-center gap-2.5">
                  <div class="w-10 h-10 rounded-xl bg-cyan-50 border border-cyan-200 flex items-center justify-center text-xl shrink-0">
                    {t.icon}
                  </div>
                  <div>
                    <h3 class="font-bold text-slate-900 text-sm sm:text-base leading-snug">
                      <a href={t.href} class="hover:text-cyan-700 transition">
                        {t.name}
                      </a>
                    </h3>
                    <p class="text-[11px] text-slate-500 font-mono mt-0.5">{t.tagline}</p>
                  </div>
                </div>
              </div>
              <p class="text-xs text-slate-600 leading-relaxed">
                {t.panels[2].text}
              </p>
            </div>

            <div class="pt-2 border-t border-slate-100 flex items-center justify-between">
              <span class="text-[10px] font-semibold text-emerald-800 bg-emerald-50 px-2 py-0.5 rounded border border-emerald-200">
                ✔ 通信0バイト
              </span>
              <a
                href={t.href}
                class="inline-flex items-center gap-1.5 px-4 py-2 rounded-xl text-xs font-bold text-white bg-cyan-600 hover:bg-cyan-700 transition shadow-xs cursor-pointer"
              >
                <span>ツールを開く</span>
                <span>▶</span>
              </a>
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- 他カテゴリハブへの相互案内 -->
    <section class="space-y-4 pt-4 border-t border-slate-200">
      <h2 class="text-sm font-bold text-slate-800">他のカテゴリハブを見る：</h2>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        {otherCategories.map((c) => (
          <a
            href={c.hubPath}
            class="p-4 rounded-xl bg-white border border-slate-200 hover:border-slate-400 hover:shadow-xs transition flex items-center justify-between group"
          >
            <div class="flex items-center gap-3">
              <span class="text-2xl">{c.icon}</span>
              <div>
                <p class="font-bold text-slate-900 text-xs sm:text-sm group-hover:text-cyan-700 transition">{c.label}</p>
                <p class="text-[11px] text-slate-500 mt-0.5">{c.tagline}</p>
              </div>
            </div>
            <span class="text-slate-400 group-hover:translate-x-1 transition-transform text-sm">▶</span>
          </a>
        ))}
      </div>
    </section>

  </div>

  <SecuritySpecModal />
</Layout>
