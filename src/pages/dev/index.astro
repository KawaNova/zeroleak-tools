---
import Layout from '../../layouts/Layout.astro';
import Mascot from '../../components/Mascot.astro';
import SecuritySpecModal from '../../components/SecuritySpecModal.astro';
import { tools, toolCategories } from '../../data/tools';

// ITセキュリティ・開発者カテゴリのツール一覧
const targetSlugs = ['log-masking', 'ai-prompt-sanitizer', 'local-mosaic', 'csv-masking'];
const categoryTools = targetSlugs.map(slug => tools.find(t => t.slug === slug)!).filter(Boolean);

const otherCategories = toolCategories.filter(c => c.id !== 'all' && c.id !== 'dev_security');

const title = 'ITセキュリティ・開発者向け機密保護ツール一覧 | サーバー送信なし・ブラウザ完結';
const description = 'HAR・エラーログ・.envマスク、ChatGPT送信前の固有名詞匿名化、管理画面スクショのモザイク加工をブラウザ内完結で。外部送信0バイト保証で安全開発。';
const canonicalPath = '/dev/';

const extraSchemaGraph = [
  {
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'ホーム', item: 'https://zeroleaktools.com/' },
      { '@type': 'ListItem', position: 2, name: 'ITセキュリティ・開発者', item: 'https://zeroleaktools.com/dev/' },
    ],
  },
  {
    '@type': 'CollectionPage',
    name: 'ITセキュリティ・開発者向け機密保護ツール一覧',
    description,
    url: 'https://zeroleaktools.com/dev/',
  },
  {
    '@type': 'FAQPage',
    mainEntity: [
      {
        '@type': 'Question',
        name: '障害調査でベンダーへHARファイルをそのまま送るとどうなりますか？',
        acceptedAnswer: {
          '@type': 'Answer',
          'text': 'ブラウザのNetworkタブから保存したHARファイルには、ログイン中のCookie（セッションID）やAuthorization: Bearerトークン、CSRFトークンが生のまま記録されています。第三者に渡るとアカウント乗っ取り（セッションハイジャック）が即座に発生します。提出前のマスキングが不可欠です。',
        },
      },
      {
        '@type': 'Question',
        name: 'ChatGPTやClaudeに社外秘データを貼り付けても安全ですか？',
        acceptedAnswer: {
          '@type': 'Answer',
          'text': 'プロンプトに社名、取引先名、個人名、APIキーが含まれていると、利用規約やオプトアウト設定に関わらずログ保管や情報流出のコンプライアンスリスクになります。AIプロンプトサニタイザーで{{COMPANY_A}}等に仮名化してから送信し、AIの回答をワンクリックで実名復元するフローが安全です。',
        },
      },
    ],
  },
];
---

<Layout
  title={title}
  description={description}
  canonicalPath={canonicalPath}
  extraSchemaGraph={extraSchemaGraph}
>
  <div class="max-w-5xl mx-auto space-y-10">
    
    <!-- パンくずリスト -->
    <nav aria-label="Breadcrumb" class="text-xs text-slate-500">
      <ol class="flex items-center gap-1.5">
        <li><a href="/" class="hover:text-slate-800 transition">ホーム</a></li>
        <li><span>/</span></li>
        <li class="font-semibold text-slate-800">ITセキュリティ・開発者</li>
      </ol>
    </nav>

    <!-- ハブヘッダー -->
    <div class="space-y-3">
      <div class="flex flex-wrap items-center justify-between gap-3">
        <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-cyan-50 border border-cyan-200 text-cyan-800 text-xs font-semibold">
          <span>💻</span>
          <span>ログ・APIキー・AIプロンプト・開発セキュリティ</span>
        </span>
        <button
          type="button"
          onclick="window.openSecurityModal && window.openSecurityModal()"
          class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg bg-white hover:bg-slate-50 text-slate-700 hover:text-slate-900 text-xs font-semibold border border-slate-200 shadow-xs transition cursor-pointer"
        >
          <span>🏢</span>
          <span>社内利用・情シス申請用仕様書</span>
        </button>
      </div>

      <!-- ゼロリークくん見守り保証バナー -->
      <div class="flex items-center gap-2.5 px-3.5 py-2 rounded-xl bg-cyan-50 border border-cyan-200 text-xs text-cyan-950 shadow-2xs">
        <span class="text-base select-none shrink-0">🛡️</span>
        <p class="leading-relaxed">
          <strong class="font-bold">ゼロリークくん安全保証：</strong>本カテゴリの全ツールは端末内だけで動作します。F12（開発者ツールのNetworkタブ）で外部通信が一切発生しないことを目視確認できます。
        </p>
      </div>

      <div class="flex flex-col md:flex-row items-start md:items-center justify-between gap-6 pt-2">
        <div class="space-y-2 max-w-2xl">
          <h1 class="text-2xl sm:text-4xl font-extrabold text-slate-900 tracking-tight leading-tight">
            ITセキュリティ・開発者向け<br class="hidden sm:inline" />
            <span class="text-cyan-700">データ無害化・安全共有ツール一覧</span>
          </h1>
          <p class="text-slate-600 text-xs sm:text-sm leading-relaxed">
            HARファイルや.envのシークレット一括マスク、ChatGPT送信前の固有名詞仮名化＆ワンクリック復元、管理画面キャプチャの不可逆モザイクをブラウザ内完結で提供します。
          </p>
        </div>
        <Mascot name="tool-log" fallback="💻" width={320} eager class="w-24 sm:w-36 lg:w-44 rounded-2xl shrink-0 self-center md:self-auto" />
      </div>
    </div>

    <!-- よくある情報漏洩事故 vs ZeroLeakの物理遮断 -->
    <section class="p-5 sm:p-6 rounded-2xl bg-gradient-to-br from-cyan-50/50 to-slate-50 border border-cyan-100 space-y-4">
      <div class="flex items-center gap-2">
        <span class="text-lg">⚠️</span>
        <h2 class="text-sm sm:text-base font-bold text-slate-900">
          開発・障害対応・AI利用で多発する3大インシデント
        </h2>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-4 text-xs">
        <div class="p-3.5 rounded-xl bg-white border border-slate-200 space-y-1.5 shadow-2xs">
          <span class="font-bold text-rose-700 flex items-center gap-1">
            <span>🚨</span>
            <span>HARファイルからのセッション乗っ取り</span>
          </span>
          <p class="text-slate-600 leading-relaxed text-[11px]">
            サポートへ提出したHAR内にCookieやBearerが生のまま残っており、セッションハイジャックされる事故。
          </p>
          <div class="pt-1 text-[10px] text-cyan-700 font-semibold">
            👉 「HAR・ログマスク」でCookie・Bearerを完全無害化
          </div>
        </div>

        <div class="p-3.5 rounded-xl bg-white border border-slate-200 space-y-1.5 shadow-2xs">
          <span class="font-bold text-rose-700 flex items-center gap-1">
            <span>🚨</span>
            <span>生成AIへの機密プロンプト誤爆</span>
          </span>
          <p class="text-slate-600 leading-relaxed text-[11px]">
            社外秘プロジェクト名や実名入り議事録をChatGPTへ貼り付けてしまい、企業の重大コンプラ違反に。
          </p>
          <div class="pt-1 text-[10px] text-cyan-700 font-semibold">
            👉 「AIプロンプト仮名化」で記号置換＆後から実名復元
          </div>
        </div>

        <div class="p-3.5 rounded-xl bg-white border border-slate-200 space-y-1.5 shadow-2xs">
          <span class="font-bold text-rose-700 flex items-center gap-1">
            <span>🚨</span>
            <span>管理画面スクショの個人情報流出</span>
          </span>
          <p class="text-slate-600 leading-relaxed text-[11px]">
            マニュアル作成やバグ報告スクショの顧客名・メールアドレス・売上金額が丸見えのまま外部共有。
          </p>
          <div class="pt-1 text-[10px] text-cyan-700 font-semibold">
            👉 「画面モザイク・黒塗り」で不可逆ピクセル消去
          </div>
        </div>
      </div>
    </section>

    <!-- ツール一覧カードグリッド -->
    <section class="space-y-4">
      <div class="flex items-center justify-between border-b border-slate-200 pb-2">
        <h2 class="text-base sm:text-lg font-bold text-slate-900 flex items-center gap-2">
          <span>🛠️</span>
          <span>利用可能なツール（{categoryTools.length}件）</span>
        </h2>
        <span class="text-xs text-slate-500">外部通信 0 バイト保証</span>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        {categoryTools.map((t) => (
          <div class="p-5 rounded-2xl bg-white border border-slate-200 hover:border-cyan-400 hover:shadow-md transition space-y-3 flex flex-col justify-between">
            <div class="space-y-2">
              <div class="flex items-start justify-between gap-3">
                <div class="flex items-center gap-2.5">
                  <div class="w-10 h-10 rounded-xl bg-cyan-50 border border-cyan-200 flex items-center justify-center text-xl shrink-0">
                    {t.icon}
                  </div>
                  <div>
                    <h3 class="font-bold text-slate-900 text-sm sm:text-base leading-snug">
                      <a href={t.href} class="hover:text-cyan-700 transition">
                        {t.name}
                      </a>
                    </h3>
                    <p class="text-[11px] text-slate-500 font-mono mt-0.5">{t.tagline}</p>
                  </div>
                </div>
              </div>
              <p class="text-xs text-slate-600 leading-relaxed">
                {t.panels[2].text}
              </p>
            </div>

            <div class="pt-2 border-t border-slate-100 flex items-center justify-between">
              <span class="text-[10px] font-semibold text-emerald-800 bg-emerald-50 px-2 py-0.5 rounded border border-emerald-200">
                ✔ 通信0バイト
              </span>
              <a
                href={t.href}
                class="inline-flex items-center gap-1.5 px-4 py-2 rounded-xl text-xs font-bold text-white bg-cyan-600 hover:bg-cyan-700 transition shadow-xs cursor-pointer"
              >
                <span>ツールを開く</span>
                <span>▶</span>
              </a>
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- 他カテゴリハブへの相互案内 -->
    <section class="space-y-4 pt-4 border-t border-slate-200">
      <h2 class="text-sm font-bold text-slate-800">他のカテゴリハブを見る：</h2>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        {otherCategories.map((c) => (
          <a
            href={c.hubPath}
            class="p-4 rounded-xl bg-white border border-slate-200 hover:border-slate-400 hover:shadow-xs transition flex items-center justify-between group"
          >
            <div class="flex items-center gap-3">
              <span class="text-2xl">{c.icon}</span>
              <div>
                <p class="font-bold text-slate-900 text-xs sm:text-sm group-hover:text-cyan-700 transition">{c.label}</p>
                <p class="text-[11px] text-slate-500 mt-0.5">{c.tagline}</p>
              </div>
            </div>
            <span class="text-slate-400 group-hover:translate-x-1 transition-transform text-sm">▶</span>
          </a>
        ))}
      </div>
    </section>

  </div>

  <SecuritySpecModal />
</Layout>
