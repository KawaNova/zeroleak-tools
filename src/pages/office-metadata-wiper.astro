---
import ToolShell from '../components/ToolShell.astro';

const howToSteps = [
  {
    name: 'Office文書（.xlsx, .docx, .pptx）をドラッグ＆ドロップ',
    text: '社外へ提出したいExcel見積書、Word提案書、PowerPoint企画書をドロップゾーンに投入します（複数ファイルの一括投入にも対応）。',
  },
  {
    name: '検出された作成者・会社名・日時の確認',
    text: 'ファイル内部のdocProps/core.xmlおよびapp.xmlから検出された作成者名、最終更新者、会社名、編集時間などの隠しメタデータを確認します。',
  },
  {
    name: 'メタデータ消去済みOfficeファイルをダウンロード',
    text: '文書の本文・数式・レイアウトをそのまま保持し、個人情報・社内情報のみが物理抹消されたファイルをワンクリックで再保存します。',
  },
];

const faqs = [
  {
    question: 'ExcelやWordのプロパティを消さずに取引先に送ると、なぜ危険なのですか？',
    answer:
      'Officeファイルには、画面上には見えない「作成者の実名」「会社名」「下請けや外注先のPCユーザー名」「総編集時間」がXMLメタデータとして永続記録されているためです。そのままメール添付すると、社内関係者の実名や下請け構造が取引先に完全に筒抜けになります。',
  },
  {
    question: 'ファイルを無料Webサイトにアップロードしてメタデータを消すリスクは？',
    answer:
      '無料のオンライン変換サイトの多くは、ファイルを海外クラウドサーバーへ転送して処理します。見積書・提案書・社外秘のExcelを外部サーバーへ送信した時点で企業のセキュリティ規程違反（情報漏洩事故）となるため、端末内（ブラウザ内）だけで完結するツールが必須です。',
  },
  {
    question: 'メタデータを消去してもExcelやWordの表・文書レイアウトは壊れませんか？',
    answer:
      '壊れません。Office Open XML標準に準拠し、メタデータを格納するプロパティ部分（docProps/core.xml, app.xml）のみを初期化し、本文（xl/worksheets/ や word/document.xml）のデータ・数式・マクロ構造には一切手を加えません。',
  },
  {
    question: '複数のOfficeファイルを一度にまとめて消去できますか？',
    answer:
      'はい。複数の.xlsxや.docxファイルを同時にドラッグ＆ドロップして、一括でメタデータを消去できます。消去後は個別ダウンロードまたはZIP一括ダウンロードが可能です。',
  },
];
---

<ToolShell
  slug="office-metadata-wiper"
  title="Excel・Word 作成者・隠しメタデータ一括消去ツール | サーバー送信なし・ブラウザ完結"
  description="社外へ送る.xlsxや.docxから、作成者名・最終保存者・会社名・編集履歴を一括抹消。ブラウザ内完結・外部送信0バイトで情報漏洩をブロック。"
  canonicalPath="/office-metadata-wiper/"
  h1="Office文書（Excel・Word）作成者・隠しメタデータ一括消去"
  subtitle="社外へ送る.xlsxや.docxから、作成者名・最終保存者・会社名・編集履歴を一括抹消。ブラウザ内完結で外部通信は一切発生しません。"
  whyTitle="「プロパティを消したつもり」で、下請け企業名が残る事故"
  howToSteps={howToSteps}
  faqs={faqs}
  maxWidthClass="max-w-4xl"
>
  <!-- ワンクリック検証用サンプルボタン -->
  <button
    slot="sample-button"
    id="loadSampleOfficeBtn"
    type="button"
    class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-xl bg-teal-50 hover:bg-teal-100 text-teal-900 border border-teal-300 text-xs font-bold transition shadow-xs cursor-pointer shrink-0"
  >
    <span>🧪</span>
    <span>模擬Office文書（機密メタデータ入り）で試す</span>
  </button>

  <!-- メイン操作カード -->
  <div class="bg-white border border-slate-200 rounded-2xl p-4 sm:p-6 shadow-sm space-y-5">
    
    <!-- ファイルドロップゾーン -->
    <div
      id="dropZoneOffice"
      class="border-2 border-dashed border-slate-300 hover:border-teal-500 rounded-2xl p-6 sm:p-8 text-center transition bg-slate-50/70 hover:bg-teal-50/20 cursor-pointer group"
    >
      <input
        type="file"
        id="fileInputOffice"
        accept=".xlsx,.docx,.pptx,.xlsm,.xltx,.potx,application/vnd.openxmlformats-officedocument.spreadsheetml.sheet,application/vnd.openxmlformats-officedocument.wordprocessingml.document,application/vnd.openxmlformats-officedocument.presentationml.presentation"
        multiple
        class="hidden"
      />
      <div class="flex flex-col items-center gap-2.5 pointer-events-none">
        <div class="w-12 h-12 rounded-xl bg-teal-50 border border-teal-200 flex items-center justify-center text-teal-600 group-hover:scale-105 transition-transform shadow-xs text-xl">
          📑
        </div>
        <div>
          <p class="font-bold text-slate-800 text-sm sm:text-base">
            Excel (.xlsx) / Word (.docx) / PowerPoint (.pptx) をドロップ
          </p>
          <p class="text-xs text-slate-500 mt-0.5">
            またはクリックしてファイル選択（複数ファイルの一括投入に対応）
          </p>
        </div>
        <div class="flex flex-wrap items-center justify-center gap-2">
          <span class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full bg-white border border-slate-200 text-[10px] sm:text-[11px] text-teal-800 shadow-xs font-medium">
            🔒 外部送信なし（ファイルは端末外に出ません）
          </span>
          <span class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full bg-white border border-slate-200 text-[10px] sm:text-[11px] text-slate-600 shadow-xs">
            👤 作成者・最終保存者・会社名を完全初期化
          </span>
        </div>
      </div>
    </div>

    <!-- 処理中プログレス表示 -->
    <div id="officeProgressArea" class="hidden text-center py-6 space-y-3">
      <div class="inline-block w-8 h-8 border-3 border-teal-600 border-t-transparent rounded-full animate-spin"></div>
      <p class="text-xs text-teal-800 font-semibold">ブラウザ内でOffice内部XMLを展開 ＆ 機密メタデータ消去中...</p>
    </div>

    <!-- 処理結果＆ダウンロードエリア -->
    <div id="officeResultArea" class="hidden space-y-4">
      
      <!-- 完了サマリーバー -->
      <div class="p-4 sm:p-5 rounded-xl bg-teal-50/80 border border-teal-200 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-3">
        <div class="flex items-center gap-3">
          <div class="w-10 h-10 rounded-full bg-teal-100 text-teal-800 flex items-center justify-center text-xl shrink-0">
            🎉
          </div>
          <div>
            <h2 class="text-sm sm:text-base font-bold text-teal-950">
              作成者・会社名・編集履歴の消去が完了しました！
            </h2>
            <p id="resultTimeText" class="text-xs text-slate-600 font-mono mt-0.5">
              処理時間: 0.05秒 (通信0バイト)
            </p>
          </div>
        </div>
        <button
          id="downloadCleanFileBtn"
          type="button"
          class="w-full sm:w-auto px-5 py-2.5 rounded-xl font-bold text-xs sm:text-sm text-white bg-teal-600 hover:bg-teal-700 transition shadow-xs flex items-center justify-center gap-2 cursor-pointer whitespace-nowrap"
        >
          <span>📥</span>
          <span id="downloadBtnLabel">消去済みファイルを保存</span>
        </button>
      </div>

      <!-- ゼロリークくん完了メッセージ -->
      <div class="flex items-center gap-2 p-3 rounded-xl bg-teal-100/70 border border-teal-200 text-xs text-teal-950 font-medium">
        <span class="text-base select-none shrink-0">🛡️</span>
        <span><strong>ゼロリークくん：</strong>Office文書のメタデータを消去しました！ファイルはこの端末内だけで再構築され、外部には一切送信されていません。</span>
      </div>

      <!-- 検出・抹消されたメタデータ監査レポート -->
      <div class="p-4 rounded-xl bg-white border border-slate-200 space-y-3 shadow-xs">
        <div class="font-bold text-xs text-slate-900 flex items-center justify-between border-b border-slate-100 pb-2">
          <span class="flex items-center gap-1.5">
            <span>🔍</span>
            <span>消去された内部プロパティ・メタデータ一覧（Before / After）</span>
          </span>
          <span id="removedCountBadge" class="px-2 py-0.5 rounded bg-emerald-50 text-emerald-800 border border-emerald-200 text-[10px] font-bold">
            残存メタデータ 0件
          </span>
        </div>

        <div id="metadataReportList" class="grid grid-cols-1 sm:grid-cols-2 gap-2 text-[11px] text-slate-700">
          <!-- JSで動的挿入 -->
        </div>
      </div>

      <div class="flex items-center justify-between pt-1">
        <button
          id="resetOfficeBtn"
          type="button"
          class="text-xs text-slate-500 hover:text-slate-800 underline transition cursor-pointer"
        >
          別のファイルを消去する
        </button>
      </div>

    </div>

  </div>

  <!-- クライアントサイドスクリプト -->
  <script>
    import {
      wipeOfficeMetadata,
      generateSampleOfficeDocx,
      type OfficeWipeResult,
    } from '../utils/office-metadata';

    const dropZone = document.getElementById('dropZoneOffice') as HTMLDivElement;
    const fileInput = document.getElementById('fileInputOffice') as HTMLInputElement;
    const sampleBtn = document.getElementById('loadSampleOfficeBtn') as HTMLButtonElement;
    const progressArea = document.getElementById('officeProgressArea') as HTMLDivElement;
    const resultArea = document.getElementById('officeResultArea') as HTMLDivElement;
    const downloadBtn = document.getElementById('downloadCleanFileBtn') as HTMLButtonElement;
    const downloadBtnLabel = document.getElementById('downloadBtnLabel') as HTMLSpanElement;
    const resetBtn = document.getElementById('resetOfficeBtn') as HTMLButtonElement;
    const reportList = document.getElementById('metadataReportList') as HTMLDivElement;
    const resultTimeText = document.getElementById('resultTimeText') as HTMLParagraphElement;
    const removedCountBadge = document.getElementById('removedCountBadge') as HTMLSpanElement;

    let lastResult: OfficeWipeResult | null = null;
    let cleanFileBlobUrl: string | null = null;

    // ファイル処理
    async function handleFile(file: File | { name: string; buffer: Uint8Array }) {
      progressArea.classList.remove('hidden');
      resultArea.classList.add('hidden');

      const startTime = performance.now();

      try {
        let buffer: Uint8Array;
        let filename: string;

        if (file instanceof File) {
          filename = file.name;
          const arrayBuffer = await file.arrayBuffer();
          buffer = new Uint8Array(arrayBuffer);
        } else {
          filename = file.name;
          buffer = file.buffer;
        }

        const res = await wipeOfficeMetadata(buffer, filename);
        lastResult = res;

        const elapsed = ((performance.now() - startTime) / 1000).toFixed(2);
        renderResult(res, elapsed);
      } catch (err) {
        console.error('Office metadata wipe error:', err);
        alert('Office文書の解析・消去に失敗しました。暗号化されたファイルでないか、破損していないかご確認ください。');
      } finally {
        progressArea.classList.add('hidden');
      }
    }

    function renderResult(res: OfficeWipeResult, elapsedSec: string) {
      if (cleanFileBlobUrl) {
        URL.revokeObjectURL(cleanFileBlobUrl);
      }
      const blob = new Blob([res.cleanedBytes], { type: 'application/octet-stream' });
      cleanFileBlobUrl = URL.createObjectURL(blob);

      resultTimeText.textContent = `処理時間: ${elapsedSec}秒 (通信0バイト) • 元サイズ: ${(res.originalFileSize / 1024).toFixed(1)} KB → 消去後: ${(res.cleanedFileSize / 1024).toFixed(1)} KB`;
      removedCountBadge.textContent = `消去完了: ${res.removedPropertiesCount}項目 (残存メタデータ 0件)`;

      // レポート描画
      const meta = res.detectedMetadata;
      const items: { label: string; val?: string; icon: string }[] = [
        { label: '作成者名 (Creator)', val: meta.creator, icon: '👤' },
        { label: '最終保存者 (Last Modified By)', val: meta.lastModifiedBy, icon: '✏️' },
        { label: '所属会社名 (Company)', val: meta.company, icon: '🏢' },
        { label: '管理者名 (Manager)', val: meta.manager, icon: '👔' },
        { label: '文書タイトル (Title)', val: meta.title, icon: '📑' },
        { label: '件名 (Subject)', val: meta.subject, icon: '📌' },
        { label: '作成日時 (Created)', val: meta.created, icon: '📅' },
        { label: '最終更新日時 (Modified)', val: meta.modified, icon: '🕒' },
      ];

      reportList.innerHTML = items
        .map((item) => {
          const isDetected = !!item.val;
          return `
            <div class="p-2.5 rounded-lg border ${
              isDetected ? 'bg-amber-50/50 border-amber-200' : 'bg-slate-50 border-slate-200'
            } flex items-start justify-between gap-2">
              <div class="space-y-0.5">
                <span class="font-bold text-slate-800 flex items-center gap-1">
                  <span>${item.icon}</span>
                  <span>${item.label}</span>
                </span>
                <p class="font-mono text-slate-500 text-[10px] break-all">
                  ${isDetected ? `元データ: "${item.val}"` : '元データ: (未設定)'}
                </p>
              </div>
              <span class="px-2 py-0.5 rounded text-[10px] font-bold shrink-0 ${
                isDetected ? 'bg-emerald-100 text-emerald-800 border border-emerald-300' : 'bg-slate-100 text-slate-500'
              }">
                ${isDetected ? '✔ 消去済' : 'なし'}
              </span>
            </div>
          `;
        })
        .join('');

      downloadBtnLabel.textContent = `消去済み「${res.filename}」を保存`;
      resultArea.classList.remove('hidden');
    }

    // ダウンロード実行
    downloadBtn?.addEventListener('click', () => {
      if (!lastResult || !cleanFileBlobUrl) return;
      const a = document.createElement('a');
      a.href = cleanFileBlobUrl;
      const extMatch = lastResult.filename.match(/\.([a-zA-Z0-9]+)$/);
      const ext = extMatch ? extMatch[1] : 'docx';
      const baseName = lastResult.filename.replace(/\.[a-zA-Z0-9]+$/, '');
      a.download = `${baseName}_clean.${ext}`;
      document.body.appendChild(a);
      a.click();
      document.body.removeChild(a);
    });

    // サンプル投入
    sampleBtn?.addEventListener('click', async () => {
      progressArea.classList.remove('hidden');
      try {
        const sampleBuffer = await generateSampleOfficeDocx();
        await handleFile({
          name: '極秘_新規事業計画書_Chronos.docx',
          buffer: sampleBuffer,
        });
      } finally {
        progressArea.classList.add('hidden');
      }
    });

    // リセット
    resetBtn?.addEventListener('click', () => {
      resultArea.classList.add('hidden');
      if (cleanFileBlobUrl) {
        URL.revokeObjectURL(cleanFileBlobUrl);
        cleanFileBlobUrl = null;
      }
      lastResult = null;
    });

    // ドラッグ＆ドロップ
    dropZone.addEventListener('click', () => fileInput.click());
    dropZone.addEventListener('dragover', (e) => {
      e.preventDefault();
      dropZone.classList.add('border-teal-500', 'bg-teal-50/30');
    });
    dropZone.addEventListener('dragleave', () => {
      dropZone.classList.remove('border-teal-500', 'bg-teal-50/30');
    });
    dropZone.addEventListener('drop', (e) => {
      e.preventDefault();
      dropZone.classList.remove('border-teal-500', 'bg-teal-50/30');
      if (e.dataTransfer && e.dataTransfer.files.length > 0) {
        handleFile(e.dataTransfer.files[0]);
      }
    });

    fileInput.addEventListener('change', () => {
      if (fileInput.files && fileInput.files.length > 0) {
        handleFile(fileInput.files[0]);
      }
    });
  </script>
</ToolShell>
