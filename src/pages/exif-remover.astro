---
import ToolShell from '../components/ToolShell.astro';

const howToSteps = [
  {
    name: '写真ファイルをまとめてドラッグ＆ドロップ',
    text: '位置情報やEXIFを消したい写真（JPEG/PNG/WebP、100枚規模の一括投入に対応）をドロップゾーンに配置します。',
  },
  {
    name: 'ブラウザ内でGPS・EXIFを自動検出＆一括抹消',
    text: 'ドロップと同時にブラウザ内のメモリ上でGPS座標・機種名・撮影日時を解析し、画質劣化ゼロ（ロスレス）またはピクセル再描画で即座に消去します。',
  },
  {
    name: 'ZIPで一括ダウンロードまたは個別保存',
    text: 'メタデータ除去済みの安全な画像群をワンクリックでZIP一括ダウンロード、または1枚ずつ保存します。',
  },
];

const faqs = [
  {
    question: '写真をそのままWebや取引先に送るとどんな情報がバレますか？',
    answer:
      'EXIFメタデータには、GPSによる正確な緯度・経度・高度だけでなく、撮影日時（秒単位）、使用したスマートフォンやカメラの機種名、レンズ情報、OSバージョン、編集に使用したソフトウェア名などが記録されています。本ツールではこれらをまとめて検出し、一括削除します。',
  },
  {
    question: '他の無料EXIF削除サイトと何が違うのですか？',
    answer:
      '一般的なオンラインEXIF削除ツールは、写真を一度外部サーバーにアップロードして処理します。しかし「位置情報を消したいプライベート写真や社外秘写真」を外部サーバーに送信すること自体が情報漏洩リスクとなります。当ツールはサーバー送信なし（0バイト）で、ブラウザ内部のメモリだけで完結するため安全です。',
  },
  {
    question: '100枚以上の写真を一括で処理してZIPで落とせますか？',
    answer:
      'はい。複数枚のドラッグ＆ドロップに対応しており、100枚規模の写真でも数秒で一括クリーンアップし、ブラウザ内で生成した1つのZIPファイルとしてまとめてダウンロードできます。',
  },
  {
    question: '「高速ロスレス消去」と「ピクセル完全再描画」の違いは何ですか？',
    answer:
      '「高速ロスレス消去」は画像データ本体には一切触れず、EXIF/GPS/XMP等のメタデータ領域のみをバイナリ単位で切り離すため、画質劣化が0%で超高速です。一方「ピクセル完全再描画」はHTML5 Canvas上に画素だけを描画して一から画像ファイルを再生成するため、未知の独自チャンクも含めて100%初期化したい場合に適しています。',
  },
];
---

<ToolShell
  slug="exif-remover"
  title="写真の位置情報（EXIF・GPS）一括削除｜画質劣化なし"
  description="写真のEXIF・GPS位置情報・撮影日時・カメラ機種名をブラウザ内で一括削除。画質劣化ゼロで100枚規模のJPEG/PNG/WebPを安全にクリーンアップ＆ZIP出力。"
  canonicalPath="/exif-remover/"
  h1="写真 位置情報（EXIF・GPS）削除｜一括・ブラウザ完結・サーバー送信なし"
  subtitle="スマホやデジカメで撮影した写真に潜むGPS座標（自宅・現場の住所）、撮影日時、端末機種名、編集ソフト情報を検出して一括抹消。ブラウザ内だけで高速処理し、そのままZIPで一括保存できます。"
  whyTitle="「位置情報を消すために写真をネットに送る」という最大の矛盾"
  howToSteps={howToSteps}
  faqs={faqs}
>
  <!-- メイン操作パネル -->
  <div class="bg-white border border-slate-200 rounded-2xl p-6 shadow-sm space-y-6">

    <!-- 複数ファイル対応ドラッグ＆ドロップゾーン（最優先ワークベンチ） -->
    <div
      id="dropZoneExif"
      class="border-2 border-dashed border-slate-300 hover:border-cyan-600 rounded-2xl p-8 sm:p-10 text-center transition bg-slate-50/70 hover:bg-cyan-50/20 cursor-pointer group"
    >
      <input
        type="file"
        id="fileInputExif"
        accept=".jpg,.jpeg,.png,.webp,image/jpeg,image/png,image/webp"
        multiple
        class="hidden"
      />
      <div class="flex flex-col items-center gap-3 pointer-events-none">
        <div class="w-16 h-16 rounded-2xl bg-cyan-50 border border-cyan-200 flex items-center justify-center text-3xl group-hover:scale-105 transition-transform shadow-xs">
          📍
        </div>
        <div>
          <p class="font-bold text-slate-800 text-base sm:text-lg">
            写真・画像ファイルをここにまとめてドロップ（複数・100枚一括対応）
          </p>
          <p class="text-xs text-slate-500 mt-1">
            またはクリックしてファイルを選択（対応形式: JPEG / PNG / WebP）
          </p>
        </div>
        <div class="flex flex-wrap items-center justify-center gap-2 mt-1">
          <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-white border border-slate-200 text-[11px] text-cyan-800 shadow-xs font-medium">
            🔒 サーバー送信0バイト（ドロップと同時にブラウザ内でEXIF削除）
          </span>
          <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-white border border-slate-200 text-[11px] text-slate-600 shadow-xs">
            📦 ZIP一括保存対応
          </span>
        </div>
      </div>
    </div>

    <!-- 操作サブバー：ワンクリックテスト ＆ 消去モード選択 -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-3 text-xs">
      <!-- ワンクリック検証用：GPS位置情報入りサンプル写真3枚投入バー -->
      <div class="flex items-center justify-between gap-3 p-3.5 rounded-xl bg-slate-50 border border-slate-200">
        <div class="space-y-0.5">
          <span class="font-bold text-slate-800 flex items-center gap-1.5">
            <span>🧪</span>
            <span>手元に位置情報付き写真がない場合：</span>
          </span>
          <p class="text-[11px] text-slate-500">
            東京・渋谷・大阪のGPS座標と端末名を含むテスト画像3枚を自動生成
          </p>
        </div>
        <button
          id="loadSampleExifBtn"
          type="button"
          class="px-3.5 py-2 rounded-lg bg-cyan-50 hover:bg-cyan-100 text-cyan-800 border border-cyan-300 font-bold transition flex items-center justify-center gap-1.5 cursor-pointer whitespace-nowrap shadow-xs"
        >
          <span>サンプル3枚投入</span>
        </button>
      </div>

      <!-- 消去モード選択バー -->
      <div class="flex items-center justify-between gap-2 p-3.5 rounded-xl bg-slate-50 border border-slate-200">
        <div class="space-y-0.5">
          <span class="font-bold text-slate-800 flex items-center gap-1.5">
            <span>⚙️</span>
            <span>消去処理モード：</span>
          </span>
          <p class="text-[11px] text-slate-500">
            通常は画質無劣化の「高速ロスレス」推奨
          </p>
        </div>
        <div class="flex items-center gap-1 bg-slate-100 p-1 rounded-xl">
          <label class="flex items-center gap-1.5 px-2.5 py-1.5 rounded-lg bg-white border border-cyan-300 text-slate-800 cursor-pointer hover:border-cyan-500 shadow-xs transition">
            <input
              type="radio"
              name="stripMode"
              value="lossless"
              checked
              class="accent-cyan-600 text-xs"
            />
            <span class="font-bold">⚡ 高速ロスレス</span>
          </label>
          <label class="flex items-center gap-1.5 px-2.5 py-1.5 rounded-lg bg-white border border-slate-200 text-slate-600 cursor-pointer hover:border-slate-300 shadow-xs transition">
            <input
              type="radio"
              name="stripMode"
              value="canvas"
              class="accent-cyan-600 text-xs"
            />
            <span>🛡️ Canvas再描画</span>
          </label>
        </div>
      </div>
    </div>

    <!-- 処理中プログレス表示 -->
    <div id="exifProgressArea" class="hidden space-y-2 p-5 rounded-xl bg-slate-50 border border-slate-200">
      <div class="flex items-center justify-between text-xs font-semibold text-cyan-800">
        <span id="exifProgressLabel">ブラウザ内でEXIF・GPS解析＆消去中...</span>
        <span id="exifProgressCount" class="font-mono">0 / 0</span>
      </div>
      <div class="w-full h-2.5 bg-slate-200 rounded-full overflow-hidden">
        <div id="exifProgressBar" class="h-full bg-gradient-to-r from-teal-500 to-cyan-600 transition-all duration-150" style="width: 0%"></div>
      </div>
    </div>

    <!-- 処理結果＆一括ZIPダウンロードエリア -->
    <div id="exifResultArea" class="hidden space-y-5 pt-2">
      
      <!-- サマリー＆一括アクションバー -->
      <div class="p-5 rounded-2xl bg-cyan-50/70 border border-cyan-200 flex flex-col lg:flex-row items-start lg:items-center justify-between gap-4">
        <div class="space-y-1.5">
          <div class="flex flex-wrap items-center gap-2">
            <span class="px-2.5 py-0.5 rounded-full bg-emerald-50 text-emerald-800 border border-emerald-200 text-xs font-bold shadow-2xs">
              ✔ 一括クリーンアップ完了
            </span>
            <span id="exifStatTime" class="text-xs font-mono text-slate-600">
              ⚡ 処理時間: 0.05秒 (通信0バイト)
            </span>
          </div>
          <p id="exifSummaryText" class="text-sm font-bold text-slate-900">
            3枚の画像から計 1.2 KB のEXIF・GPS位置情報を完全抹消しました
          </p>
          <div class="flex flex-wrap items-center gap-3 text-xs text-slate-700">
            <span id="exifGpsCountBadge" class="inline-flex items-center gap-1 text-rose-800 font-bold">
              📍 GPS座標検出・抹消: 0枚
            </span>
            <span>•</span>
            <span id="exifMetaCountBadge" class="text-cyan-800 font-bold">
              🏷️ カメラ/EXIF検出・抹消: 0枚
            </span>
          </div>
        </div>

        <div class="flex flex-wrap items-center gap-2.5 w-full lg:w-auto">
          <button
            id="downloadAllZipBtn"
            type="button"
            class="flex-1 lg:flex-none px-6 py-3 rounded-xl font-bold text-sm text-white bg-cyan-700 hover:bg-cyan-800 transition shadow-xs flex items-center justify-center gap-2 cursor-pointer"
          >
            <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4" />
            </svg>
            <span id="downloadZipBtnLabel">全ファイルをZIPで一括保存</span>
          </button>
          <button
            id="clearExifListBtn"
            type="button"
            class="px-4 py-3 rounded-xl bg-white hover:bg-slate-100 text-slate-700 border border-slate-200 text-xs font-semibold shadow-xs transition cursor-pointer"
          >
            クリア
          </button>
        </div>
      </div>

      <!-- ゼロリークくん完了メッセージ -->
      <div class="flex items-center gap-2 p-3 rounded-xl bg-cyan-100/70 border border-cyan-200 text-xs text-cyan-950 font-medium">
        <span class="text-base select-none shrink-0">🛡️</span>
        <span><strong>ゼロリークくん：</strong>位置情報の消去が完了しました！写真はお使いの端末内だけで安全に処理されています。</span>
      </div>

      <!-- ファイル別 検出＆消去レポート一覧 -->
      <div class="space-y-2.5">
        <div class="flex items-center justify-between text-xs text-slate-500 px-1">
          <span class="font-bold text-slate-700">個別ファイル一覧＆メタデータ抹消レポート</span>
          <span id="exifListCountNotice">表示中: 0件</span>
        </div>
        <div id="exifFileList" class="space-y-2 max-h-[500px] overflow-y-auto pr-1">
          <!-- JSで動的挿入 -->
        </div>
      </div>

    </div>

  </div>

  <!-- クライアントサイドスクリプト -->
  <script>
    import {
      inspectImageMetadata,
      stripImageMetadataLossless,
      stripImageMetadataCanvas,
      createZipArchive,
      generateSampleExifJpegs,
      type ImageMetadataReport,
    } from '../utils/exif';

    interface ProcessedItem {
      originalName: string;
      cleanedName: string;
      originalSize: number;
      cleanedSize: number;
      removedBytes: number;
      beforeReport: ImageMetadataReport;
      afterReport: ImageMetadataReport;
      cleanedBytes: Uint8Array;
      mimeType: string;
    }

    let processedItems: ProcessedItem[] = [];

    const dropZone = document.getElementById('dropZoneExif')!;
    const fileInput = document.getElementById('fileInputExif') as HTMLInputElement;
    const loadSampleBtn = document.getElementById('loadSampleExifBtn')!;
    const progressArea = document.getElementById('exifProgressArea')!;
    const progressLabel = document.getElementById('exifProgressLabel')!;
    const progressCount = document.getElementById('exifProgressCount')!;
    const progressBar = document.getElementById('exifProgressBar')!;
    const resultArea = document.getElementById('exifResultArea')!;
    const statTime = document.getElementById('exifStatTime')!;
    const summaryText = document.getElementById('exifSummaryText')!;
    const gpsCountBadge = document.getElementById('exifGpsCountBadge')!;
    const metaCountBadge = document.getElementById('exifMetaCountBadge')!;
    const downloadAllZipBtn = document.getElementById('downloadAllZipBtn')!;
    const downloadZipBtnLabel = document.getElementById('downloadZipBtnLabel')!;
    const clearExifListBtn = document.getElementById('clearExifListBtn')!;
    const fileListContainer = document.getElementById('exifFileList')!;

    function getSelectedMode(): 'lossless' | 'canvas' {
      const checked = document.querySelector(
        'input[name="stripMode"]:checked'
      ) as HTMLInputElement | null;
      return checked && checked.value === 'canvas' ? 'canvas' : 'lossless';
    }

    // 単一ファイル処理
    async function processSingleFile(
      fileData: Uint8Array,
      fileName: string,
      mode: 'lossless' | 'canvas'
    ): Promise<ProcessedItem> {
      const beforeReport = inspectImageMetadata(fileData);
      let cleanedBytes: Uint8Array;
      let removedBytes = 0;

      if (mode === 'lossless' && (beforeReport.format === 'jpeg' || beforeReport.format === 'png' || beforeReport.format === 'webp')) {
        const stripped = stripImageMetadataLossless(fileData);
        cleanedBytes = stripped.cleanedBytes;
        removedBytes = stripped.removedBytes;
      } else {
        const stripped = await stripImageMetadataCanvas(fileData);
        cleanedBytes = stripped.cleanedBytes;
        removedBytes = Math.max(0, fileData.byteLength - cleanedBytes.byteLength);
      }

      const afterReport = inspectImageMetadata(cleanedBytes);

      return {
        originalName: fileName,
        cleanedName: fileName.replace(/\.([^.]+)$/, '_clean.$1'),
        originalSize: fileData.byteLength,
        cleanedSize: cleanedBytes.byteLength,
        removedBytes,
        beforeReport,
        afterReport,
        cleanedBytes,
        mimeType: beforeReport.format === 'png' ? 'image/png' : beforeReport.format === 'webp' ? 'image/webp' : 'image/jpeg',
      };
    }

    // 複数ファイル一括処理フロー
    async function handleFiles(files: (File | { name: string; data: Uint8Array })[]) {
      if (files.length === 0) return;

      const mode = getSelectedMode();
      progressArea.classList.remove('hidden');
      progressBar.style.width = '0%';
      progressLabel.textContent = `ブラウザ内でEXIF・GPS解析＆消去中 (${mode === 'lossless' ? '高速ロスレス' : 'Canvas再描画'})...`;
      progressCount.textContent = `0 / ${files.length}`;

      const startTime = performance.now();
      const newItems: ProcessedItem[] = [];

      for (let i = 0; i < files.length; i++) {
        const item = files[i];
        let bytes: Uint8Array;
        let name: string;

        if (item instanceof File) {
          name = item.name;
          const ab = await item.arrayBuffer();
          bytes = new Uint8Array(ab);
        } else {
          name = item.name;
          bytes = item.data;
        }

        const processed = await processSingleFile(bytes, name, mode);
        newItems.push(processed);

        const percent = Math.round(((i + 1) / files.length) * 100);
        progressBar.style.width = `${percent}%`;
        progressCount.textContent = `${i + 1} / ${files.length}`;
      }

      const elapsed = ((performance.now() - startTime) / 1000).toFixed(2);
      processedItems = [...newItems, ...processedItems];

      progressArea.classList.add('hidden');
      renderResults(elapsed);
    }

    // 結果レンダリング
    function renderResults(elapsedSec: string) {
      if (processedItems.length === 0) {
        resultArea.classList.add('hidden');
        return;
      }

      resultArea.classList.remove('hidden');

      const totalFiles = processedItems.length;
      const totalRemovedBytes = processedItems.reduce((acc, it) => acc + it.removedBytes, 0);
      const totalGpsCount = processedItems.filter((it) => it.beforeReport.hasGps).length;
      const totalMetaCount = processedItems.filter((it) => it.beforeReport.hasExif).length;

      statTime.textContent = `⚡ 処理時間: ${elapsedSec}秒 (通信0バイト)`;
      summaryText.textContent = `${totalFiles}枚の画像から計 ${(totalRemovedBytes / 1024).toFixed(1)} KB のEXIF・GPS位置情報を完全抹消しました`;
      gpsCountBadge.textContent = `📍 GPS座標検出・抹消: ${totalGpsCount}枚`;
      metaCountBadge.textContent = `🏷️ カメラ/EXIF検出・抹消: ${totalMetaCount}枚`;
      downloadZipBtnLabel.textContent = `${totalFiles}枚をZIPで一括保存 (${(processedItems.reduce((a, b) => a + b.cleanedSize, 0) / (1024 * 1024)).toFixed(1)} MB)`;

      const listCountNotice = document.getElementById('exifListCountNotice');
      if (listCountNotice) {
        listCountNotice.textContent = `表示中: ${totalFiles}件`;
      }

      fileListContainer.innerHTML = '';
      processedItems.forEach((item, index) => {
        const card = document.createElement('div');
        card.className =
          'p-3.5 rounded-xl bg-white border border-slate-200 hover:border-slate-300 transition shadow-2xs flex flex-col sm:flex-row items-start sm:items-center justify-between gap-3 text-xs';

        const beforeTagsStr =
          item.beforeReport.detectedTags.length > 0
            ? item.beforeReport.detectedTags.join(', ')
            : '検出なし';

        card.innerHTML = `
          <div class="space-y-1 min-w-0 flex-1">
            <div class="flex items-center gap-2">
              <span class="font-bold text-slate-900 truncate max-w-[240px] sm:max-w-md">${item.originalName}</span>
              <span class="px-1.5 py-0.5 rounded text-[10px] font-mono font-bold uppercase bg-slate-100 text-slate-700">${item.beforeReport.format}</span>
              ${
                item.beforeReport.hasGps
                  ? '<span class="px-1.5 py-0.5 rounded text-[10px] font-bold bg-rose-100 text-rose-800">GPS座標あり</span>'
                  : ''
              }
            </div>
            <div class="flex flex-wrap items-center gap-x-3 gap-y-0.5 text-[11px] text-slate-500">
              <span>元: ${(item.originalSize / 1024).toFixed(1)} KB</span>
              <span>→</span>
              <span class="text-teal-700 font-semibold">後: ${(item.cleanedSize / 1024).toFixed(1)} KB (-${item.removedBytes}B)</span>
              <span>•</span>
              <span class="text-slate-600">消去項目: ${beforeTagsStr}</span>
            </div>
          </div>
          <button
            type="button"
            data-download-idx="${index}"
            class="px-3.5 py-2 rounded-lg bg-slate-50 hover:bg-slate-100 text-slate-800 border border-slate-300 font-bold transition flex items-center gap-1.5 cursor-pointer whitespace-nowrap shrink-0"
          >
            <span>📥</span>
            <span>保存</span>
          </button>
        `;

        fileListContainer.appendChild(card);
      });

      fileListContainer.querySelectorAll('button[data-download-idx]').forEach((btn) => {
        btn.addEventListener('click', (e) => {
          const idx = parseInt((e.currentTarget as HTMLElement).getAttribute('data-download-idx') || '0', 10);
          const target = processedItems[idx];
          if (target) {
            const blob = new Blob([target.cleanedBytes], { type: target.mimeType });
            const url = URL.createObjectURL(blob);
            const a = document.createElement('a');
            a.href = url;
            a.download = target.cleanedName;
            document.body.appendChild(a);
            a.click();
            document.body.removeChild(a);
            URL.revokeObjectURL(url);
          }
        });
      });
    }

    // ZIPダウンロード実行
    downloadAllZipBtn.addEventListener('click', () => {
      if (processedItems.length === 0) return;
      const zipFiles = processedItems.map((item) => ({
        name: item.cleanedName,
        data: item.cleanedBytes,
      }));
      const zipBuffer = createZipArchive(zipFiles);
      const blob = new Blob([zipBuffer], { type: 'application/zip' });
      const url = URL.createObjectURL(blob);
      const a = document.createElement('a');
      a.href = url;
      a.download = `zeroleak_photos_clean_${Date.now()}.zip`;
      document.body.appendChild(a);
      a.click();
      document.body.removeChild(a);
      URL.revokeObjectURL(url);
    });

    // クリア
    clearExifListBtn.addEventListener('click', () => {
      processedItems = [];
      resultArea.classList.add('hidden');
      fileInput.value = '';
    });

    // サンプル投入
    loadSampleBtn.addEventListener('click', async () => {
      const sampleFiles = generateSampleExifJpegs();
      await handleFiles(sampleFiles);
    });

    // ドラッグ＆ドロップイベント
    dropZone.addEventListener('click', () => fileInput.click());
    dropZone.addEventListener('dragover', (e) => {
      e.preventDefault();
      dropZone.classList.add('border-cyan-500', 'bg-cyan-50/30');
    });
    dropZone.addEventListener('dragleave', () => {
      dropZone.classList.remove('border-cyan-500', 'bg-cyan-50/30');
    });
    dropZone.addEventListener('drop', (e) => {
      e.preventDefault();
      dropZone.classList.remove('border-cyan-500', 'bg-cyan-50/30');
      if (e.dataTransfer && e.dataTransfer.files.length > 0) {
        handleFiles(Array.from(e.dataTransfer.files));
      }
    });

    fileInput.addEventListener('change', () => {
      if (fileInput.files && fileInput.files.length > 0) {
        handleFiles(Array.from(fileInput.files));
      }
    });
