---
import Layout from '../layouts/Layout.astro';
import SecuritySpecModal from '../components/SecuritySpecModal.astro';
import RelatedTools from '../components/RelatedTools.astro';

// SGO / Googleリッチリザルト用 構造化データ
const extraSchemaGraph = [
  {
    "@type": "HowTo",
    "name": "写真のEXIF・GPS位置情報をブラウザで一括削除する3ステップ（サーバー送信なし）",
    "description": "JPEG・PNG・WebP画像に含まれるGPS座標、撮影日時、カメラ機種名などのEXIFメタデータを、外部サーバーへ一切送信せずブラウザ内で一括消去してZIP保存する手順。",
    "step": [
      {
        "@type": "HowToStep",
        "name": "写真ファイルをまとめてドラッグ＆ドロップ",
        "text": "位置情報やEXIFを消したい写真（JPEG/PNG/WebP、100枚規模の一括投入に対応）をドロップゾーンに配置します。"
      },
      {
        "@type": "HowToStep",
        "name": "ブラウザ内でGPS・EXIFを自動検出＆一括抹消",
        "text": "ドロップと同時にブラウザ内のメモリ上でGPS座標・機種名・撮影日時を解析し、画質劣化ゼロ（ロスレス）またはピクセル再描画で即座に消去します。"
      },
      {
        "@type": "HowToStep",
        "name": "ZIPで一括ダウンロードまたは個別保存",
        "text": "メタデータ除去済みの安全な画像群をワンクリックでZIP一括ダウンロード、または1枚ずつ保存します。"
      }
    ]
  },
  {
    "@type": "FAQPage",
    "mainEntity": [
      {
        "@type": "Question",
        "name": "写真をそのままSNSやブログ、社内資料に載せるとどんな危険がありますか？",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "スマートフォン（iPhone / Android）やデジタルカメラで撮影した写真には、目に見えないEXIFメタデータとして「GPSの緯度・経度（自宅や取引先・工場の正確な住所）」「撮影日時」「使用端末・OSバージョン」が記録されています。そのままWeb公開や外部提出を行うと、自宅マンションや未公開施設の場所が特定される重大なプライバシー・機密漏洩につながります。"
        }
      },
      {
        "@type": "Question",
        "name": "一般的な無料EXIF削除サイトと何が違うのですか？",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "多くの無料オンライン画像ツールは、写真ファイルを一度運営者のサーバーへアップロードして処理します。つまり「消したい位置情報付きのプライベート写真や社外秘の現場写真」を第三者のサーバーへ渡していることになります。ZeroLeak Toolsは「サーバー送信なし（0バイト）」で、お使いのブラウザ内部だけで一括処理するため、情報漏洩リスクが0%です。"
        }
      },
      {
        "@type": "Question",
        "name": "100枚などの大量の写真も一括でブラウザ処理できますか？",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "はい。画像のバイナリ構造からEXIF/GPS/XMPチャンクのみを直接切り離す「高速ロスレス消去モード」を搭載しているため、画質を1ミリも劣化させず、100枚規模の画像でも数秒で一括処理し、ブラウザ内で即座にZIPアーカイブへまとめてダウンロードできます。"
        }
      },
      {
        "@type": "Question",
        "name": "JPEGだけでなくPNGやWebPのメタデータにも対応していますか？",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "はい。JPEGのEXIF（APP1〜APP15・COMセグメント）だけでなく、PNGのeXIf・tEXt・iTXt・zTXt・tIMEチャンク、およびWebPのEXIF・XMPチャンクの解析・一括削除に完全対応しています。"
        }
      }
    ]
  }
];
---

<Layout
  title="写真の位置情報（EXIF・GPS）一括削除｜画質劣化なし"
  description="写真のEXIF・GPS位置情報・撮影日時・カメラ機種名をブラウザ内で一括削除。画質劣化ゼロで100枚規模のJPEG/PNG/WebPを安全にクリーンアップ＆ZIP出力。"
  canonicalPath="/exif-remover/"
  extraSchemaGraph={extraSchemaGraph}
>
  <div class="max-w-5xl mx-auto space-y-8">

    <!-- ツールヘッダー & H1（複合キーワード「一括 ブラウザ」「サーバー送信なし」を明記） -->
    <div class="space-y-3">
      <div class="flex flex-wrap items-center justify-between gap-2">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-cyan-50 border border-cyan-200 text-cyan-800 text-xs font-semibold shadow-xs">
          <span>完全ローカル処理</span>
          <span>•</span>
          <span>画質劣化ゼロ</span>
          <span>•</span>
          <span>100枚一括ZIP保存</span>
        </div>

        <!-- 情シス向けセキュリティ仕様書 ボタン -->
        <button
          type="button"
          onclick="window.openSecurityModal && window.openSecurityModal()"
          class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg bg-white hover:bg-slate-50 text-slate-700 hover:text-slate-900 text-xs font-semibold border border-slate-200 shadow-xs transition cursor-pointer"
        >
          <span>🏢</span>
          <span>社内利用・情シス申請用仕様書</span>
        </button>
      </div>

      <h1 class="text-2xl sm:text-4xl font-extrabold text-slate-900 tracking-tight leading-tight">
        写真 位置情報（EXIF・GPS）削除｜一括・ブラウザ完結・サーバー送信なし
      </h1>
      <p class="text-slate-600 text-sm sm:text-base leading-relaxed">
        スマホやデジカメで撮影した写真に潜む<strong>GPS座標（自宅・現場の住所）、撮影日時、端末機種名、編集ソフト情報</strong>を検出して一括抹消。
        <strong>外部サーバー送信なし（0バイト）</strong>でお使いのブラウザ内だけで高速処理し、そのままZIPで一括ダウンロードできます。
      </p>
    </div>

    <!-- メイン操作パネル -->
    <div class="bg-white border border-slate-200 rounded-2xl p-6 shadow-sm space-y-6">

      <!-- 複数ファイル対応ドラッグ＆ドロップゾーン（最優先ワークベンチ） -->
      <div
        id="dropZoneExif"
        class="border-2 border-dashed border-slate-300 hover:border-cyan-600 rounded-2xl p-8 sm:p-10 text-center transition bg-slate-50/70 hover:bg-cyan-50/20 cursor-pointer group"
      >
        <input
          type="file"
          id="fileInputExif"
          accept=".jpg,.jpeg,.png,.webp,image/jpeg,image/png,image/webp"
          multiple
          class="hidden"
        />
        <div class="flex flex-col items-center gap-3 pointer-events-none">
          <div class="w-16 h-16 rounded-2xl bg-cyan-50 border border-cyan-200 flex items-center justify-center text-3xl group-hover:scale-105 transition-transform shadow-xs">
            📍
          </div>
          <div>
            <p class="font-bold text-slate-800 text-base sm:text-lg">
              写真・画像ファイルをここにまとめてドロップ（複数・100枚一括対応）
            </p>
            <p class="text-xs text-slate-500 mt-1">
              またはクリックしてファイルを選択（対応形式: JPEG / PNG / WebP）
            </p>
          </div>
          <div class="flex flex-wrap items-center justify-center gap-2 mt-1">
            <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-white border border-slate-200 text-[11px] text-cyan-800 shadow-xs font-medium">
              🔒 サーバー送信0バイト（ドロップと同時にブラウザ内でEXIF削除）
            </span>
            <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-white border border-slate-200 text-[11px] text-slate-600 shadow-xs">
              📦 ZIP一括保存対応
            </span>
          </div>
        </div>
      </div>

      <!-- 操作サブバー：ワンクリックテスト ＆ 消去モード選択 -->
      <div class="grid grid-cols-1 md:grid-cols-2 gap-3 text-xs">
        <!-- ワンクリック検証用：GPS位置情報入りサンプル写真3枚投入バー -->
        <div class="flex items-center justify-between gap-3 p-3.5 rounded-xl bg-slate-50 border border-slate-200">
          <div class="space-y-0.5">
            <span class="font-bold text-slate-800 flex items-center gap-1.5">
              <span>🧪</span>
              <span>手元に位置情報付き写真がない場合：</span>
            </span>
            <p class="text-[11px] text-slate-500">
              東京・渋谷・大阪のGPS座標と端末名を含むテスト画像3枚を自動生成
            </p>
          </div>
          <button
            id="loadSampleExifBtn"
            type="button"
            class="px-3.5 py-2 rounded-lg bg-cyan-50 hover:bg-cyan-100 text-cyan-800 border border-cyan-300 font-bold transition flex items-center justify-center gap-1.5 cursor-pointer whitespace-nowrap shadow-xs"
          >
            <span>サンプル3枚投入</span>
          </button>
        </div>

        <!-- 消去モード選択バー -->
        <div class="flex items-center justify-between gap-2 p-3.5 rounded-xl bg-slate-50 border border-slate-200">
          <div class="space-y-0.5">
            <span class="font-bold text-slate-800 flex items-center gap-1.5">
              <span>⚙️</span>
              <span>消去モード：</span>
            </span>
            <p class="text-[11px] text-slate-500">
              画質劣化0%の高速ロスレスを推奨
            </p>
          </div>
          <div class="flex items-center gap-2">
            <label class="flex items-center gap-1.5 px-2.5 py-1.5 rounded-lg bg-white border border-cyan-300 text-slate-800 cursor-pointer hover:border-cyan-500 shadow-xs transition">
              <input
                type="radio"
                name="stripMode"
                value="lossless"
                checked
                class="accent-cyan-600 text-xs"
              />
              <span class="font-bold">⚡ 高速ロスレス</span>
            </label>
            <label class="flex items-center gap-1.5 px-2.5 py-1.5 rounded-lg bg-white border border-slate-200 text-slate-600 cursor-pointer hover:border-slate-300 shadow-xs transition">
              <input
                type="radio"
                name="stripMode"
                value="canvas"
                class="accent-cyan-600 text-xs"
              />
              <span>🛡️ Canvas再描画</span>
            </label>
          </div>
        </div>
      </div>

      <!-- 処理中プログレス表示 -->
      <div id="exifProgressArea" class="hidden space-y-2 p-5 rounded-xl bg-slate-50 border border-slate-200">
        <div class="flex items-center justify-between text-xs font-semibold text-cyan-800">
          <span id="exifProgressLabel">ブラウザ内でEXIF・GPS解析＆消去中...</span>
          <span id="exifProgressCount" class="font-mono">0 / 0</span>
        </div>
        <div class="w-full h-2.5 bg-slate-200 rounded-full overflow-hidden">
          <div id="exifProgressBar" class="h-full bg-gradient-to-r from-teal-500 to-cyan-600 transition-all duration-150" style="width: 0%"></div>
        </div>
      </div>

      <!-- 処理結果＆一括ZIPダウンロードエリア -->
      <div id="exifResultArea" class="hidden space-y-5 pt-2">
        
        <!-- サマリー＆一括アクションバー -->
        <div class="p-5 rounded-2xl bg-cyan-50/70 border border-cyan-200 flex flex-col lg:flex-row items-start lg:items-center justify-between gap-4">
          <div class="space-y-1.5">
            <div class="flex flex-wrap items-center gap-2">
              <span class="px-2.5 py-0.5 rounded-full bg-emerald-50 text-emerald-800 border border-emerald-200 text-xs font-bold shadow-2xs">
                ✔ 一括クリーンアップ完了
              </span>
              <span id="exifStatTime" class="text-xs font-mono text-slate-600">
                ⚡ 処理時間: 0.05秒 (通信0バイト)
              </span>
            </div>
            <p id="exifSummaryText" class="text-sm font-bold text-slate-900">
              3枚の画像から計 1.2 KB のEXIF・GPS位置情報を完全抹消しました
            </p>
            <div class="flex flex-wrap items-center gap-3 text-xs text-slate-700">
              <span id="exifGpsCountBadge" class="inline-flex items-center gap-1 text-rose-800 font-bold">
                📍 GPS座標検出・抹消: 0枚
              </span>
              <span>•</span>
              <span id="exifMetaCountBadge" class="text-cyan-800 font-bold">
                🏷️ カメラ/EXIF検出・抹消: 0枚
              </span>
            </div>
          </div>

          <div class="flex flex-wrap items-center gap-2.5 w-full lg:w-auto">
            <button
              id="downloadAllZipBtn"
              type="button"
              class="flex-1 lg:flex-none px-6 py-3 rounded-xl font-bold text-sm text-white bg-cyan-700 hover:bg-cyan-800 transition shadow-xs flex items-center justify-center gap-2 cursor-pointer"
            >
              <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4" />
              </svg>
              <span id="downloadZipBtnLabel">全ファイルをZIPで一括保存</span>
            </button>
            <button
              id="clearExifListBtn"
              type="button"
              class="px-4 py-3 rounded-xl bg-white hover:bg-slate-100 text-slate-700 border border-slate-200 text-xs font-semibold shadow-xs transition cursor-pointer"
            >
              クリア
            </button>
          </div>
        </div>

        <!-- ファイル別 検出＆消去レポート一覧 -->
        <div class="space-y-2.5">
          <div class="flex items-center justify-between text-xs text-slate-500 px-1">
            <span class="font-bold text-slate-700">📋 ファイル別 検出メタデータ＆消去ステータス</span>
            <span>すべて除去後の検証（再スキャンで残存0件を確認済）</span>
          </div>

          <div id="exifFileList" class="space-y-2.5 max-h-[460px] overflow-y-auto pr-1">
            <!-- JSで各ファイルのBefore/Afterカードを描画 -->
          </div>
        </div>

      </div>

    </div>

    <!-- 【トピック1：ツール直下・キラー納得解説】なぜ写真の位置情報（Exif・GPS）一括削除が必要なのか -->
    <section class="bg-slate-100/90 border border-slate-200/90 rounded-3xl p-5 sm:p-8 space-y-6">
      <div class="space-y-2 text-left">
        <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-cyan-100/90 border border-cyan-200 text-cyan-900 text-xs font-bold shadow-2xs">
          <span>💡 なぜこのツールが必要なのか？</span>
        </div>
        <h2 class="text-xl sm:text-2xl font-extrabold text-slate-900 tracking-tight">
          「SNSが自動で消してくれるから大丈夫」という最大の落とし穴
        </h2>
        <p class="text-xs sm:text-sm text-slate-600 leading-relaxed">
          なぜブログ、社外チャット、メール添付、フリマ出品では位置情報が全世界へ漏洩してしまうのか？
        </p>
      </div>

      <!-- 3つの致命的な盲点（白背景カードで浮き立たせ境界を明確化） -->
      <div class="grid grid-cols-1 md:grid-cols-3 gap-4 text-xs">
        <div class="p-5 rounded-2xl bg-white border border-slate-200 shadow-sm space-y-2.5 text-left">
          <div class="w-8 h-8 rounded-lg bg-rose-50 border border-rose-200 flex items-center justify-center text-base font-bold text-rose-700">
            1
          </div>
          <h3 class="font-bold text-slate-900 text-sm">
            ブログ・自社サイト・メールは「生Exifのまま」配信される
          </h3>
          <p class="text-slate-600 leading-relaxed">
            X（旧Twitter）やInstagramは投稿時にExifを消去しますが、<strong>WordPressブログ、note、自社HP、ECサイト、SlackやTeamsのファイル共有、メール添付</strong>では、スマホで撮った生JPEGがそのまま相手や世界中にダウンロード可能な状態で渡されます。
          </p>
        </div>

        <div class="p-5 rounded-2xl bg-white border border-slate-200 shadow-sm space-y-2.5 text-left">
          <div class="w-8 h-8 rounded-lg bg-amber-50 border border-amber-200 flex items-center justify-center text-base font-bold text-amber-700">
            2
          </div>
          <h3 class="font-bold text-slate-900 text-sm">
            数メートル精度のGPS座標から「自宅マンションの部屋」まで特定
          </h3>
          <p class="text-slate-600 leading-relaxed">
            写真のExif（APP1メタデータ領域）には、目に見えない形で<strong>正確な緯度・経度（WGS84座標）・高度・撮影日時（秒単位）・端末型番</strong>が刻まれています。写真を開いて「右クリック→プロパティ」するだけで、誰でも地図上に撮影位置を1秒でピンポイント表示できます。
          </p>
        </div>

        <div class="p-5 rounded-2xl bg-white border border-slate-200 shadow-sm space-y-2.5 text-left">
          <div class="w-8 h-8 rounded-lg bg-cyan-50 border border-cyan-200 flex items-center justify-center text-base font-bold text-cyan-800">
            3
          </div>
          <h3 class="font-bold text-slate-900 text-sm">
            無料Exif削除サイトに「消したいプライベート写真」を預ける恐怖
          </h3>
          <p class="text-slate-600 leading-relaxed">
            ネット上の一般的な無料Exif削除ツールは、画像を一度サーバーへアップロードして処理します。<strong>「位置情報を消したい自宅写真や社外秘の現場写真」を第三者のサーバーへ自ら差し出すことになり</strong>、サーバー側のログや一時キャッシュに残る重大な流出リスクがあります。
          </p>
        </div>
      </div>

      <!-- 解決策カード -->
      <div class="p-4 sm:p-5 rounded-2xl bg-cyan-50 border border-cyan-200/90 text-xs text-cyan-950 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-3 shadow-2xs text-left">
        <div class="space-y-1">
          <strong class="font-bold text-cyan-900 text-sm flex items-center gap-1.5">
            <span>✓</span>
            <span>ZeroLeak Exif削除の完全ローカル保証：</span>
          </strong>
          <p class="text-slate-600 leading-relaxed">
            ファイルを外部サーバーへ1バイトも送信せず、ブラウザ内メモリだけでAPP1バイナリチャンクを直接切り離し。画質劣化0%の高速ロスレス消去で、100枚規模の写真も即座にZIP保存できます。
          </p>
        </div>
      </div>
    </section>

    <!-- 【トピック2：実務シチュエーション】よくある3つの活用シーン -->
    <section class="bg-white border border-slate-200/90 rounded-3xl p-5 sm:p-8 space-y-5 shadow-xs">
      <div class="space-y-1 text-left border-b border-slate-100 pb-3">
        <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-slate-100 text-slate-700 text-xs font-bold">
          <span>🏢 実務シチュエーション</span>
        </div>
        <h3 class="text-lg sm:text-xl font-bold text-slate-900 tracking-tight">
          こんなシチュエーションで威力を発揮します
        </h3>
        <p class="text-xs text-slate-500">フリマ出品・現場写真報告・Web広報で選ばれる3つの代表的ユースケース</p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-3 text-xs">
        
        <div class="p-4 rounded-2xl bg-slate-50/80 border border-slate-200 shadow-2xs space-y-2 text-left">
          <div class="font-bold text-slate-900 flex items-center gap-2">
            <span class="w-6 h-6 rounded-lg bg-cyan-100 text-cyan-800 flex items-center justify-center text-xs font-mono font-bold">01</span>
            <span class="text-xs sm:text-sm">メルカリ・ヤフオク等のフリマ出品</span>
          </div>
          <p class="text-slate-600 leading-relaxed text-[11px] sm:text-xs">
            自宅リビングや自室で撮った商品写真から、住所や最寄り駅、住居階数が特定されるプライバシー侵害・空き巣リスクを完全に遮断。
          </p>
        </div>

        <div class="p-4 rounded-2xl bg-slate-50/80 border border-slate-200 shadow-2xs space-y-2 text-left">
          <div class="font-bold text-slate-900 flex items-center gap-2">
            <span class="w-6 h-6 rounded-lg bg-teal-100 text-teal-800 flex items-center justify-center text-xs font-mono font-bold">02</span>
            <span class="text-xs sm:text-sm">建築・不動産・点検の現場報告</span>
          </div>
          <p class="text-slate-600 leading-relaxed text-[11px] sm:text-xs">
            顧客宅や未発表工場・インフラ設備の施工写真を施主や元請けに提出する際、機密拠点の座標漏洩を防ぐため100枚一括でクリーンアップ。
          </p>
        </div>

        <div class="p-4 rounded-2xl bg-slate-50/80 border border-slate-200 shadow-2xs space-y-2 text-left">
          <div class="font-bold text-slate-900 flex items-center gap-2">
            <span class="w-6 h-6 rounded-lg bg-indigo-100 text-indigo-800 flex items-center justify-center text-xs font-mono font-bold">03</span>
            <span class="text-xs sm:text-sm">広報・オウンドメディア・ブログ</span>
          </div>
          <p class="text-slate-600 leading-relaxed text-[11px] sm:text-xs">
            WordPressや自社サイトへ写真をアップする前に、バイナリ直接除去（高速ロスレス）で画質を1ミリも落とさずにメタデータのみ完全消去。
          </p>
        </div>

      </div>
    </section>

    <!-- 【FAQPage】よくある質問アコーディオン -->
    <section class="space-y-4 pt-2">
      <div class="border-b border-slate-200 pb-2">
        <h2 class="text-lg sm:text-xl font-bold text-slate-900 flex items-center gap-2">
          <span>❓</span>
          <span>よくある質問（FAQ）</span>
        </h2>
      </div>

      <div class="space-y-3 text-xs sm:text-sm text-slate-700">
        <details class="group p-4 rounded-xl bg-white border border-slate-200 hover:border-slate-300 shadow-xs">
          <summary class="font-bold text-slate-900 cursor-pointer flex items-center justify-between">
            <span>Q. 写真をそのままWebや取引先に送るとどんな情報がバレますか？</span>
            <span class="text-cyan-700 group-open:rotate-180 transition-transform">▼</span>
          </summary>
          <p class="mt-3 text-slate-600 leading-relaxed text-xs">
            EXIFメタデータには、GPSによる正確な緯度・経度・高度だけでなく、撮影日時（秒単位）、使用したスマートフォンやカメラの機種名、レンズ情報、OSバージョン、編集に使用したソフトウェア名などが記録されています。本ツールではこれらをまとめて検出し、一括削除します。
          </p>
        </details>

        <details class="group p-4 rounded-xl bg-white border border-slate-200 hover:border-slate-300 shadow-xs">
          <summary class="font-bold text-slate-900 cursor-pointer flex items-center justify-between">
            <span>Q. 他の無料EXIF削除サイトと何が違うのですか？</span>
            <span class="text-cyan-700 group-open:rotate-180 transition-transform">▼</span>
          </summary>
          <p class="mt-3 text-slate-600 leading-relaxed text-xs">
            一般的なオンラインEXIF削除ツールは、写真を一度外部サーバーにアップロードして処理します。しかし「位置情報を消したいプライベート写真や社外秘写真」を外部サーバーに送信すること自体が情報漏洩リスクとなります。当ツールはサーバー送信なし（0バイト）で、ブラウザ内部のメモリだけで完結するため安全です。
          </p>
        </details>

        <details class="group p-4 rounded-xl bg-white border border-slate-200 hover:border-slate-300 shadow-xs">
          <summary class="font-bold text-slate-900 cursor-pointer flex items-center justify-between">
            <span>Q. 100枚以上の写真を一括で処理してZIPで落とせますか？</span>
            <span class="text-cyan-700 group-open:rotate-180 transition-transform">▼</span>
          </summary>
          <p class="mt-3 text-slate-600 leading-relaxed text-xs">
            はい。複数枚のドラッグ＆ドロップに対応しており、100枚規模の写真でも数秒で一括クリーンアップし、ブラウザ内で生成した1つのZIPファイルとしてまとめてダウンロードできます。
          </p>
        </details>

        <details class="group p-4 rounded-xl bg-white border border-slate-200 hover:border-slate-300 shadow-xs">
          <summary class="font-bold text-slate-900 cursor-pointer flex items-center justify-between">
            <span>Q. 「高速ロスレス消去」と「ピクセル完全再描画」の違いは何ですか？</span>
            <span class="text-cyan-700 group-open:rotate-180 transition-transform">▼</span>
          </summary>
          <p class="mt-3 text-slate-600 leading-relaxed text-xs">
            「高速ロスレス消去」は画像データ本体には一切触れず、EXIF/GPS/XMP等のメタデータ領域のみをバイナリ単位で切り離すため、画質劣化が0%で超高速です。一方「ピクセル完全再描画」はHTML5 Canvas上に画素だけを描画して一から画像ファイルを再生成するため、未知の独自チャンクも含めて100%初期化したい場合に適しています。
          </p>
        </details>
      </div>
    </section>

    <RelatedTools currentPath="/exif-remover/" />
  </div>

  <!-- セキュリティ仕様書モーダル -->
  <SecuritySpecModal />

  <!-- クライアントサイドスクリプト -->
  <script>
    import {
      inspectImageMetadata,
      stripImageMetadataLossless,
      stripImageMetadataCanvas,
      createZipArchive,
      generateSampleExifJpegs,
      type ImageMetadataReport,
    } from '../utils/exif';

    interface ProcessedItem {
      originalName: string;
      cleanedName: string;
      originalSize: number;
      cleanedSize: number;
      removedBytes: number;
      beforeReport: ImageMetadataReport;
      afterReport: ImageMetadataReport;
      cleanedBytes: Uint8Array;
      mimeType: string;
    }

    let processedItems: ProcessedItem[] = [];

    const dropZone = document.getElementById('dropZoneExif')!;
    const fileInput = document.getElementById('fileInputExif') as HTMLInputElement;
    const loadSampleBtn = document.getElementById('loadSampleExifBtn')!;
    const progressArea = document.getElementById('exifProgressArea')!;
    const progressLabel = document.getElementById('exifProgressLabel')!;
    const progressCount = document.getElementById('exifProgressCount')!;
    const progressBar = document.getElementById('exifProgressBar')!;
    const resultArea = document.getElementById('exifResultArea')!;
    const statTime = document.getElementById('exifStatTime')!;
    const summaryText = document.getElementById('exifSummaryText')!;
    const gpsCountBadge = document.getElementById('exifGpsCountBadge')!;
    const metaCountBadge = document.getElementById('exifMetaCountBadge')!;
    const downloadAllZipBtn = document.getElementById('downloadAllZipBtn')!;
    const downloadZipBtnLabel = document.getElementById('downloadZipBtnLabel')!;
    const clearExifListBtn = document.getElementById('clearExifListBtn')!;
    const fileListContainer = document.getElementById('exifFileList')!;

    function getSelectedMode(): 'lossless' | 'canvas' {
      const checked = document.querySelector(
        'input[name="stripMode"]:checked'
      ) as HTMLInputElement | null;
      return checked?.value === 'canvas' ? 'canvas' : 'lossless';
    }

    function formatBytes(bytes: number): string {
      if (bytes < 1024) return `${bytes} B`;
      if (bytes < 1024 * 1024) return `${(bytes / 1024).toFixed(1)} KB`;
      return `${(bytes / (1024 * 1024)).toFixed(2)} MB`;
    }

    function escapeHtml(str: string): string {
      return str
        .replace(/&/g, '&amp;')
        .replace(/</g, '&lt;')
        .replace(/>/g, '&gt;')
        .replace(/"/g, '&quot;');
    }

    // D&D イベント
    dropZone.addEventListener('click', () => fileInput.click());
    dropZone.addEventListener('dragover', (e) => {
      e.preventDefault();
      dropZone.classList.add('border-emerald-500');
    });
    dropZone.addEventListener('dragleave', () => {
      dropZone.classList.remove('border-emerald-500');
    });
    dropZone.addEventListener('drop', async (e) => {
      e.preventDefault();
      dropZone.classList.remove('border-emerald-500');
      if (e.dataTransfer?.files && e.dataTransfer.files.length > 0) {
        const files = Array.from(e.dataTransfer.files);
        await processFileBatch(files);
      }
    });

    fileInput.addEventListener('change', async () => {
      if (fileInput.files && fileInput.files.length > 0) {
        const files = Array.from(fileInput.files);
        await processFileBatch(files);
        fileInput.value = '';
      }
    });

    // サンプル写真3枚投入
    loadSampleBtn.addEventListener('click', async () => {
      loadSampleBtn.setAttribute('disabled', 'true');
      try {
        const samples = await generateSampleExifJpegs();
        await processRawBatch(samples);
      } finally {
        loadSampleBtn.removeAttribute('disabled');
      }
    });

    // クリアボタン
    clearExifListBtn.addEventListener('click', () => {
      processedItems = [];
      fileListContainer.innerHTML = '';
      resultArea.classList.add('hidden');
    });

    async function processFileBatch(files: File[]) {
      const validFiles = files.filter((f) =>
        /\.(jpe?g|png|webp)$/i.test(f.name) ||
        ['image/jpeg', 'image/png', 'image/webp'].includes(f.type)
      );
      if (validFiles.length === 0) {
        alert('対応している画像ファイル（JPEG / PNG / WebP）を選択してください。');
        return;
      }

      const rawList: { name: string; bytes: Uint8Array }[] = [];
      for (const f of validFiles) {
        const buf = await f.arrayBuffer();
        rawList.push({ name: f.name, bytes: new Uint8Array(buf) });
      }
      await processRawBatch(rawList);
    }

    async function processRawBatch(rawFiles: { name: string; bytes: Uint8Array }[]) {
      const mode = getSelectedMode();
      const startTime = performance.now();

      progressArea.classList.remove('hidden');
      resultArea.classList.add('hidden');
      processedItems = [];

      const total = rawFiles.length;
      for (let i = 0; i < total; i++) {
        const item = rawFiles[i];
        progressLabel.textContent = `ブラウザ内でEXIF・GPS解析＆消去中... (${item.name})`;
        progressCount.textContent = `${i + 1} / ${total}`;
        progressBar.style.width = `${Math.round(((i + 1) / total) * 100)}%`;

        const beforeReport = inspectImageMetadata(item.bytes);
        if (beforeReport.format === 'unknown') continue;

        let cleanedBytes: Uint8Array;
        let removedBytes = 0;

        if (mode === 'canvas') {
          cleanedBytes = await stripImageMetadataCanvas(item.bytes, beforeReport.format);
          removedBytes = Math.max(0, beforeReport.metadataByteCount);
        } else {
          const res = stripImageMetadataLossless(item.bytes);
          cleanedBytes = res.cleanedBytes;
          removedBytes = res.removedBytes;
        }

        const afterReport = inspectImageMetadata(cleanedBytes);
        const extMatch = item.name.match(/(\.[^.]+)$/);
        const ext = extMatch ? extMatch[1] : '.jpg';
        const baseName = item.name.replace(/\.[^.]+$/, '');
        const cleanedName = `${baseName}_clean${ext}`;
        const mimeType =
          beforeReport.format === 'png'
            ? 'image/png'
            : beforeReport.format === 'webp'
            ? 'image/webp'
            : 'image/jpeg';

        processedItems.push({
          originalName: item.name,
          cleanedName,
          originalSize: item.bytes.length,
          cleanedSize: cleanedBytes.length,
          removedBytes,
          beforeReport,
          afterReport,
          cleanedBytes,
          mimeType,
        });
      }

      const elapsedSec = ((performance.now() - startTime) / 1000).toFixed(2);
      progressArea.classList.add('hidden');
      renderResults(elapsedSec);
    }

    function renderResults(elapsedSec: string) {
      if (processedItems.length === 0) return;

      const totalRemovedBytes = processedItems.reduce((acc, i) => acc + i.removedBytes, 0);
      const gpsDetectedCount = processedItems.filter((i) => i.beforeReport.hasGps).length;
      const metaDetectedCount = processedItems.filter(
        (i) =>
          i.beforeReport.hasExif ||
          i.beforeReport.hasXmpOrIptc ||
          i.beforeReport.hasComment ||
          i.removedBytes > 0
      ).length;

      statTime.textContent = `⚡ 処理完了: ${elapsedSec}秒 (${processedItems.length}枚一括・外部通信0バイト)`;
      summaryText.textContent = `${processedItems.length}枚の画像から計 ${formatBytes(
        totalRemovedBytes
      )} のEXIF・GPS位置情報を完全抹消しました`;
      gpsCountBadge.textContent = `📍 GPS座標検出・抹消: ${gpsDetectedCount}枚`;
      metaCountBadge.textContent = `🏷️ EXIF/メタデータ抹消: ${metaDetectedCount}枚`;
      downloadZipBtnLabel.textContent = `全${processedItems.length}枚をZIPで一括保存`;

      fileListContainer.innerHTML = processedItems
        .map((item, idx) => {
          const hasTags = item.beforeReport.detectedTags.length > 0;
          const tagsHtml = hasTags
            ? item.beforeReport.detectedTags
                .map((t) => {
                  const isGps = t.includes('GPS');
                  const badgeClass = isGps
                    ? 'bg-rose-50 text-rose-800 border-rose-200'
                    : 'bg-amber-50 text-amber-800 border-amber-200';
                  return `<span class="inline-flex items-center gap-1 px-2 py-0.5 rounded border text-[11px] font-semibold ${badgeClass}">🗑️ ${escapeHtml(
                    t
                  )} → 消去済</span>`;
                })
                .join(' ')
            : `<span class="inline-flex items-center gap-1 px-2 py-0.5 rounded bg-slate-100 text-slate-600 text-[11px] font-medium">メタデータなし（クリーン確認済）</span>`;

          return `
            <div class="p-4 rounded-xl bg-white border border-slate-200 flex flex-col sm:flex-row sm:items-center justify-between gap-3 shadow-2xs">
              <div class="space-y-1.5 min-w-0">
                <div class="flex flex-wrap items-center gap-2">
                  <span class="px-2 py-0.5 rounded bg-slate-100 text-cyan-900 font-mono text-[10px] uppercase font-bold border border-slate-200">
                    ${item.beforeReport.format}
                  </span>
                  <span class="font-bold text-slate-900 text-xs sm:text-sm truncate">
                    ${escapeHtml(item.originalName)}
                  </span>
                  <span class="text-[11px] text-slate-500 font-mono">
                    (${formatBytes(item.originalSize)} → ${formatBytes(item.cleanedSize)})
                  </span>
                </div>
                <div class="flex flex-wrap items-center gap-1.5">
                  ${tagsHtml}
                </div>
              </div>
              <div class="flex items-center gap-2 self-end sm:self-center flex-shrink-0">
                <span class="text-[11px] text-emerald-700 font-bold">✔ 残存EXIF 0件</span>
                <button
                  type="button"
                  data-download-idx="${idx}"
                  class="single-download-btn px-3 py-1.5 rounded-lg bg-white hover:bg-slate-50 text-cyan-800 border border-slate-300 text-xs font-bold transition cursor-pointer shadow-2xs"
                >
                  📥 個別保存
                </button>
              </div>
            </div>
          `;
        })
        .join('');

      // 個別保存ボタンのイベント登録
      document.querySelectorAll('.single-download-btn').forEach((btn) => {
        btn.addEventListener('click', (e) => {
          const target = e.currentTarget as HTMLElement;
          const idx = Number(target.getAttribute('data-download-idx'));
          const item = processedItems[idx];
          if (!item) return;
          triggerDownload(item.cleanedBytes, item.cleanedName, item.mimeType);
        });
      });

      resultArea.classList.remove('hidden');
      resultArea.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
    }

    // ZIP一括保存ボタン
    downloadAllZipBtn.addEventListener('click', () => {
      if (processedItems.length === 0) return;
      const zipEntries = processedItems.map((item) => ({
        name: item.cleanedName,
        data: item.cleanedBytes,
      }));
      const zipBytes = createZipArchive(zipEntries);
      triggerDownload(zipBytes, 'zeroleak_exif_cleaned_photos.zip', 'application/zip');
    });

    function triggerDownload(bytes: Uint8Array, filename: string, mimeType: string) {
      const buf = bytes.buffer.slice(bytes.byteOffset, bytes.byteOffset + bytes.byteLength) as ArrayBuffer;
      const blob = new Blob([buf], { type: mimeType });
      const url = URL.createObjectURL(blob);
      const a = document.createElement('a');
      a.href = url;
      a.download = filename;
      document.body.appendChild(a);
      a.click();
      document.body.removeChild(a);
      URL.revokeObjectURL(url);
    }
  </script>
</Layout>
