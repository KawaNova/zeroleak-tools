---
import ToolShell from '../components/ToolShell.astro';

const howToSteps = [
  {
    name: '変更前（原文）と変更後（修正案）の条文を入力',
    text: '左側に自社提示版（または改定前条文）、右側に先方からの修正版（または改定案）を貼り付けるかテキストファイルをドロップします。',
  },
  {
    name: '文字・単語単位のインライン差分（Diff）を即座に確認',
    text: '追加された文言（緑太字）と削除された文言（赤打消し線）が文字単位でハイライトされ、但し書きや条件の改変を一目で見落としなく把握できます。',
  },
  {
    name: '赤入れレポートの確認・印刷/PDF保存',
    text: '差分統計を確認し、ブラウザからワンクリックで印刷・PDF保存して社内法務レビューや弁護士確認資料として活用します。',
  },
];

const faqs = [
  {
    question: '未締結の契約書やNDAを一般的な無料Diffサイトに貼るとどんなリスクがありますか？',
    answer: '一般的な無料Web Diffツールは、入力されたテキストを運営会社のWebサーバーへ送信して差分を算出しています。未公開の事業提携内容、損害賠償上限、違約金、取引金額などが第三者サーバーのログやキャッシュに平文で記録されるため、秘密保持契約（NDA）の義務違反や情報漏洩インシデントに直結します。',
  },
  {
    question: 'ZeroLeak Toolsの契約書Diff比較はなぜ外部送信されないのですか？',
    answer: '本ツールはMyers Diffアルゴリズムを純粋なTypeScript/JavaScriptでブラウザ内に実装しており、すべての差分計算がお使いのPC/スマホのブラウザ内部（メモリ上）だけで完結します。F12の開発者ツール Networkタブをご確認いただければ、通信が1バイトも発生しない（外部送信なし）ことをいつでも検証可能です。',
  },
  {
    question: '句読点や短い但し書きの変更も検出できますか？',
    answer: 'はい。行単位の大まかな比較だけでなく、変更があった行の内部を1文字単位・単語単位で精密にインライン比較（Char/Word Diff）します。「〜を除く」「ただし〜とする」といった契約書の法的効果を左右する微細な加筆・削除も見落としません。',
  },
  {
    question: '比較した差分結果をPDFや紙で印刷して法務・弁護士に見せられますか？',
    answer: 'はい。「🖨️ 赤入れレポート印刷・PDF保存」ボタンを押すことで、不要な入力フォームやUIを除去し、変更前後の対比と赤入れハイライトのみを綺麗にレイアウトした印刷用スタイルでPDF保存・印刷が可能です。',
  },
];
---

<ToolShell
  slug="contract-diff"
  title="契約書・NDA 新旧条文Diff差分比較＆赤入れ | ブラウザ完結・サーバー送信なし"
  description="未締結契約書やNDAの変更点をブラウザ内で文字単位で精密比較。外部サーバー送信0バイトで秘密保持義務を完全防衛。赤入れPDF・印刷・差分抽出対応。"
  canonicalPath="/contract-diff/"
  h1="契約書・NDA 新旧条文Diff比較"
  subtitle="未締結NDA・契約書の新旧差分をブラウザ内で文字単位比較・赤入れ印刷（サーバー送信なし）。"
  mascotName="tool-diff"
  mascotFallback="⚖️"
  howToSteps={howToSteps}
  faqs={faqs}
>
  <!-- テスト用サンプル投入ボタン -->
  <div slot="sample-button" class="flex flex-wrap items-center gap-1.5 sm:gap-2">
    <button
      id="loadSampleNdaBtn"
      type="button"
      class="inline-flex items-center gap-1.5 px-3 py-1.5 min-h-[38px] rounded-xl bg-slate-100 hover:bg-slate-200 text-slate-900 border border-slate-300 text-xs font-bold transition shadow-sm cursor-pointer shrink-0"
    >
      <span aria-hidden="true">🧪</span>
      <span>サンプルNDA条文で試す</span>
    </button>
    <button
      id="swapDiffBtn"
      type="button"
      class="inline-flex items-center gap-1 px-2.5 py-1.5 min-h-[38px] rounded-xl bg-white hover:bg-slate-50 text-slate-800 border border-slate-300 text-xs font-semibold transition cursor-pointer shrink-0"
    >
      <span aria-hidden="true">⇄</span>
      <span>左右入替</span>
    </button>
    <button
      id="clearAllBtn"
      type="button"
      class="inline-flex items-center gap-1 px-2.5 py-1.5 min-h-[38px] rounded-xl bg-slate-100 hover:bg-slate-200 text-slate-800 text-xs font-semibold transition cursor-pointer shrink-0"
    >
      <span aria-hidden="true">🗑️</span>
      <span>クリア</span>
    </button>
  </div>

  <div class="space-y-5">
    <!-- インライン通知バナー -->
    <div id="diffNoticeBanner" hidden role="status" class="p-3 rounded-xl border text-xs font-semibold"></div>

    <!-- メイン作業エリア：左右2ペイン入力（ファーストビュー最上部に配置） -->
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-4">
      <!-- 左ペイン：変更前（原文 / 自社提示版） -->
      <div class="bg-white rounded-2xl border border-slate-200 shadow-sm p-3.5 sm:p-4 flex flex-col space-y-2.5">
        <div class="flex items-center justify-between gap-2">
          <label for="originalText" class="text-xs sm:text-sm font-bold text-slate-900 flex items-center gap-1.5">
            <span class="w-2.5 h-2.5 rounded-full bg-rose-600 inline-block shrink-0" aria-hidden="true"></span>
            <span>変更前（原文 / 自社提示版）</span>
          </label>
          <label class="text-xs font-semibold text-slate-800 hover:text-slate-950 cursor-pointer inline-flex items-center gap-1 bg-slate-100 hover:bg-slate-200 px-2.5 py-1.5 rounded-lg border border-slate-300 shrink-0">
            <span aria-hidden="true">📁</span>
            <span>ファイル読込</span>
            <input type="file" id="originalFileInput" accept=".txt,.md,.json" class="hidden" />
          </label>
        </div>
        <textarea
          id="originalText"
          rows="8"
          placeholder="変更前の契約条文を貼り付けるか、テキストファイルをドロップ／読み込みしてください..."
          class="w-full text-xs sm:text-sm font-mono text-slate-900 bg-slate-50/50 border border-slate-300 rounded-xl p-3 focus:outline-none focus:ring-2 focus:ring-slate-700 focus:border-slate-700 focus:bg-white resize-y transition"
        ></textarea>
        <div class="flex justify-between items-center text-xs text-slate-600">
          <span id="originalCharCount">0 文字 / 0 行</span>
          <span>ドラッグ＆ドロップ対応</span>
        </div>
      </div>

      <!-- 右ペイン：変更後（修正版 / 先方修正版） -->
      <div class="bg-white rounded-2xl border border-slate-200 shadow-sm p-3.5 sm:p-4 flex flex-col space-y-2.5">
        <div class="flex items-center justify-between gap-2">
          <label for="modifiedText" class="text-xs sm:text-sm font-bold text-slate-900 flex items-center gap-1.5">
            <span class="w-2.5 h-2.5 rounded-full bg-emerald-600 inline-block shrink-0" aria-hidden="true"></span>
            <span>変更後（修正版 / 先方修正案）</span>
          </label>
          <label class="text-xs font-semibold text-slate-800 hover:text-slate-950 cursor-pointer inline-flex items-center gap-1 bg-slate-100 hover:bg-slate-200 px-2.5 py-1.5 rounded-lg border border-slate-300 shrink-0">
            <span aria-hidden="true">📁</span>
            <span>ファイル読込</span>
            <input type="file" id="modifiedFileInput" accept=".txt,.md,.json" class="hidden" />
          </label>
        </div>
        <textarea
          id="modifiedText"
          rows="8"
          placeholder="先方から戻ってきた修正案や改定条文を貼り付けてください..."
          class="w-full text-xs sm:text-sm font-mono text-slate-900 bg-slate-50/50 border border-slate-300 rounded-xl p-3 focus:outline-none focus:ring-2 focus:ring-slate-700 focus:border-slate-700 focus:bg-white resize-y transition"
        ></textarea>
        <div class="flex justify-between items-center text-xs text-slate-600">
          <span id="modifiedCharCount">0 文字 / 0 行</span>
          <span>ドラッグ＆ドロップ対応</span>
        </div>
      </div>
    </div>

    <!-- 差分比較結果エリア -->
    <div id="diffResultSection" class="bg-white rounded-2xl border border-slate-200 shadow-sm p-4 sm:p-5 space-y-4">
      <!-- 結果ヘッダー ＆ 統計サマリー -->
      <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 pb-3 border-b border-slate-200">
        <div>
          <h2 class="text-base sm:text-lg font-bold text-slate-900 flex flex-wrap items-center gap-2">
            <span>📊 差分解析・赤入れプレビュー</span>
            <span id="diffStatusBadge" class="text-xs font-semibold px-2.5 py-0.5 rounded-full bg-slate-100 text-slate-700">
              未入力
            </span>
          </h2>
          <div id="diffStats" class="flex flex-wrap items-center gap-2 text-xs font-medium text-slate-700 mt-1">
            <span>条文を入力するとブラウザ内でリアルタイム差分比較を実行します</span>
          </div>
        </div>

        <!-- 印刷・PDF保存 / コピー / 差分のみ表示 -->
        <div class="flex flex-wrap items-center gap-2">
          <label class="inline-flex items-center gap-1.5 px-3 py-2 min-h-[40px] rounded-xl bg-slate-50 border border-slate-300 text-xs font-semibold text-slate-800 cursor-pointer select-none">
            <input type="checkbox" id="diffOnlyToggle" class="rounded text-slate-800 focus:ring-slate-700" />
            <span>差分のみ表示</span>
          </label>
          <button
            id="printReportBtn"
            type="button"
            class="inline-flex items-center gap-1.5 px-3.5 py-2 min-h-[40px] rounded-xl bg-slate-900 hover:bg-slate-800 text-white text-xs font-bold transition shadow-sm cursor-pointer"
          >
            <span aria-hidden="true">🖨️</span>
            <span>赤入れレポート印刷・PDF保存</span>
          </button>
          <button
            id="copyDiffBtn"
            type="button"
            class="inline-flex items-center gap-1.5 px-3.5 py-2 min-h-[40px] rounded-xl bg-slate-100 hover:bg-slate-200 text-slate-800 border border-slate-300 text-xs font-semibold transition cursor-pointer"
          >
            <span aria-hidden="true">📋</span>
            <span>差分要約をコピー</span>
          </button>
        </div>
      </div>

      <!-- 凡例 -->
      <div class="flex flex-wrap items-center gap-3 sm:gap-4 text-xs font-medium text-slate-700 bg-slate-50 p-2.5 rounded-lg border border-slate-200">
        <span class="font-bold text-slate-900">凡例:</span>
        <span class="inline-flex items-center gap-1 text-rose-800">
          <span class="w-3 h-3 rounded bg-rose-100 border border-rose-300 inline-block"></span>
          <span>赤打消し = 削除された文言</span>
        </span>
        <span class="inline-flex items-center gap-1 text-emerald-800">
          <span class="w-3 h-3 rounded bg-emerald-100 border border-emerald-300 inline-block"></span>
          <span>緑太字 = 追加された文言</span>
        </span>
        <span class="inline-flex items-center gap-1 text-slate-700">
          <span class="w-3 h-3 rounded bg-white border border-slate-300 inline-block"></span>
          <span>白背景 = 変更なし</span>
        </span>
      </div>

      <!-- 差分テーブルコンテナ -->
      <div id="diffOutputContainer" class="diff-print-target overflow-x-auto rounded-xl border border-slate-200 font-mono text-xs sm:text-sm bg-slate-50/30">
        <div class="p-6 sm:p-8 text-center text-slate-700 space-y-1">
          <p class="text-sm font-bold">上の左右テキストエリアに契約条文を入力してください</p>
          <p class="text-xs text-slate-600">「🧪 サンプルNDA条文で試す」ボタンで今すぐ動作をご確認いただけます</p>
        </div>
      </div>

      <!-- ゼロリークくん完了メッセージ -->
      <div class="flex items-center gap-2 p-3 rounded-xl bg-slate-100 border border-slate-300 text-xs text-slate-900 font-medium">
        <span class="text-base select-none shrink-0" aria-hidden="true">🛡️</span>
        <span><strong>ゼロリークくん：</strong>条文の差分計算はブラウザ内だけで完結しました。未締結の機密条項が外部へ送られることはありません。</span>
      </div>

      <!-- ダウンロード・提出前アラート ＆ 法務確認免責事項 -->
      <div class="bg-slate-50 border border-slate-200 rounded-xl p-3.5 text-xs text-slate-700 flex items-start gap-2.5 leading-relaxed">
        <span class="text-sm shrink-0" aria-hidden="true">⚠️</span>
        <div class="space-y-1">
          <div class="font-bold text-slate-900">外部送信なし保証 ＆ 法務確認免責事項</div>
          <p>
            本ツールは文字一致による客観的差分抽出をブラウザ内メモリのみで実行します。契約書の重要語句（善管注意義務、違約金、損害賠償上限、準拠法、専属管轄等）の法的有効性やニュアンスについては、<strong>必ず弁護士・自社法務部門による目視確認・承認</strong>を経てからご締結ください。
          </p>
        </div>
      </div>
    </div>
  </div>
</ToolShell>

<style is:global>
  @media print {
    body:not(.printing-security-spec) * {
      visibility: hidden;
    }
    body:not(.printing-security-spec) .diff-print-target,
    body:not(.printing-security-spec) .diff-print-target * {
      visibility: visible;
    }
    body:not(.printing-security-spec) .diff-print-target {
      position: absolute;
      left: 0;
      top: 0;
      width: 100%;
      border: none !important;
      background: white !important;
      padding: 0 !important;
    }
    body:not(.printing-security-spec) nav,
    body:not(.printing-security-spec) footer,
    body:not(.printing-security-spec) button,
    body:not(.printing-security-spec) .no-print {
      display: none !important;
    }
  }
</style>

<script>
  import { computeDiff, generateSampleContracts, formatDiffSummary } from '../utils/contract-diff';

  const originalTextArea = document.getElementById('originalText') as HTMLTextAreaElement;
  const modifiedTextArea = document.getElementById('modifiedText') as HTMLTextAreaElement;
  const originalCharCount = document.getElementById('originalCharCount') as HTMLElement;
  const modifiedCharCount = document.getElementById('modifiedCharCount') as HTMLElement;
  const diffOutputContainer = document.getElementById('diffOutputContainer') as HTMLElement;
  const diffStats = document.getElementById('diffStats') as HTMLElement;
  const diffStatusBadge = document.getElementById('diffStatusBadge') as HTMLElement;
  const loadSampleNdaBtn = document.getElementById('loadSampleNdaBtn') as HTMLButtonElement;
  const swapDiffBtn = document.getElementById('swapDiffBtn') as HTMLButtonElement;
  const clearAllBtn = document.getElementById('clearAllBtn') as HTMLButtonElement;
  const diffOnlyToggle = document.getElementById('diffOnlyToggle') as HTMLInputElement;
  const printReportBtn = document.getElementById('printReportBtn') as HTMLButtonElement;
  const copyDiffBtn = document.getElementById('copyDiffBtn') as HTMLButtonElement;
  const originalFileInput = document.getElementById('originalFileInput') as HTMLInputElement;
  const modifiedFileInput = document.getElementById('modifiedFileInput') as HTMLInputElement;
  const noticeBanner = document.getElementById('diffNoticeBanner') as HTMLDivElement;

  let currentDiffResult: ReturnType<typeof computeDiff> | null = null;

  function showNotice(msg: string) {
    noticeBanner.className = 'p-3 rounded-xl border text-xs font-semibold bg-rose-50 border-rose-200 text-rose-900';
    noticeBanner.textContent = msg;
    noticeBanner.hidden = false;
  }

  function hideNotice() {
    noticeBanner.hidden = true;
  }

  function updateCounts() {
    const origText = originalTextArea.value;
    const modText = modifiedTextArea.value;

    const origLines = origText ? origText.split('\n').length : 0;
    const modLines = modText ? modText.split('\n').length : 0;

    originalCharCount.textContent = `${origText.length.toLocaleString()} 文字 / ${origLines.toLocaleString()} 行`;
    modifiedCharCount.textContent = `${modText.length.toLocaleString()} 文字 / ${modLines.toLocaleString()} 行`;
  }

  function renderDiff() {
    updateCounts();
    hideNotice();
    const origText = originalTextArea.value;
    const modText = modifiedTextArea.value;

    if (!origText && !modText) {
      diffOutputContainer.innerHTML = `
        <div class="p-6 sm:p-8 text-center text-slate-700 space-y-1">
          <p class="text-sm font-bold">上の左右テキストエリアに契約条文を入力してください</p>
          <p class="text-xs text-slate-600">「🧪 サンプルNDA条文で試す」ボタンで今すぐ動作をご確認いただけます</p>
        </div>
      `;
      diffStatusBadge.className = 'text-xs font-semibold px-2.5 py-0.5 rounded-full bg-slate-100 text-slate-700';
      diffStatusBadge.textContent = '未入力';
      diffStats.innerHTML = '<span>条文を入力するとブラウザ内でリアルタイム差分比較を実行します</span>';
      currentDiffResult = null;
      return;
    }

    const diff = computeDiff(origText, modText);
    currentDiffResult = diff;

    if (diff.stats.changedLines === 0 && diff.stats.addedLines === 0 && diff.stats.deletedLines === 0) {
      diffStatusBadge.className = 'text-xs font-semibold px-2.5 py-0.5 rounded-full bg-emerald-100 text-emerald-900';
      diffStatusBadge.textContent = '完全一致（差分なし）';
    } else {
      diffStatusBadge.className = 'text-xs font-semibold px-2.5 py-0.5 rounded-full bg-blue-50 text-blue-900 border border-blue-200';
      diffStatusBadge.textContent = `差分あり（${diff.stats.changedLines + diff.stats.addedLines + diff.stats.deletedLines}箇所）`;
    }

    diffStats.innerHTML = `
      <span class="inline-flex items-center gap-1 text-slate-800 font-bold">全 ${diff.stats.totalLines} 行</span>
      <span class="text-slate-400">|</span>
      <span class="inline-flex items-center gap-1 text-rose-800 bg-rose-50 px-1.5 py-0.5 rounded border border-rose-200">
        ➖ 削除 ${diff.stats.deletedLines} 行 (${diff.stats.deletedChars} 文字)
      </span>
      <span class="inline-flex items-center gap-1 text-emerald-800 bg-emerald-50 px-1.5 py-0.5 rounded border border-emerald-200">
        ➕ 追加 ${diff.stats.addedLines} 行 (${diff.stats.addedChars} 文字)
      </span>
      <span class="inline-flex items-center gap-1 text-blue-900 bg-blue-50 px-1.5 py-0.5 rounded border border-blue-200">
        ✏️ 変更 ${diff.stats.changedLines} 行
      </span>
    `;

    const onlyDiffs = diffOnlyToggle.checked;
    const rowsToRender = onlyDiffs ? diff.lines.filter((l) => l.type !== 'equal') : diff.lines;

    if (onlyDiffs && rowsToRender.length === 0) {
      diffOutputContainer.innerHTML = `
        <div class="p-6 text-center text-emerald-900 bg-emerald-50/50 text-xs sm:text-sm font-bold">
          ✔ 変更箇所はありません（左右の条文は完全に一致しています）
        </div>
      `;
      return;
    }

    let tableHtml = `
      <table class="w-full border-collapse">
        <thead>
          <tr class="bg-slate-100 text-slate-800 text-left text-xs font-bold border-b border-slate-200 select-none">
            <th class="py-1.5 px-2 w-12 text-center border-r border-slate-200">旧行</th>
            <th class="py-1.5 px-2 w-12 text-center border-r border-slate-200">新行</th>
            <th class="py-1.5 px-2 w-10 text-center border-r border-slate-200">区分</th>
            <th class="py-1.5 px-3">条文内容（インライン赤入れハイライト）</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-slate-200">
    `;

    for (const line of rowsToRender) {
      let rowBg = 'bg-white';
      let tagBg = 'text-slate-600';
      let tagSymbol = ' ';
      let contentHtml = '';

      if (line.type === 'delete') {
        rowBg = 'bg-rose-50/70 hover:bg-rose-50';
        tagBg = 'text-rose-800 font-bold';
        tagSymbol = '-';
        contentHtml = `<span class="line-through text-rose-900 bg-rose-100/80 px-1 rounded">${escapeHtml(line.text)}</span>`;
      } else if (line.type === 'add') {
        rowBg = 'bg-emerald-50/70 hover:bg-emerald-50';
        tagBg = 'text-emerald-800 font-bold';
        tagSymbol = '+';
        contentHtml = `<span class="font-bold text-emerald-950 bg-emerald-100/90 px-1 rounded">${escapeHtml(line.text)}</span>`;
      } else if (line.type === 'change') {
        rowBg = 'bg-blue-50/50 hover:bg-blue-50/80';
        tagBg = 'text-blue-800 font-bold';
        tagSymbol = '•';

        contentHtml = (line.inlineChunks || [])
          .map((chunk) => {
            if (chunk.type === 'delete') {
              return `<span class="line-through text-rose-900 bg-rose-200/90 font-bold px-0.5 rounded">${escapeHtml(chunk.text)}</span>`;
            } else if (chunk.type === 'add') {
              return `<span class="text-emerald-950 bg-emerald-200/90 font-bold px-0.5 rounded underline decoration-emerald-700 decoration-2">${escapeHtml(chunk.text)}</span>`;
            }
            return `<span class="text-slate-800">${escapeHtml(chunk.text)}</span>`;
          })
          .join('');
      } else {
        tagSymbol = ' ';
        contentHtml = `<span class="text-slate-800">${escapeHtml(line.text)}</span>`;
      }

      tableHtml += `
        <tr class="${rowBg} transition-colors">
          <td class="py-1.5 px-2 text-center text-slate-600 text-xs select-none border-r border-slate-200/70">${line.origLineNum ?? ''}</td>
          <td class="py-1.5 px-2 text-center text-slate-600 text-xs select-none border-r border-slate-200/70">${line.modLineNum ?? ''}</td>
          <td class="py-1.5 px-1 text-center ${tagBg} select-none border-r border-slate-200/70">${tagSymbol}</td>
          <td class="py-1.5 px-3 whitespace-pre-wrap break-all leading-relaxed">${contentHtml}</td>
        </tr>
      `;
    }

    tableHtml += `</tbody></table>`;
    diffOutputContainer.innerHTML = tableHtml;
  }

  function escapeHtml(str: string): string {
    return str
      .replace(/&/g, '&amp;')
      .replace(/</g, '&lt;')
      .replace(/>/g, '&gt;')
      .replace(/"/g, '&quot;')
      .replace(/'/g, '&#039;');
  }

  originalTextArea.addEventListener('input', renderDiff);
  modifiedTextArea.addEventListener('input', renderDiff);
  diffOnlyToggle.addEventListener('change', renderDiff);

  loadSampleNdaBtn.addEventListener('click', () => {
    const sample = generateSampleContracts();
    originalTextArea.value = sample.original;
    modifiedTextArea.value = sample.modified;
    renderDiff();
  });

  swapDiffBtn.addEventListener('click', () => {
    const tmp = originalTextArea.value;
    originalTextArea.value = modifiedTextArea.value;
    modifiedTextArea.value = tmp;
    renderDiff();
  });

  clearAllBtn.addEventListener('click', () => {
    originalTextArea.value = '';
    modifiedTextArea.value = '';
    renderDiff();
  });

  printReportBtn.addEventListener('click', () => {
    if (!currentDiffResult) {
      showNotice('⚠️ 比較する条文を入力（またはサンプルNDAを投入）してから印刷・PDF保存してください。');
      return;
    }
    window.print();
  });

  copyDiffBtn.addEventListener('click', () => {
    if (!currentDiffResult) {
      showNotice('⚠️ 比較する条文を入力してから差分要約をコピーしてください。');
      return;
    }
    const summary = formatDiffSummary(currentDiffResult);
    navigator.clipboard.writeText(summary).then(() => {
      const origHtml = copyDiffBtn.innerHTML;
      copyDiffBtn.innerHTML = '<span>✔</span><span>コピーしました!</span>';
      setTimeout(() => {
        copyDiffBtn.innerHTML = origHtml;
      }, 2000);
    });
  });

  function handleFileRead(file: File, targetTextArea: HTMLTextAreaElement) {
    const reader = new FileReader();
    reader.onload = (e) => {
      targetTextArea.value = (e.target?.result as string) || '';
      renderDiff();
    };
    reader.readAsText(file);
  }

  originalFileInput.addEventListener('change', (e) => {
    const file = (e.target as HTMLInputElement).files?.[0];
    if (file) handleFileRead(file, originalTextArea);
  });

  modifiedFileInput.addEventListener('change', (e) => {
    const file = (e.target as HTMLInputElement).files?.[0];
    if (file) handleFileRead(file, modifiedTextArea);
  });

  [originalTextArea, modifiedTextArea].forEach((textarea) => {
    textarea.addEventListener('dragover', (e) => {
      e.preventDefault();
      textarea.classList.add('border-slate-700', 'bg-slate-100/60');
    });
    textarea.addEventListener('dragleave', () => {
      textarea.classList.remove('border-slate-700', 'bg-slate-100/60');
    });
    textarea.addEventListener('drop', (e) => {
      e.preventDefault();
      textarea.classList.remove('border-slate-700', 'bg-slate-100/60');
      const file = e.dataTransfer?.files[0];
      if (file) handleFileRead(file, textarea);
    });
  });
</script>
