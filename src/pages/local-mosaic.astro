---
import ToolShell from '../components/ToolShell.astro';
import RedactionDemo from '../components/RedactionDemo.astro';

const howToSteps = [
  {
    name: '画像・スクリーンショットをドラッグ＆ドロップ（複数枚対応）',
    text: 'モザイクや黒塗りをかけたい写真・画面キャプチャ（JPEG/PNG/WebP）をまとめてドロップまたはCtrl+Vで貼り付けます。',
  },
  {
    name: 'マウスまたは指で隠したい箇所をドラッグ指定',
    text: '「モザイク」「すりガラスぼかし」「完全黒塗り」「白抜き」から効果を選び、顔やナンバープレート、顧客名、URLバーをドラッグで囲みます。同じ座標を全画像へ一括適用することも可能です。',
  },
  {
    name: 'ZIPで一括ダウンロードまたは個別保存',
    text: 'ピクセル自体が不可逆に書き換えられ（EXIF位置情報も同時消去）、復元不可能な安全な画像として保存します。',
  },
];

const faqs = [
  {
    question: '社内管理画面のキャプチャや未公開製品の写真を無料モザイクサイトにアップロードするのは危険ですか？',
    answer: '非常に危険です。一般的なオンライン画像編集ツールは、モザイクをかける前の『無加工の機密スクリーンショットや顔写真』を一度外部サーバーへアップロードします。ZeroLeak Toolsはサーバー送信なし（0バイト）で、お使いのPC・スマホのブラウザ内メモリ（HTML5 Canvas）だけで処理するため、社外秘画像が外部へ漏洩するリスクは0%です。',
  },
  {
    question: '加工後の画像からモザイクや黒塗りを復元（逆算）されることはありませんか？',
    answer: 'ありません。PDFの注釈レイヤーのような『上に重ねただけのマスク』ではなく、Canvasの画素（RGBピクセル配列）そのものを破壊的に平均化・塗りつぶして再エンコードするため、元の文字や顔を復元することは原理的に不可能です。特に機密性の高いマイナンバーやAPIキーには『完全黒塗り』を推奨します。',
  },
  {
    question: '同じレイアウトの画面キャプチャ10枚〜50枚の同じ位置（URLバーや顧客名欄）に一括でモザイクをかけられますか？',
    answer: 'はい。『現在のマスク領域を全画像に一括コピー』ボタンを押すだけで、1枚目で指定したモザイク・黒塗り座標（比率）を、読み込んだすべての画像へ一瞬で一括適用し、まとめてZIPファイルとしてダウンロードできます。',
  },
  {
    question: 'モザイク加工と同時に写真のEXIF（GPS位置情報）も消えますか？',
    answer: 'はい。Canvasでピクセルを再出力する過程で、元の画像に含まれていたEXIF・GPS位置情報・カメラ機種名などのメタデータはすべて自動的に除去されます。',
  },
];
---

<ToolShell
  slug="local-mosaic"
  title="画像・写真のモザイク＆黒塗り一括加工 | ブラウザ完結・サーバー送信なし"
  description="社外秘の画面キャプチャ、顧客名、顔写真、車のナンバープレートをブラウザ内で一括モザイク・黒塗り加工。サーバー送信なし・複数枚一括適用＆ZIP保存に対応。"
  canonicalPath="/local-mosaic/"
  h1="画像 顔・スクショ モザイク＆黒塗り"
  subtitle="スクショや顔・ナンバーを不可逆ピクセル破壊。Ctrl+V貼付・複数画像への一括適用＆ZIP保存（サーバー送信なし）。"
  mascotName="tool-mosaic"
  mascotFallback="🕶️"
  whyTitle="「黒く塗ったから安全」では、コピペで剥がれる"
  howToSteps={howToSteps}
  faqs={faqs}
>
  <!-- ワンクリック検証用サンプルボタン -->
  <div slot="sample-button" class="flex flex-wrap items-center gap-2">
    <button
      id="loadSampleMosaicBtn"
      type="button"
      class="inline-flex items-center gap-1.5 px-3 py-1.5 min-h-[38px] rounded-xl bg-cyan-50 hover:bg-cyan-100 text-cyan-950 border border-cyan-300 text-xs font-bold transition shadow-sm cursor-pointer shrink-0"
    >
      <span aria-hidden="true">🧪</span>
      <span>模擬キャプチャ2枚で試す</span>
    </button>
  </div>

  <div class="space-y-6">
    <!-- メイン操作パネル -->
    <div class="bg-white border border-slate-200 rounded-2xl p-4 sm:p-6 shadow-sm space-y-5">
      <!-- ファイルドロップゾーン -->
      <div
        id="dropZoneMosaic"
        class="border-2 border-dashed border-slate-300 hover:border-cyan-600 rounded-2xl p-5 sm:p-7 text-center transition bg-slate-50/70 hover:bg-cyan-50/30 cursor-pointer group"
      >
        <input
          type="file"
          id="fileInputMosaic"
          multiple
          accept="image/jpeg,image/png,image/webp"
          class="hidden"
        />
        <div class="flex flex-col items-center gap-2 pointer-events-none">
          <div class="w-12 h-12 rounded-xl bg-cyan-50 border border-cyan-200 text-cyan-700 flex items-center justify-center group-hover:scale-105 transition-transform shadow-sm text-xl font-bold">
            🕶️
          </div>
          <div>
            <p class="font-bold text-slate-900 text-sm sm:text-base">
              モザイク・黒塗りしたい画像をドロップ
            </p>
            <p class="text-xs text-slate-600 mt-0.5">
              またはクリックして選択 • 複数枚まとめて選択・Ctrl+V貼り付け対応
            </p>
          </div>
          <div class="flex flex-wrap items-center justify-center gap-2 pt-1">
            <span class="inline-flex items-center gap-1 px-2.5 py-0.5 rounded-full bg-white border border-slate-200 text-[11px] text-slate-800 shadow-sm font-semibold">
              🔒 サーバー送信0バイト保証
            </span>
            <span class="inline-flex items-center gap-1 px-2.5 py-0.5 rounded-full bg-white border border-slate-200 text-[11px] text-emerald-800 shadow-sm font-bold">
              🚫 EXIF位置情報も自動消去
            </span>
          </div>
        </div>
      </div>

      <!-- インライン通知バナー -->
      <div id="mosaicNoticeBanner" hidden role="status" class="p-3 rounded-xl border text-xs font-semibold"></div>

      <!-- 作業ワークスペース（画像読み込み後に表示） -->
      <div id="mosaicWorkspace" class="hidden space-y-5">
        <!-- ツールバー：モード切替 ＆ 強度スライダー ＆ 一括適用 -->
        <div class="p-4 rounded-xl bg-slate-900 text-white space-y-4 shadow-sm">
          <div class="flex flex-wrap items-center justify-between gap-3 text-xs">
            <!-- 加工モード選択 -->
            <div class="flex flex-wrap items-center gap-1.5">
              <span class="text-slate-300 font-semibold mr-1">加工タイプ:</span>
              <button
                type="button"
                data-effect="pixelate"
                class="effect-mode-btn px-3 py-2 min-h-[38px] rounded-lg font-bold border transition cursor-pointer bg-emerald-500/20 text-emerald-300 border-emerald-500/50"
              >
                ⬛ モザイク
              </button>
              <button
                type="button"
                data-effect="blur"
                class="effect-mode-btn px-3 py-2 min-h-[38px] rounded-lg font-bold border transition cursor-pointer bg-slate-800 text-slate-200 border-slate-700 hover:border-slate-500"
              >
                💧 ぼかし
              </button>
              <button
                type="button"
                data-effect="blackout"
                class="effect-mode-btn px-3 py-2 min-h-[38px] rounded-lg font-bold border transition cursor-pointer bg-slate-800 text-slate-200 border-slate-700 hover:border-slate-500"
              >
                ■ 完全黒塗り
              </button>
              <button
                type="button"
                data-effect="whiteout"
                class="effect-mode-btn px-3 py-2 min-h-[38px] rounded-lg font-bold border transition cursor-pointer bg-slate-800 text-slate-200 border-slate-700 hover:border-slate-500"
              >
                □ 白塗り
              </button>
            </div>

            <!-- 操作取り消し ＆ 全クリア -->
            <div class="flex items-center gap-2">
              <button
                type="button"
                id="undoRegionBtn"
                class="px-3 py-2 min-h-[38px] rounded-lg bg-slate-800 hover:bg-slate-700 text-slate-100 border border-slate-700 transition cursor-pointer font-semibold"
              >
                ↩ 直前を取り消す
              </button>
              <button
                type="button"
                id="clearRegionsBtn"
                class="px-3 py-2 min-h-[38px] rounded-lg bg-slate-800 hover:bg-rose-950 text-rose-200 border border-slate-700 transition cursor-pointer font-semibold"
              >
                🗑️ この画像の枠を全消去
              </button>
            </div>
          </div>

          <!-- 強度スライダー -->
          <div class="pt-2 border-t border-slate-700 flex flex-wrap items-center gap-3 text-xs">
            <span class="text-slate-200 font-semibold shrink-0">モザイク・ぼかし強度:</span>
            <input
              type="range"
              id="strengthSlider"
              min="6"
              max="40"
              value="18"
              class="w-40 sm:w-64 accent-cyan-400 cursor-pointer"
            />
            <span id="strengthValLabel" class="font-mono text-emerald-300 font-bold">18</span>
            <span class="text-slate-300 text-xs hidden sm:inline">（数字が大きいほど強く隠れます）</span>
          </div>

          <!-- 複数画像一括同期ボタン -->
          <div class="pt-3 border-t border-slate-700 flex flex-col sm:flex-row sm:items-center justify-between gap-3 text-xs">
            <div class="flex items-center gap-2 text-slate-200 flex-wrap">
              <span class="px-2 py-0.5 rounded bg-cyan-500/20 text-cyan-200 border border-cyan-400/40 font-bold text-[11px]">
                一括機能
              </span>
              <span id="activeRegionCountText" class="text-slate-200">
                現在の画像に 0 箇所のマスク領域が設定されています
              </span>
            </div>

            <button
              type="button"
              id="applyRegionsToAllBtn"
              class="px-4 py-2 min-h-[40px] rounded-lg bg-cyan-600 hover:bg-cyan-500 text-white border border-cyan-500 font-bold transition flex items-center justify-center gap-1.5 cursor-pointer shadow-sm shrink-0"
            >
              <span aria-hidden="true">📐</span>
              <span>現在のマスク位置を全画像に一括コピー適用</span>
            </button>
          </div>
        </div>

        <!-- 画像切り替えサムネイル＆キャンバス領域 -->
        <div class="grid grid-cols-1 lg:grid-cols-4 gap-5">
          <!-- 左：読み込み済み画像リスト -->
          <div class="lg:col-span-1 space-y-2">
            <div class="flex items-center justify-between text-xs text-slate-700 px-1">
              <span class="font-bold text-slate-900">📂 画像一覧 (<span id="imageTotalCount">0</span>枚)</span>
              <button
                type="button"
                id="addMoreFilesBtn"
                class="text-cyan-700 hover:underline font-bold cursor-pointer min-h-[36px]"
              >
                + 画像追加
              </button>
            </div>
            <div
              id="mosaicImageList"
              class="space-y-2 max-h-[460px] overflow-y-auto pr-1"
            >
              <!-- JSで画像切り替えカードを描画 -->
            </div>
          </div>

          <!-- 右：インタラクティブCanvasエディタ -->
          <div class="lg:col-span-3 space-y-3">
            <div class="flex flex-wrap items-center justify-between gap-2 text-xs text-slate-700 bg-slate-50 px-3.5 py-2 rounded-lg border border-slate-200">
              <span>
                💡 <strong>操作方法：</strong> キャンバス上をマウス（または指）でドラッグすると、その矩形範囲に即座にモザイク・黒塗りが適用されます。
              </span>
              <span id="canvasDimensionLabel" class="font-mono text-slate-700">800 × 500 px</span>
            </div>

            <div class="relative rounded-2xl bg-slate-100 border border-slate-200 p-3 flex items-center justify-center overflow-auto min-h-[300px] sm:min-h-[340px] max-h-[600px]">
              <canvas
                id="mosaicEditorCanvas"
                class="max-w-full h-auto rounded-lg shadow-md cursor-crosshair select-none touch-none border border-slate-300 bg-white"
              ></canvas>
            </div>
          </div>
        </div>

        <!-- 保存＆一括ZIP出力フッターバー -->
        <div class="p-4 sm:p-5 rounded-2xl bg-cyan-50/70 border border-cyan-200 flex flex-col sm:flex-row items-center justify-between gap-4">
          <div class="space-y-1 text-center sm:text-left">
            <div class="flex flex-wrap items-center justify-center sm:justify-start gap-2">
              <span class="px-2.5 py-0.5 rounded-full bg-emerald-50 text-emerald-800 border border-emerald-200 text-xs font-bold shadow-sm">
                🛡️ 不可逆ピクセル書き換え ＆ EXIF自動消去済
              </span>
              <span id="mosaicProcessStatus" class="text-xs font-mono text-slate-700">
                外部通信 0 バイト
              </span>
            </div>
            <p class="text-xs text-slate-700">
              出力画像はレイヤーを持たない1枚の画像として再生成されるため、後からモザイクを剥がすことは不可能です。
            </p>
          </div>

          <div class="flex flex-wrap items-center gap-2.5 w-full sm:w-auto">
            <button
              type="button"
              id="downloadCurrentMaskedBtn"
              class="flex-1 sm:flex-none px-4 py-3 min-h-[44px] rounded-xl font-bold text-xs sm:text-sm text-cyan-950 bg-white hover:bg-slate-50 border border-slate-300 shadow-sm transition cursor-pointer whitespace-nowrap"
            >
              📥 表示中の1枚を保存
            </button>
            <button
              type="button"
              id="downloadAllMaskedZipBtn"
              class="flex-1 sm:flex-none px-5 py-3 min-h-[44px] rounded-xl font-bold text-xs sm:text-sm text-white bg-cyan-700 hover:bg-cyan-800 transition shadow-sm flex items-center justify-center gap-2 cursor-pointer whitespace-nowrap"
            >
              <span aria-hidden="true">📦</span>
              <span>全画像をZIPで一括保存</span>
            </button>
          </div>
        </div>

        <!-- ゼロリークくん完了メッセージ -->
        <div class="flex items-center gap-2 p-3 rounded-xl bg-cyan-100/70 border border-cyan-200 text-xs text-cyan-950 font-medium">
          <span class="text-base select-none shrink-0" aria-hidden="true">🛡️</span>
          <span><strong>ゼロリークくん：</strong>モザイク・黒塗りの加工が完了しました！ピクセルが不可逆消去され、端末内だけで保存できます。</span>
        </div>
      </div>
    </div>

    <RedactionDemo />
  </div>
</ToolShell>

<script>
  import {
    applyRegionEffect,
    renderMaskedImageBytes,
    generateSampleMosaicImages,
    type MaskEffectType,
    type NormalizedRegion,
  } from '../utils/mosaic';
  import { createZipArchive } from '../utils/exif';

  interface MosaicImageEntry {
    id: string;
    name: string;
    mimeType: string;
    sourceBytes: Uint8Array;
    bitmap: ImageBitmap;
    width: number;
    height: number;
    regions: NormalizedRegion[];
  }

  let entries: MosaicImageEntry[] = [];
  let activeIndex = 0;
  let currentEffect: MaskEffectType = 'pixelate';
  let currentStrength = 18;

  let isDragging = false;
  let dragStartX = 0;
  let dragStartY = 0;
  let dragCurrentX = 0;
  let dragCurrentY = 0;

  const dropZone = document.getElementById('dropZoneMosaic')!;
  const fileInput = document.getElementById('fileInputMosaic') as HTMLInputElement;
  const loadSampleBtn = document.getElementById('loadSampleMosaicBtn')!;
  const noticeBanner = document.getElementById('mosaicNoticeBanner')!;
  const workspace = document.getElementById('mosaicWorkspace')!;
  const strengthSlider = document.getElementById('strengthSlider') as HTMLInputElement;
  const strengthValLabel = document.getElementById('strengthValLabel')!;
  const undoRegionBtn = document.getElementById('undoRegionBtn')!;
  const clearRegionsBtn = document.getElementById('clearRegionsBtn')!;
  const applyRegionsToAllBtn = document.getElementById('applyRegionsToAllBtn')!;
  const activeRegionCountText = document.getElementById('activeRegionCountText')!;
  const imageTotalCount = document.getElementById('imageTotalCount')!;
  const addMoreFilesBtn = document.getElementById('addMoreFilesBtn')!;
  const imageListEl = document.getElementById('mosaicImageList')!;
  const canvas = document.getElementById('mosaicEditorCanvas') as HTMLCanvasElement;
  const ctx = canvas.getContext('2d')!;
  const canvasDimensionLabel = document.getElementById('canvasDimensionLabel')!;
  const mosaicProcessStatus = document.getElementById('mosaicProcessStatus')!;
  const downloadCurrentBtn = document.getElementById('downloadCurrentMaskedBtn')!;
  const downloadAllZipBtn = document.getElementById('downloadAllMaskedZipBtn')!;

  function showNotice(msg: string, isError = false) {
    noticeBanner.className = isError
      ? 'p-3 rounded-xl border text-xs font-semibold bg-rose-50 border-rose-200 text-rose-900'
      : 'p-3 rounded-xl border text-xs font-semibold bg-cyan-50 border-cyan-200 text-cyan-950';
    noticeBanner.textContent = msg;
    noticeBanner.hidden = false;
  }

  function hideNotice() {
    noticeBanner.hidden = true;
  }

  document.querySelectorAll('.effect-mode-btn').forEach((btn) => {
    btn.addEventListener('click', (e) => {
      const target = e.currentTarget as HTMLElement;
      const eff = target.getAttribute('data-effect') as MaskEffectType;
      if (!eff) return;
      currentEffect = eff;

      document.querySelectorAll('.effect-mode-btn').forEach((b) => {
        b.className =
          'effect-mode-btn px-3 py-2 min-h-[38px] rounded-lg font-bold border transition cursor-pointer bg-slate-800 text-slate-200 border-slate-700 hover:border-slate-500';
      });
      target.className =
        'effect-mode-btn px-3 py-2 min-h-[38px] rounded-lg font-bold border transition cursor-pointer bg-emerald-500/20 text-emerald-300 border-emerald-500/50';
    });
  });

  strengthSlider.addEventListener('input', () => {
    currentStrength = Number(strengthSlider.value);
    strengthValLabel.textContent = String(currentStrength);
  });

  dropZone.addEventListener('click', () => fileInput.click());
  addMoreFilesBtn.addEventListener('click', () => fileInput.click());

  dropZone.addEventListener('dragover', (e) => {
    e.preventDefault();
    dropZone.classList.add('border-cyan-600', 'bg-cyan-50/40');
  });
  dropZone.addEventListener('dragleave', () => {
    dropZone.classList.remove('border-cyan-600', 'bg-cyan-50/40');
  });
  dropZone.addEventListener('drop', async (e) => {
    e.preventDefault();
    dropZone.classList.remove('border-cyan-600', 'bg-cyan-50/40');
    if (e.dataTransfer?.files && e.dataTransfer.files.length > 0) {
      await addFiles(Array.from(e.dataTransfer.files));
    }
  });

  fileInput.addEventListener('change', async () => {
    if (fileInput.files && fileInput.files.length > 0) {
      await addFiles(Array.from(fileInput.files));
      fileInput.value = '';
    }
  });

  window.addEventListener('paste', async (e) => {
    const items = e.clipboardData?.items;
    if (!items) return;
    const pastedFiles: File[] = [];
    for (let i = 0; i < items.length; i++) {
      if (items[i].type.startsWith('image/')) {
        const f = items[i].getAsFile();
        if (f) pastedFiles.push(f);
      }
    }
    if (pastedFiles.length > 0) {
      await addFiles(pastedFiles);
    }
  });

  loadSampleBtn.addEventListener('click', async () => {
    hideNotice();
    loadSampleBtn.setAttribute('disabled', 'true');
    try {
      const samples = await generateSampleMosaicImages();
      entries = [];
      for (const s of samples) {
        const buf = s.bytes.buffer.slice(
          s.bytes.byteOffset,
          s.bytes.byteOffset + s.bytes.byteLength
        ) as ArrayBuffer;
        const blob = new Blob([buf], { type: s.mimeType });
        const bitmap = await createImageBitmap(blob);
        entries.push({
          id: Math.random().toString(36).slice(2),
          name: s.name,
          mimeType: s.mimeType,
          sourceBytes: s.bytes,
          bitmap,
          width: bitmap.width,
          height: bitmap.height,
          regions: s.presetRegions.map((r) => ({ ...r })),
        });
      }
      activeIndex = 0;
      workspace.classList.remove('hidden');
      renderSidebarList();
      renderActiveCanvas();
      workspace.scrollIntoView({ behavior: 'smooth', block: 'start' });
    } finally {
      loadSampleBtn.removeAttribute('disabled');
    }
  });

  async function addFiles(files: File[]) {
    hideNotice();
    const valid = files.filter(
      (f) =>
        /\.(jpe?g|png|webp)$/i.test(f.name) ||
        ['image/jpeg', 'image/png', 'image/webp'].includes(f.type)
    );
    if (valid.length === 0) {
      showNotice('❌ JPEG / PNG / WebP 形式の画像ファイルを選択してください。', true);
      return;
    }

    for (const f of valid) {
      const buf = await f.arrayBuffer();
      const bytes = new Uint8Array(buf);
      const mime =
        f.type || (f.name.toLowerCase().endsWith('.png') ? 'image/png' : 'image/jpeg');
      const blob = new Blob([buf], { type: mime });
      const bitmap = await createImageBitmap(blob);
      entries.push({
        id: Math.random().toString(36).slice(2),
        name: f.name || `clipboard_${entries.length + 1}.png`,
        mimeType: mime,
        sourceBytes: bytes,
        bitmap,
        width: bitmap.width,
        height: bitmap.height,
        regions: [],
      });
    }

    activeIndex = entries.length - valid.length;
    workspace.classList.remove('hidden');
    renderSidebarList();
    renderActiveCanvas();
  }

  function escapeHtml(str: string): string {
    return str
      .replace(/&/g, '&amp;')
      .replace(/</g, '&lt;')
      .replace(/>/g, '&gt;')
      .replace(/"/g, '&quot;')
      .replace(/'/g, '&#39;');
  }

  function renderSidebarList() {
    imageTotalCount.textContent = String(entries.length);
    imageListEl.innerHTML = entries
      .map((entry, idx) => {
        const isActive = idx === activeIndex;
        const borderClass = isActive
          ? 'border-cyan-600 bg-cyan-50 text-cyan-950 font-semibold ring-1 ring-cyan-600/30'
          : 'border-slate-200 bg-white text-slate-800 hover:border-slate-300 hover:bg-slate-50';
        return `
          <div
            data-entry-idx="${idx}"
            class="entry-select-card p-3 rounded-xl border transition cursor-pointer flex items-center justify-between gap-2 ${borderClass}"
          >
            <div class="min-w-0">
              <p class="text-xs font-bold truncate">${escapeHtml(entry.name)}</p>
              <p class="text-[11px] text-slate-600 font-mono">
                ${entry.width}×${entry.height} • マスク ${entry.regions.length}箇所
              </p>
            </div>
            <span class="px-2 py-0.5 rounded-full text-[11px] font-bold shrink-0 ${
              entry.regions.length > 0
                ? 'bg-emerald-100 text-emerald-800 border border-emerald-200'
                : 'bg-slate-100 text-slate-700'
            }">
              ${entry.regions.length}枠
            </span>
          </div>
        `;
      })
      .join('');

    document.querySelectorAll('.entry-select-card').forEach((card) => {
      card.addEventListener('click', (e) => {
        const target = e.currentTarget as HTMLElement;
        activeIndex = Number(target.getAttribute('data-entry-idx'));
        renderSidebarList();
        renderActiveCanvas();
      });
    });
  }

  function renderActiveCanvas() {
    const entry = entries[activeIndex];
    if (!entry) return;

    canvas.width = entry.width;
    canvas.height = entry.height;
    canvasDimensionLabel.textContent = `${entry.width} × ${entry.height} px`;
    activeRegionCountText.textContent = `現在の画像（${entry.name}）に ${entry.regions.length} 箇所のマスク領域が設定されています`;

    ctx.clearRect(0, 0, canvas.width, canvas.height);
    ctx.drawImage(entry.bitmap, 0, 0);

    for (const reg of entry.regions) {
      applyRegionEffect(ctx, canvas.width, canvas.height, reg);
    }

    for (const reg of entry.regions) {
      const rx = reg.nx * canvas.width;
      const ry = reg.ny * canvas.height;
      const rw = reg.nw * canvas.width;
      const rh = reg.nh * canvas.height;
      ctx.save();
      ctx.strokeStyle = 'rgba(16, 185, 129, 0.75)';
      ctx.lineWidth = Math.max(2, Math.round(canvas.width / 400));
      ctx.setLineDash([6, 4]);
      ctx.strokeRect(rx, ry, rw, rh);
      ctx.restore();
    }

    if (isDragging) {
      const x = Math.min(dragStartX, dragCurrentX);
      const y = Math.min(dragStartY, dragCurrentY);
      const w = Math.abs(dragCurrentX - dragStartX);
      const h = Math.abs(dragCurrentY - dragStartY);

      if (w > 4 && h > 4) {
        const previewReg: NormalizedRegion = {
          id: 'preview',
          nx: x / canvas.width,
          ny: y / canvas.height,
          nw: w / canvas.width,
          nh: h / canvas.height,
          effect: currentEffect,
          strength: currentStrength,
        };
        applyRegionEffect(ctx, canvas.width, canvas.height, previewReg);

        ctx.save();
        ctx.strokeStyle = '#06b6d4';
        ctx.lineWidth = Math.max(2, Math.round(canvas.width / 350));
        ctx.strokeRect(x, y, w, h);
        ctx.restore();
      }
    }
  }

  function getCanvasCoords(e: MouseEvent | Touch): { x: number; y: number } {
    const rect = canvas.getBoundingClientRect();
    const scaleX = canvas.width / rect.width;
    const scaleY = canvas.height / rect.height;
    return {
      x: Math.max(0, Math.min(canvas.width, (e.clientX - rect.left) * scaleX)),
      y: Math.max(0, Math.min(canvas.height, (e.clientY - rect.top) * scaleY)),
    };
  }

  canvas.addEventListener('mousedown', (e) => {
    if (!entries[activeIndex]) return;
    isDragging = true;
    const pt = getCanvasCoords(e);
    dragStartX = pt.x;
    dragStartY = pt.y;
    dragCurrentX = pt.x;
    dragCurrentY = pt.y;
  });

  window.addEventListener('mousemove', (e) => {
    if (!isDragging) return;
    const pt = getCanvasCoords(e);
    dragCurrentX = pt.x;
    dragCurrentY = pt.y;
    renderActiveCanvas();
  });

  window.addEventListener('mouseup', () => {
    if (!isDragging) return;
    isDragging = false;
    commitDraggedRegion();
  });

  canvas.addEventListener(
    'touchstart',
    (e) => {
      if (!entries[activeIndex] || e.touches.length === 0) return;
      e.preventDefault();
      isDragging = true;
      const pt = getCanvasCoords(e.touches[0]);
      dragStartX = pt.x;
      dragStartY = pt.y;
      dragCurrentX = pt.x;
      dragCurrentY = pt.y;
    },
    { passive: false }
  );

  canvas.addEventListener(
    'touchmove',
    (e) => {
      if (!isDragging || e.touches.length === 0) return;
      e.preventDefault();
      const pt = getCanvasCoords(e.touches[0]);
      dragCurrentX = pt.x;
      dragCurrentY = pt.y;
      renderActiveCanvas();
    },
    { passive: false }
  );

  canvas.addEventListener('touchend', () => {
    if (!isDragging) return;
    isDragging = false;
    commitDraggedRegion();
  });

  function commitDraggedRegion() {
    const entry = entries[activeIndex];
    if (!entry) return;

    const x = Math.min(dragStartX, dragCurrentX);
    const y = Math.min(dragStartY, dragCurrentY);
    const w = Math.abs(dragCurrentX - dragStartX);
    const h = Math.abs(dragCurrentY - dragStartY);

    if (w >= 6 && h >= 6) {
      entry.regions.push({
        id: Math.random().toString(36).slice(2),
        nx: x / canvas.width,
        ny: y / canvas.height,
        nw: w / canvas.width,
        nh: h / canvas.height,
        effect: currentEffect,
        strength: currentStrength,
      });
      hideNotice();
    }
    renderSidebarList();
    renderActiveCanvas();
  }

  undoRegionBtn.addEventListener('click', () => {
    const entry = entries[activeIndex];
    if (!entry || entry.regions.length === 0) return;
    entry.regions.pop();
    renderSidebarList();
    renderActiveCanvas();
  });

  clearRegionsBtn.addEventListener('click', () => {
    const entry = entries[activeIndex];
    if (!entry) return;
    entry.regions = [];
    renderSidebarList();
    renderActiveCanvas();
  });

  applyRegionsToAllBtn.addEventListener('click', () => {
    const current = entries[activeIndex];
    if (!current) return;
    if (current.regions.length === 0) {
      showNotice('ℹ️ まず現在の画像上でモザイク・黒塗り領域をドラッグして1箇所以上作成してください。', false);
      return;
    }

    for (let i = 0; i < entries.length; i++) {
      if (i === activeIndex) continue;
      entries[i].regions = current.regions.map((r) => ({
        ...r,
        id: Math.random().toString(36).slice(2),
      }));
    }

    renderSidebarList();
    renderActiveCanvas();
    const msg = `✔ 全${entries.length}枚に${current.regions.length}箇所のマスクを一括適用しました（外部通信 0件）`;
    mosaicProcessStatus.textContent = msg;
    showNotice(msg, false);
  });

  downloadCurrentBtn.addEventListener('click', async () => {
    const entry = entries[activeIndex];
    if (!entry) return;
    const startTime = performance.now();
    const { bytes } = await renderMaskedImageBytes(
      entry.sourceBytes,
      entry.mimeType,
      entry.regions
    );
    const extMatch = entry.name.match(/(\.[^.]+)$/);
    const ext = extMatch ? extMatch[1] : '.png';
    const base = entry.name.replace(/\.[^.]+$/, '');
    const outName = `${base}_masked${ext}`;
    const elapsed = ((performance.now() - startTime) / 1000).toFixed(2);
    mosaicProcessStatus.textContent = `⚡ 出力完了: ${elapsed}秒 (通信0バイト)`;
    triggerDownload(bytes, outName, entry.mimeType);
  });

  downloadAllZipBtn.addEventListener('click', async () => {
    if (entries.length === 0) return;
    const startTime = performance.now();
    downloadAllZipBtn.setAttribute('disabled', 'true');

    try {
      const zipFiles: { name: string; data: Uint8Array }[] = [];
      for (let i = 0; i < entries.length; i++) {
        const entry = entries[i];
        const { bytes } = await renderMaskedImageBytes(
          entry.sourceBytes,
          entry.mimeType,
          entry.regions
        );
        const extMatch = entry.name.match(/(\.[^.]+)$/);
        const ext = extMatch ? extMatch[1] : '.png';
        const base = entry.name.replace(/\.[^.]+$/, '');
        zipFiles.push({
          name: `${base}_masked${ext}`,
          data: bytes,
        });
      }

      const zipBytes = createZipArchive(zipFiles);
      const elapsed = ((performance.now() - startTime) / 1000).toFixed(2);
      mosaicProcessStatus.textContent = `⚡ 全${entries.length}枚のZIP生成完了: ${elapsed}秒 (外部通信0バイト)`;
      triggerDownload(zipBytes, 'zeroleak_masked_images.zip', 'application/zip');
    } finally {
      downloadAllZipBtn.removeAttribute('disabled');
    }
  });

  function triggerDownload(bytes: Uint8Array, filename: string, mimeType: string) {
    const buf = bytes.buffer.slice(
      bytes.byteOffset,
      bytes.byteOffset + bytes.byteLength
    ) as ArrayBuffer;
    const blob = new Blob([buf], { type: mimeType });
    const url = URL.createObjectURL(blob);
    const a = document.createElement('a');
    a.href = url;
    a.download = filename;
    document.body.appendChild(a);
    a.click();
    document.body.removeChild(a);
    URL.revokeObjectURL(url);
  }
</script>
