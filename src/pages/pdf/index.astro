---
import Layout from '../../layouts/Layout.astro';
import Mascot from '../../components/Mascot.astro';
import SecuritySpecModal from '../../components/SecuritySpecModal.astro';
import { tools, toolCategories } from '../../data/tools';

// PDF・Office・契約書・法務カテゴリのツール一覧
const targetSlugs = ['pdf-redaction', 'office-metadata-wiper', 'pdf-unlock', 'contract-diff'];
const categoryTools = targetSlugs.map(slug => tools.find(t => t.slug === slug)!).filter(Boolean);

const otherCategories = toolCategories.filter(c => c.id !== 'all' && c.id !== 'document_legal');

const title = 'PDF・Office・契約書・法務セキュリティツール一覧 | サーバー送信なし・ブラウザ完結';
const description = '社外秘PDFの不可逆墨消し、Word/Excelメタデータ完全消去、給与明細パスワード解除、契約書Diff比較を完全ローカルで安全実行。外部送信0バイト保証。';
const canonicalPath = '/pdf/';

const extraSchemaGraph = [
  {
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'ホーム', item: 'https://zeroleaktools.com/' },
      { '@type': 'ListItem', position: 2, name: 'PDF・Office・契約書・法務', item: 'https://zeroleaktools.com/pdf/' },
    ],
  },
  {
    '@type': 'CollectionPage',
    name: 'PDF・Office・契約書・法務セキュリティツール一覧',
    description,
    url: 'https://zeroleaktools.com/pdf/',
  },
  {
    '@type': 'FAQPage',
    mainEntity: [
      {
        '@type': 'Question',
        name: 'PDF上に黒い四角形を置いただけの黒塗りはコピペで復元できますか？',
        acceptedAnswer: {
          '@type': 'Answer',
          'text': 'はい、復元できます。一般的なPDFエディタで黒い図形を乗せただけの場合、下のテキスト情報はそのまま残っているため、Ctrl+A全選択やコピペで簡単に機密情報が抜き出せます。本ツールの不可逆墨消しはテキストレイヤーを画像ラスタライズして文字を物理破壊するため、100%復元不可能です。',
        },
      },
      {
        '@type': 'Question',
        name: 'WordやExcelのプロパティに残る社内情報とは何ですか？',
        acceptedAnswer: {
          '@type': 'Answer',
          'text': 'Officeファイルの内部XML（docProps）には、作成者のフルネーム、所属会社、最終保存者、総編集時間、テンプレート名が記録されています。下請け企業や外部パートナーが作成した資料を社外へ送る際、下請けの実名が取引先に筒抜けになる事故を防ぐため、事前のメタデータ消去が推奨されます。',
        },
      },
    ],
  },
];
---

<Layout
  title={title}
  description={description}
  canonicalPath={canonicalPath}
  extraSchemaGraph={extraSchemaGraph}
>
  <div class="max-w-5xl mx-auto space-y-10">
    
    <!-- パンくずリスト -->
    <nav aria-label="Breadcrumb" class="text-xs text-slate-500">
      <ol class="flex items-center gap-1.5">
        <li><a href="/" class="hover:text-slate-800 transition">ホーム</a></li>
        <li><span>/</span></li>
        <li class="font-semibold text-slate-800">PDF・Office・契約書・法務</li>
      </ol>
    </nav>

    <!-- ハブヘッダー -->
    <div class="space-y-3">
      <div class="flex flex-wrap items-center justify-between gap-3">
        <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-teal-50 border border-teal-200 text-teal-800 text-xs font-semibold">
          <span>📑</span>
          <span>PDF・Word・Excel・契約書・法務</span>
        </span>
        <button
          type="button"
          onclick="window.openSecurityModal && window.openSecurityModal()"
          class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg bg-white hover:bg-slate-50 text-slate-700 hover:text-slate-900 text-xs font-semibold border border-slate-200 shadow-xs transition cursor-pointer"
        >
          <span>🏢</span>
          <span>社内利用・情シス申請用仕様書</span>
        </button>
      </div>

      <!-- ゼロリークくん見守り保証バナー -->
      <div class="flex items-center gap-2.5 px-3.5 py-2 rounded-xl bg-teal-50 border border-teal-200 text-xs text-teal-950 shadow-2xs">
        <span class="text-base select-none shrink-0">🛡️</span>
        <p class="leading-relaxed">
          <strong class="font-bold">ゼロリークくん安全保証：</strong>本カテゴリの全ツールは端末内だけで動作します。F12（開発者ツールのNetworkタブ）で外部通信が一切発生しないことを目視確認できます。
        </p>
      </div>

      <div class="flex flex-col md:flex-row items-start md:items-center justify-between gap-6 pt-2">
        <div class="space-y-2 max-w-2xl">
          <h1 class="text-2xl sm:text-4xl font-extrabold text-slate-900 tracking-tight leading-tight">
            PDF・Office文書・契約書・法務の<br class="hidden sm:inline" />
            <span class="text-teal-700">機密保護・文書処理ツール一覧</span>
          </h1>
          <p class="text-slate-600 text-xs sm:text-sm leading-relaxed">
            社外提出前のPDF不可逆墨消し、Excel/Wordの作成者・会社名メタデータ消去、給与明細のパスワード解除、未締結契約書の安全な差分比較をブラウザ内完結で提供します。
          </p>
        </div>
        <Mascot name="tool-pdf-redaction" fallback="📑" width={320} eager class="w-24 sm:w-36 lg:w-44 rounded-2xl shrink-0 self-center md:self-auto" />
      </div>
    </div>

    <!-- よくある情報漏洩事故 vs ZeroLeakの物理遮断 -->
    <section class="p-5 sm:p-6 rounded-2xl bg-gradient-to-br from-teal-50/50 to-slate-50 border border-teal-100 space-y-4">
      <div class="flex items-center gap-2">
        <span class="text-lg">⚠️</span>
        <h2 class="text-sm sm:text-base font-bold text-slate-900">
          文書提出・法務実務で多発する3大インシデント
        </h2>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-4 text-xs">
        <div class="p-3.5 rounded-xl bg-white border border-slate-200 space-y-1.5 shadow-2xs">
          <span class="font-bold text-rose-700 flex items-center gap-1">
            <span>🚨</span>
            <span>「コピペで剥がれる」PDF墨消し事故</span>
          </span>
          <p class="text-slate-600 leading-relaxed text-[11px]">
            PDF上に黒い図形を乗せただけで安心し、相手方にテキスト選択・コピーされて社外秘金額や氏名が流出。
          </p>
          <div class="pt-1 text-[10px] text-teal-700 font-semibold">
            👉 「機密PDF完全墨消し」で文字レイヤーを物理破壊
          </div>
        </div>

        <div class="p-3.5 rounded-xl bg-white border border-slate-200 space-y-1.5 shadow-2xs">
          <span class="font-bold text-rose-700 flex items-center gap-1">
            <span>🚨</span>
            <span>Excelプロパティに残る下請け名</span>
          </span>
          <p class="text-slate-600 leading-relaxed text-[11px]">
            見積書や提案書のプロパティに、外部外注先の作成者名や会社名が残ったまま提出され下請け構造が筒抜けに。
          </p>
          <div class="pt-1 text-[10px] text-teal-700 font-semibold">
            👉 「Officeメタデータ消去」で作成者・会社名を抹消
          </div>
        </div>

        <div class="p-3.5 rounded-xl bg-white border border-slate-200 space-y-1.5 shadow-2xs">
          <span class="font-bold text-rose-700 flex items-center gap-1">
            <span>🚨</span>
            <span>未締結NDAの外部Diffサイト貼付</span>
          </span>
          <p class="text-slate-600 leading-relaxed text-[11px]">
            条文の変更箇所を調べるため、無料Web差分チェックサイトに契約書を貼り付けて重大な守秘義務違反に。
          </p>
          <div class="pt-1 text-[10px] text-teal-700 font-semibold">
            👉 「契約書Diff比較」で完全ローカル差分抽出
          </div>
        </div>
      </div>
    </section>

    <!-- ツール一覧カードグリッド -->
    <section class="space-y-4">
      <div class="flex items-center justify-between border-b border-slate-200 pb-2">
        <h2 class="text-base sm:text-lg font-bold text-slate-900 flex items-center gap-2">
          <span>🛠️</span>
          <span>利用可能なツール（{categoryTools.length}件）</span>
        </h2>
        <span class="text-xs text-slate-500">外部通信 0 バイト保証</span>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        {categoryTools.map((t) => (
          <div class="p-5 rounded-2xl bg-white border border-slate-200 hover:border-teal-400 hover:shadow-md transition space-y-3 flex flex-col justify-between">
            <div class="space-y-2">
              <div class="flex items-start justify-between gap-3">
                <div class="flex items-center gap-2.5">
                  <div class="w-10 h-10 rounded-xl bg-teal-50 border border-teal-200 flex items-center justify-center text-xl shrink-0">
                    {t.icon}
                  </div>
                  <div>
                    <h3 class="font-bold text-slate-900 text-sm sm:text-base leading-snug">
                      <a href={t.href} class="hover:text-teal-700 transition">
                        {t.name}
                      </a>
                    </h3>
                    <p class="text-[11px] text-slate-500 font-mono mt-0.5">{t.tagline}</p>
                  </div>
                </div>
              </div>
              <p class="text-xs text-slate-600 leading-relaxed">
                {t.panels[2].text}
              </p>
            </div>

            <div class="pt-2 border-t border-slate-100 flex items-center justify-between">
              <span class="text-[10px] font-semibold text-emerald-800 bg-emerald-50 px-2 py-0.5 rounded border border-emerald-200">
                ✔ 通信0バイト
              </span>
              <a
                href={t.href}
                class="inline-flex items-center gap-1.5 px-4 py-2 rounded-xl text-xs font-bold text-white bg-teal-600 hover:bg-teal-700 transition shadow-xs cursor-pointer"
              >
                <span>ツールを開く</span>
                <span>▶</span>
              </a>
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- 他カテゴリハブへの相互案内 -->
    <section class="space-y-4 pt-4 border-t border-slate-200">
      <h2 class="text-sm font-bold text-slate-800">他のカテゴリハブを見る：</h2>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        {otherCategories.map((c) => (
          <a
            href={c.hubPath}
            class="p-4 rounded-xl bg-white border border-slate-200 hover:border-slate-400 hover:shadow-xs transition flex items-center justify-between group"
          >
            <div class="flex items-center gap-3">
              <span class="text-2xl">{c.icon}</span>
              <div>
                <p class="font-bold text-slate-900 text-xs sm:text-sm group-hover:text-teal-700 transition">{c.label}</p>
                <p class="text-[11px] text-slate-500 mt-0.5">{c.tagline}</p>
              </div>
            </div>
            <span class="text-slate-400 group-hover:translate-x-1 transition-transform text-sm">▶</span>
          </a>
        ))}
      </div>
    </section>

  </div>

  <SecuritySpecModal />
</Layout>
