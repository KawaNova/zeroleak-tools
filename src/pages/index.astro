---
import Layout from '../layouts/Layout.astro';
import Mascot from '../components/Mascot.astro';
import { tools, toolCategories } from '../data/tools';
---

<Layout
  title="機密ファイル安心処理ツール群｜外部送信なし・ブラウザ完結 - ZeroLeak Tools"
  description="登録不要・完全無料。給与明細PDFパスワード解除、契約書Diff比較、不可逆墨消し、個人情報CSV伏字化など、ファイルを外部サーバーへ一切送信せずにお使いの端末内だけで高速安全に処理します。"
  canonicalPath="/"
>
  <div class="space-y-10 sm:space-y-14 py-2 sm:py-4">

    <!-- ヒーロー：キャラクターが「ファイルは外へ出ない」を1枚で伝える -->
    <section class="grid grid-cols-1 md:grid-cols-2 items-center gap-6 md:gap-10 max-w-5xl mx-auto px-2 sm:px-4">
      <div class="space-y-3 sm:space-y-4 text-left">
        <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-emerald-50 border border-emerald-200 text-emerald-800 text-xs font-semibold">
          <span>🛡️ 番人「ゼロリークくん」が見守る安全設計</span>
        </div>
        <h1 class="text-2xl sm:text-4xl font-extrabold text-slate-900 tracking-tight leading-snug">
          機密ファイルを<br />1バイトも送信しない、<br />
          <span class="text-emerald-600">安心のローカル業務ツール</span>
        </h1>
        <p class="text-slate-600 text-sm sm:text-base leading-relaxed">
          給与明細・契約書・顧客データ・社外秘ログを、アップロードせずブラウザ内だけで処理。公式キャラクター「ゼロリークくん」がファイルの外漏れをブロックします。登録不要・完全無料です。
        </p>
        <a
          href="#tools"
          class="inline-flex items-center gap-1.5 px-5 py-2.5 rounded-xl bg-emerald-600 hover:bg-emerald-700 text-white text-sm font-bold shadow-xs transition"
        >
          ツールを選ぶ ▼
        </a>
      </div>
      <div>
        <Mascot
          name="hero-home"
          fallback="🛡️"
          alt="ゼロリークくんがパソコンを守り、ファイルがクラウドへ送られないことを示すイラスト"
          width={720}
          eager
          class="w-full max-w-[16rem] sm:max-w-sm md:max-w-none mx-auto rounded-3xl"
        />
        <p class="text-center text-xs text-slate-500 mt-2 font-medium">ZeroLeak Tools 公式番人「ゼロリークくん」</p>
      </div>
    </section>

    <!-- 目的から探す：ツール名を知らなくても迷わない入り口 -->
    <section class="max-w-5xl mx-auto px-2 sm:px-4 space-y-3 text-left">
      <h2 class="text-base sm:text-lg font-bold text-slate-900">何をしたいですか？</h2>
      <ul class="flex flex-wrap gap-2">
        {
          tools.map((t) => (
            <li>
              <a
                href={t.href}
                class={`inline-flex items-center gap-1.5 px-3.5 py-2 rounded-full bg-white border border-slate-200 text-xs sm:text-sm font-medium text-slate-700 shadow-xs transition ${t.accent.border} hover:text-slate-900`}
              >
                <span aria-hidden="true">{t.icon}</span>
                <span>{t.intent}</span>
              </a>
            </li>
          ))
        }
      </ul>
    </section>

    <!-- ツール一覧：3大カテゴリ分類タブ ＆ カードグリッド -->
    <section id="tools" class="max-w-6xl mx-auto w-full space-y-5 scroll-mt-20">
      <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-3 px-2 sm:px-0">
        <div>
          <h2 class="text-lg sm:text-2xl font-extrabold text-slate-900 text-left">ツール一覧</h2>
          <p id="categoryDescription" class="text-xs sm:text-sm text-slate-500 mt-1">
            全{tools.length}ツール・すべてブラウザ内完結（外部サーバー送信0バイト保証）
          </p>
        </div>
      </div>

      <!-- 3大カテゴリ分類タブUI -->
      <div class="flex items-center gap-2 overflow-x-auto pb-1 px-2 sm:px-0 no-scrollbar" role="tablist">
        {
          toolCategories.map((cat, idx) => {
            const count = cat.id === 'all' ? tools.length : tools.filter(t => t.category === cat.id).length;
            const isActive = idx === 0;
            return (
              <button
                type="button"
                role="tab"
                data-category-target={cat.id}
                data-description={cat.description}
                aria-selected={isActive ? 'true' : 'false'}
                class={`category-tab-btn inline-flex items-center gap-1.5 px-3.5 py-2 rounded-xl text-xs sm:text-sm font-bold transition-all cursor-pointer whitespace-nowrap shadow-xs ${
                  isActive
                    ? 'bg-slate-900 text-white shadow-xs'
                    : 'bg-white hover:bg-slate-50 text-slate-600 hover:text-slate-900 border border-slate-200'
                }`}
              >
                <span>{cat.icon}</span>
                <span>{cat.label}</span>
                <span class={`text-[11px] px-1.5 py-0.2 rounded-full ${isActive ? 'bg-slate-700 text-slate-200' : 'bg-slate-100 text-slate-500'}`}>
                  {count}
                </span>
              </button>
            );
          })
        }
      </div>

      <!-- カード一覧 -->
      <ul id="toolCardsGrid" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-3 sm:gap-4">
        {
          tools.map((t) => (
            <li class="tool-card-item" data-category={t.category}>
              <a
                href={t.href}
                class={`group flex flex-row sm:flex-col h-full rounded-2xl bg-white border border-slate-200 overflow-hidden hover:shadow-md transition-all duration-150 ${t.accent.border}`}
              >
                <Mascot
                  name={t.image}
                  fallback={t.icon}
                  alt=""
                  width={560}
                  class={`w-28 sm:w-full shrink-0 aspect-[4/3] object-cover ${t.accent.soft} rounded-none group-hover:scale-[1.02] transition-transform`}
                />
                <div class="p-3 sm:p-4 space-y-1 text-left min-w-0 self-center">
                  <h3 class={`text-sm sm:text-base font-bold text-slate-900 group-hover:${t.accent.text} transition-colors leading-snug`}>
                    {t.name}
                  </h3>
                  <p class="text-xs text-slate-500 leading-relaxed">{t.tagline}</p>
                </div>
              </a>
            </li>
          ))
        }
      </ul>
    </section>

    <!-- 【折りたたみ】安全性の根拠（詳細はここに集約。本文では繰り返さない） -->
    <section class="max-w-5xl mx-auto w-full">
      <details class="group bg-slate-50/70 border border-slate-200 rounded-2xl p-4">
        <summary class="flex items-center justify-between cursor-pointer list-none select-none text-slate-800 font-bold text-sm sm:text-base">
          <span>🛡️ なぜ「ブラウザ内で完結」すると安全なのですか？</span>
          <span class="text-slate-400 group-open:rotate-180 transition-transform text-xs">▼</span>
        </summary>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-3 pt-4 mt-3 border-t border-slate-200/60 text-slate-600 text-xs leading-relaxed text-left">
          <div class="p-3 bg-white rounded-xl border border-slate-200/60 space-y-1">
            <div class="font-bold text-slate-900">① 外部通信ゼロを自分で確認できる</div>
            <p>ブラウザのCSPで通信を遮断。F12のNetworkタブで、処理中に外部通信が0件であることを目視確認できます。</p>
          </div>
          <div class="p-3 bg-white rounded-xl border border-slate-200/60 space-y-1">
            <div class="font-bold text-slate-900">② アップロード待ちがない</div>
            <p>大容量のPDFやCSVでも、クラウドへの往復転送がありません。端末のメモリ上で直接処理します。</p>
          </div>
          <div class="p-3 bg-white rounded-xl border border-slate-200/60 space-y-1">
            <div class="font-bold text-slate-900">③ 無料のまま続けられる</div>
            <p>サーバー側で計算しない静的配信のため、維持費がかからず、有料化の心配もありません。</p>
          </div>
        </div>
      </details>
    </section>

  </div>
</Layout>

<script>
  const tabButtons = document.querySelectorAll<HTMLButtonElement>('.category-tab-btn');
  const cardItems = document.querySelectorAll<HTMLElement>('.tool-card-item');
  const descriptionEl = document.getElementById('categoryDescription');

  tabButtons.forEach((btn) => {
    btn.addEventListener('click', () => {
      const targetCat = btn.getAttribute('data-category-target');
      const desc = btn.getAttribute('data-description');

      // タブ状態切り替え
      tabButtons.forEach((b) => {
        const isCurrent = b === btn;
        b.setAttribute('aria-selected', isCurrent ? 'true' : 'false');
        if (isCurrent) {
          b.className = 'category-tab-btn inline-flex items-center gap-1.5 px-3.5 py-2 rounded-xl text-xs sm:text-sm font-bold transition-all cursor-pointer whitespace-nowrap shadow-xs bg-slate-900 text-white';
          const badge = b.querySelector('span:last-child');
          if (badge) badge.className = 'text-[11px] px-1.5 py-0.2 rounded-full bg-slate-700 text-slate-200';
        } else {
          b.className = 'category-tab-btn inline-flex items-center gap-1.5 px-3.5 py-2 rounded-xl text-xs sm:text-sm font-bold transition-all cursor-pointer whitespace-nowrap shadow-xs bg-white hover:bg-slate-50 text-slate-600 hover:text-slate-900 border border-slate-200';
          const badge = b.querySelector('span:last-child');
          if (badge) badge.className = 'text-[11px] px-1.5 py-0.2 rounded-full bg-slate-100 text-slate-500';
        }
      });

      // 説明文更新
      if (descriptionEl && desc) {
        descriptionEl.textContent = desc;
      }

      // カードのフィルタリング表示
      cardItems.forEach((card) => {
        const cardCat = card.getAttribute('data-category');
        if (targetCat === 'all' || cardCat === targetCat) {
          card.style.display = '';
        } else {
          card.style.display = 'none';
        }
      });
    });
  });
</script>
