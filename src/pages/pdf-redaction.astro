---
import ToolShell from '../components/ToolShell.astro';
import RedactionDemo from '../components/RedactionDemo.astro';

const howToSteps = [
  {
    name: 'PDFファイルをドラッグ＆ドロップ',
    text: '黒塗りしたい契約書、見積書、公文書、履歴書などのPDFをドロップします。',
  },
  {
    name: '黒塗り箇所の指定（ドラッグまたは自動検出）',
    text: 'プレビュー画面上で隠したい箇所をマウスドラッグで囲むか、「個人情報（マイナンバー・電話等）を自動検出」で一括指定します。',
  },
  {
    name: '不可逆ラスタライズ変換で完全消去PDFを保存',
    text: 'テキスト層を物理的に消滅させた高精細ラスタライズPDFをダウンロードします。コピペもレイヤー剥がしも100%不可能です。',
  },
];

const faqs = [
  {
    question: 'なぜPDFの上に黒い四角形を重ねるだけの墨消しは危険なのですか？',
    answer: '一般的なPDF編集ソフトで四角形図形を文字の上に乗せただけの場合、PDF内部の『テキストレイヤー（文字コードデータ）』は消去されずにそのまま残っています。受け取った側がCtrl+A（全選択）してメモ帳に貼り付けたり、注釈オブジェクトを削除するだけで、隠したはずの氏名や金額が丸見えになります。本ツールは高精細Canvasラスタライズによりテキスト層を物理的に消滅させるため安全です。',
  },
  {
    question: 'ラスタライズ（画像化）するとPDFの文字がぼやけたり画質が落ちませんか？',
    answer: '本ツールは一般的な印刷解像度と同等の高DPI（約200〜300DPI相当）でブラウザ内ラスタライズを行います。肉眼での閲覧やA4用紙への印刷において文字の輪郭が崩れず、非常に鮮明なクオリティを維持しながらテキスト層のみを完全抹消します。',
  },
  {
    question: '裁判所や官公庁、取引先への提出用書類として利用できますか？',
    answer: 'はい。裁判所への証拠提出や官公庁の開示請求書類、取引先への見積・請求書など、厳格な守秘義務が求められる墨消し資料に最適です。テキスト検索やOCRコピペによる情報漏洩事故を物理的に遮断できます（※提出前に必ずご自身でダウンロード結果を目視確認してください）。',
  },
  {
    question: 'マイナンバーや電話番号などの個人情報は自動で検出できますか？',
    answer: 'はい。『個人情報を自動検出して枠配置』ボタンを押すと、PDF内のテキストレイヤーを走査してマイナンバー（12桁）、電話番号、メールアドレスの該当箇所を自動検出し、ワンクリックで黒塗り枠を配置できます。',
  },
];
---

<ToolShell
  slug="pdf-redaction"
  title="機密PDF 完全黒塗り・不可逆墨消し | コピペ復元不可・一括・ブラウザ・サーバー送信なし"
  description="PDFの氏名・金額・マイナンバーを一括で不可逆黒塗り。コピペで文字が抜ける事故を物理防止（Canvasラスタライズ・テキスト層消滅）。ブラウザ完結・外部送信0バイト。"
  canonicalPath="/pdf-redaction/"
  h1="機密PDF 完全黒塗り・不可逆墨消し"
  subtitle="「黒枠を重ねただけ」で下の文字が抜ける事故を物理防止。テキスト層を消滅させて再構築します。"
  mascotName="tool-pdf-redaction"
  mascotFallback="⬛"
  whyTitle="「PDFの上に黒い四角を置いただけ」は、1秒で文字が抜ける"
  howToSteps={howToSteps}
  faqs={faqs}
>
  <!-- ワンクリック検証用サンプルボタン -->
  <div slot="sample-button" class="flex flex-wrap items-center gap-2">
    <button
      id="loadSamplePdfRedactBtn"
      type="button"
      class="inline-flex items-center gap-1.5 px-3 py-1.5 min-h-[38px] rounded-xl bg-slate-900 hover:bg-slate-800 text-white text-xs font-bold transition shadow-sm cursor-pointer shrink-0"
    >
      <span aria-hidden="true">🧪</span>
      <span>サンプル機密PDFで試す（偽黒塗り比較付）</span>
    </button>
  </div>

  <div class="space-y-6">
    <!-- メイン操作カード -->
    <div class="bg-white border border-slate-200 rounded-2xl p-4 sm:p-6 shadow-sm space-y-5">
      <!-- ファイルドロップゾーン -->
      <div id="dropZonePdfRedact" class="border-2 border-dashed border-slate-300 hover:border-slate-800 rounded-2xl p-6 sm:p-8 text-center transition bg-slate-50/70 hover:bg-slate-100/60 cursor-pointer group">
        <input type="file" id="fileInputPdfRedact" accept=".pdf,application/pdf" class="hidden" />
        <div class="flex flex-col items-center gap-2.5 pointer-events-none">
          <div class="w-12 h-12 rounded-xl bg-slate-900 text-white flex items-center justify-center group-hover:scale-105 transition-transform shadow-sm text-xl font-bold">
            ⬛
          </div>
          <div>
            <p class="font-bold text-slate-900 text-sm sm:text-base">黒塗り・墨消ししたいPDFをドロップ</p>
            <p class="text-xs text-slate-600 mt-0.5">またはクリックしてファイルを選択 (.pdf) • 複数ページ一括処理対応</p>
          </div>
          <div class="flex flex-wrap items-center justify-center gap-2">
            <span class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full bg-white border border-slate-200 text-[11px] text-slate-900 shadow-sm font-bold">
              🔒 サーバー送信なし（0バイト保証）
            </span>
            <span class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full bg-white border border-slate-200 text-[11px] text-rose-700 shadow-sm font-semibold">
              🚫 テキスト層完全消滅（コピペ不可）
            </span>
          </div>
        </div>
      </div>

      <!-- ワークスペース（PDF読み込み後表示） -->
      <div id="redactWorkspace" class="hidden space-y-4">
        <!-- コントロールバー -->
        <div class="p-3.5 rounded-xl bg-slate-50 border border-slate-200 flex flex-wrap items-center justify-between gap-3 text-xs">
          <div class="flex flex-wrap items-center gap-2 min-w-0">
            <span class="font-bold text-slate-900 truncate max-w-[180px] sm:max-w-xs" id="pdfFileNameText">document.pdf</span>
            <span class="text-slate-600 font-mono" id="pdfPageInfoText">ページ: 1 / 1</span>
            <button
              id="changePdfRedactBtn"
              type="button"
              class="text-xs text-slate-700 hover:text-slate-950 underline font-semibold cursor-pointer"
            >
              別のPDFを選択
            </button>
          </div>

          <!-- ページナビゲーション＆自動検出＆操作 -->
          <div class="flex flex-wrap items-center gap-1.5 sm:gap-2">
            <button
              id="prevPageBtn"
              type="button"
              class="px-2.5 py-1.5 min-h-[38px] rounded-lg bg-white border border-slate-300 text-slate-800 font-bold hover:bg-slate-100 disabled:opacity-40 cursor-pointer"
            >
              ◀ 前
            </button>
            <button
              id="nextPageBtn"
              type="button"
              class="px-2.5 py-1.5 min-h-[38px] rounded-lg bg-white border border-slate-300 text-slate-800 font-bold hover:bg-slate-100 disabled:opacity-40 cursor-pointer"
            >
              次 ▶
            </button>
            <button
              id="autoDetectRisksBtn"
              type="button"
              class="px-3 py-1.5 min-h-[38px] rounded-lg bg-rose-50 border border-rose-200 text-rose-800 font-bold hover:bg-rose-100 flex items-center gap-1 cursor-pointer"
            >
              <span aria-hidden="true">🔍</span>
              <span>個人情報を自動検出して枠配置</span>
            </button>
            <button
              id="undoRedactionBtn"
              type="button"
              class="px-2.5 py-1.5 min-h-[38px] rounded-lg bg-white border border-slate-300 text-slate-800 hover:bg-slate-100 font-semibold cursor-pointer"
            >
              ↩ 1つ戻す
            </button>
            <button
              id="clearRedactionsBtn"
              type="button"
              class="px-2.5 py-1.5 min-h-[38px] rounded-lg bg-white border border-slate-300 text-slate-700 hover:text-rose-700 font-semibold cursor-pointer"
            >
              枠を全消去
            </button>
          </div>
        </div>

        <!-- 検出リスク警告バー -->
        <div id="detectedRisksBanner" class="hidden p-3 rounded-xl bg-rose-50 border border-rose-200 text-rose-900 text-xs flex flex-wrap items-center justify-between gap-2">
          <span id="detectedRisksCountText" class="font-bold">⚠️ 機密テキストを検出しました</span>
          <span class="text-xs text-rose-800">位置をドラッグで調整し「完全黒塗りを実行」を押してください</span>
        </div>

        <!-- インライン通知バナー -->
        <div id="redactStatusBanner" hidden role="status" class="p-3 rounded-xl border text-xs font-semibold"></div>

        <!-- PDFプレビュー＆ドラッグ黒塗りCanvasエリア -->
        <div class="flex flex-col items-center">
          <div class="relative inline-block border-2 border-slate-300 rounded-xl overflow-hidden shadow-sm bg-slate-200 select-none touch-none max-w-full">
            <!-- PDF表示Canvas -->
            <canvas id="pdfRenderCanvas" class="block max-w-full h-auto cursor-crosshair"></canvas>
            <!-- 黒塗り矩形描画用オーバーレイCanvas -->
            <canvas id="pdfOverlayCanvas" class="absolute top-0 left-0 w-full h-full cursor-crosshair pointer-events-auto"></canvas>
          </div>
          <p class="text-xs text-slate-700 mt-2">
            💡 マウスや指で隠したい箇所をドラッグすると黒塗り枠が追加されます（複数箇所指定可）。
          </p>
        </div>

        <!-- 実行・ダウンロードセクション -->
        <div class="pt-4 border-t border-slate-200 space-y-3">
          <!-- 枠0件時のインライン確認パネル -->
          <div id="zeroBoxConfirmPanel" class="hidden p-3.5 rounded-xl bg-slate-100 border border-slate-300 text-xs text-slate-900 space-y-2.5">
            <p class="font-bold">⚠️ 黒塗り枠が1つも指定されていません</p>
            <p class="text-slate-700">このまま全ページを画像ラスタライズし、コピー可能なテキスト層のみを完全消滅させたPDFを出力しますか？</p>
            <div class="flex flex-wrap items-center gap-2">
              <button
                id="confirmZeroBoxBtn"
                type="button"
                class="px-4 py-2 min-h-[40px] rounded-lg bg-slate-900 hover:bg-slate-800 text-white font-bold cursor-pointer"
              >
                はい、テキスト層を消滅して保存
              </button>
              <button
                id="cancelZeroBoxBtn"
                type="button"
                class="px-4 py-2 min-h-[40px] rounded-lg bg-white hover:bg-slate-50 border border-slate-300 text-slate-800 font-semibold cursor-pointer"
              >
                キャンセル（黒枠を指定する）
              </button>
            </div>
          </div>

          <div class="flex flex-col sm:flex-row items-center justify-between gap-3">
            <div>
              <p class="font-bold text-xs sm:text-sm text-slate-900">
                不可逆ラスタライズ変換でテキスト層を完全消滅
              </p>
              <p class="text-xs text-slate-600">
                黒塗り枠部分をピクセル破壊し、テキストデータを1バイトも含まないクリーンな画像PDFとして再結合します。
              </p>
            </div>
            <button
              id="executeRedactionBtn"
              type="button"
              class="w-full sm:w-auto px-6 py-3 min-h-[44px] rounded-xl font-bold text-xs sm:text-sm text-white bg-slate-900 hover:bg-slate-800 transition shadow-sm flex items-center justify-center gap-2 cursor-pointer shrink-0 disabled:opacity-50"
            >
              <span aria-hidden="true">⬛</span>
              <span>完全黒塗りを実行してPDFを保存 (通信0バイト)</span>
            </button>
          </div>

          <!-- ゼロリークくん完了メッセージ -->
          <div class="flex items-center gap-2 p-3 rounded-xl bg-slate-100 border border-slate-300 text-xs text-slate-900 font-medium">
            <span class="text-base select-none shrink-0" aria-hidden="true">🛡️</span>
            <span><strong>ゼロリークくん：</strong>墨消し処理はブラウザのCanvas上で不可逆にピクセル破壊されます。コピペで裏の文字が漏れる心配はありません。</span>
          </div>

          <!-- 法務防衛・完全免責事項（最重要常設バナー） -->
          <div class="p-3 rounded-xl bg-slate-100/80 border border-slate-200 text-xs text-slate-700 leading-relaxed">
            <div class="font-bold text-slate-900 flex items-center gap-1 mb-0.5">
              <span aria-hidden="true">⚠️</span>
              <span>提出前の目視確認必須 ＆ 完全免責事項</span>
            </div>
            <p>
              本ツールはブラウザ内部のみでピクセル破壊および再構築を行いますが、原稿のレイアウトや指定座標のズレにより、意図した文字が隠れ切らない場合があります。<strong>官公庁・裁判所・取引先へ提出する前に、保存されたPDFをご自身で必ず目視およびテキスト選択不可であることを確認してください。</strong>本ツールの利用・処理結果によるいかなる直接的・間接的損害についても一切の責任を負いかねます（完全免責）。
            </p>
          </div>
        </div>
      </div>
    </div>

    <!-- 3秒体験デモ（コピペ剥がれ vs 画素破壊） -->
    <RedactionDemo />
  </div>
</ToolShell>

<script>
  import * as pdfjsLib from 'pdfjs-dist/legacy/build/pdf.mjs';
  import {
    analyzePdfRisks,
    renderRedactedPdf,
    generateSampleConfidentialPdf,
    type RedactionBox,
  } from '../utils/pdf-redaction';

  pdfjsLib.GlobalWorkerOptions.workerSrc = new URL(
    'pdfjs-dist/legacy/build/pdf.worker.min.mjs',
    import.meta.url
  ).toString();

  let currentPdfBytes: Uint8Array | null = null;
  let currentFileName = 'document.pdf';
  let currentPdfDoc: any = null;
  let totalPages = 1;
  let currentPageNum = 1;
  let redactions: RedactionBox[] = [];

  // ドラッグ状態
  let isDrawing = false;
  let startX = 0;
  let startY = 0;

  // DOM要素
  const dropZone = document.getElementById('dropZonePdfRedact')!;
  const fileInput = document.getElementById('fileInputPdfRedact') as HTMLInputElement;
  const loadSampleBtn = document.getElementById('loadSamplePdfRedactBtn')!;
  const workspace = document.getElementById('redactWorkspace')!;
  const fileNameText = document.getElementById('pdfFileNameText')!;
  const pageInfoText = document.getElementById('pdfPageInfoText')!;
  const changePdfBtn = document.getElementById('changePdfRedactBtn')!;
  const prevPageBtn = document.getElementById('prevPageBtn') as HTMLButtonElement;
  const nextPageBtn = document.getElementById('nextPageBtn') as HTMLButtonElement;
  const autoDetectBtn = document.getElementById('autoDetectRisksBtn')!;
  const undoBtn = document.getElementById('undoRedactionBtn')!;
  const clearBtn = document.getElementById('clearRedactionsBtn')!;
  const executeBtn = document.getElementById('executeRedactionBtn') as HTMLButtonElement;
  const renderCanvas = document.getElementById('pdfRenderCanvas') as HTMLCanvasElement;
  const overlayCanvas = document.getElementById('pdfOverlayCanvas') as HTMLCanvasElement;
  const risksBanner = document.getElementById('detectedRisksBanner')!;
  const risksCountText = document.getElementById('detectedRisksCountText')!;
  const statusBanner = document.getElementById('redactStatusBanner')!;
  const zeroBoxConfirmPanel = document.getElementById('zeroBoxConfirmPanel')!;
  const confirmZeroBoxBtn = document.getElementById('confirmZeroBoxBtn')!;
  const cancelZeroBoxBtn = document.getElementById('cancelZeroBoxBtn')!;

  function showStatus(msg: string, tone: 'success' | 'info' | 'error' = 'info') {
    const toneClass =
      tone === 'success'
        ? 'bg-emerald-50 border-emerald-200 text-emerald-900'
        : tone === 'error'
        ? 'bg-rose-50 border-rose-200 text-rose-900'
        : 'bg-slate-100 border-slate-300 text-slate-900';
    statusBanner.className = `p-3 rounded-xl border text-xs font-semibold ${toneClass}`;
    statusBanner.textContent = msg;
    statusBanner.hidden = false;
  }

  function hideStatus() {
    statusBanner.hidden = true;
  }

  // ファイルドロップ
  dropZone.addEventListener('click', () => fileInput.click());
  dropZone.addEventListener('dragover', (e) => {
    e.preventDefault();
    dropZone.classList.add('border-slate-800', 'bg-slate-100');
  });
  dropZone.addEventListener('dragleave', () => {
    dropZone.classList.remove('border-slate-800', 'bg-slate-100');
  });
  dropZone.addEventListener('drop', (e) => {
    e.preventDefault();
    dropZone.classList.remove('border-slate-800', 'bg-slate-100');
    if (e.dataTransfer?.files.length) {
      loadPdfFile(e.dataTransfer.files[0]);
    }
  });
  fileInput.addEventListener('change', () => {
    if (fileInput.files?.length) {
      loadPdfFile(fileInput.files[0]);
    }
  });

  changePdfBtn.addEventListener('click', () => {
    currentPdfBytes = null;
    currentPdfDoc = null;
    redactions = [];
    fileInput.value = '';
    risksBanner.classList.add('hidden');
    zeroBoxConfirmPanel.classList.add('hidden');
    hideStatus();
    workspace.classList.add('hidden');
    dropZone.classList.remove('hidden');
  });

  async function loadPdfFile(file: File) {
    currentFileName = file.name;
    const arrayBuffer = await file.arrayBuffer();
    currentPdfBytes = new Uint8Array(arrayBuffer);
    redactions = [];
    risksBanner.classList.add('hidden');
    zeroBoxConfirmPanel.classList.add('hidden');
    hideStatus();
    await initializePdfViewer();
  }

  // サンプル投入
  loadSampleBtn.addEventListener('click', async () => {
    currentFileName = 'sample_confidential_report.pdf';
    currentPdfBytes = await generateSampleConfidentialPdf();
    redactions = [];
    zeroBoxConfirmPanel.classList.add('hidden');
    hideStatus();
    await initializePdfViewer();
    await runAutoDetect();
  });

  async function initializePdfViewer() {
    if (!currentPdfBytes) return;
    currentPdfDoc = await pdfjsLib.getDocument({
      data: currentPdfBytes.slice(0),
      useSystemFonts: true,
    }).promise;
    totalPages = currentPdfDoc.numPages;
    currentPageNum = 1;
    fileNameText.textContent = currentFileName;
    dropZone.classList.add('hidden');
    workspace.classList.remove('hidden');
    await renderCurrentPage();
  }

  async function renderCurrentPage() {
    if (!currentPdfDoc) return;
    pageInfoText.textContent = `ページ: ${currentPageNum} / ${totalPages}`;
    prevPageBtn.disabled = currentPageNum <= 1;
    nextPageBtn.disabled = currentPageNum >= totalPages;

    const page = await currentPdfDoc.getPage(currentPageNum);
    const viewport = page.getViewport({ scale: 1.5 });

    renderCanvas.width = viewport.width;
    renderCanvas.height = viewport.height;
    overlayCanvas.width = viewport.width;
    overlayCanvas.height = viewport.height;

    const ctx = renderCanvas.getContext('2d');
    if (ctx) {
      ctx.fillStyle = '#ffffff';
      ctx.fillRect(0, 0, renderCanvas.width, renderCanvas.height);
      await page.render({
        canvasContext: ctx,
        viewport,
      }).promise;
    }

    drawOverlayRedactions();
  }

  function drawOverlayRedactions() {
    const ctx = overlayCanvas.getContext('2d');
    if (!ctx) return;
    ctx.clearRect(0, 0, overlayCanvas.width, overlayCanvas.height);

    const pageRedactions = redactions.filter((r) => r.pageNumber === currentPageNum);
    for (const r of pageRedactions) {
      const x = r.x * overlayCanvas.width;
      const y = r.y * overlayCanvas.height;
      const w = r.width * overlayCanvas.width;
      const h = r.height * overlayCanvas.height;

      ctx.fillStyle = 'rgba(15, 23, 42, 0.95)';
      ctx.fillRect(x, y, w, h);

      ctx.strokeStyle = '#dc2626';
      ctx.lineWidth = 1.5;
      ctx.strokeRect(x, y, w, h);
    }
  }

  overlayCanvas.addEventListener('mousedown', (e) => {
    const rect = overlayCanvas.getBoundingClientRect();
    const scaleX = overlayCanvas.width / rect.width;
    const scaleY = overlayCanvas.height / rect.height;
    startX = (e.clientX - rect.left) * scaleX;
    startY = (e.clientY - rect.top) * scaleY;
    isDrawing = true;
  });

  overlayCanvas.addEventListener('mousemove', (e) => {
    if (!isDrawing) return;
    const rect = overlayCanvas.getBoundingClientRect();
    const scaleX = overlayCanvas.width / rect.width;
    const scaleY = overlayCanvas.height / rect.height;
    const currentX = (e.clientX - rect.left) * scaleX;
    const currentY = (e.clientY - rect.top) * scaleY;

    drawOverlayRedactions();

    const ctx = overlayCanvas.getContext('2d');
    if (ctx) {
      const x = Math.min(startX, currentX);
      const y = Math.min(startY, currentY);
      const w = Math.abs(currentX - startX);
      const h = Math.abs(currentY - startY);

      ctx.fillStyle = 'rgba(15, 23, 42, 0.7)';
      ctx.fillRect(x, y, w, h);
      ctx.strokeStyle = '#0284c7';
      ctx.lineWidth = 2;
      ctx.strokeRect(x, y, w, h);
    }
  });

  overlayCanvas.addEventListener('mouseup', (e) => {
    if (!isDrawing) return;
    isDrawing = false;
    const rect = overlayCanvas.getBoundingClientRect();
    const scaleX = overlayCanvas.width / rect.width;
    const scaleY = overlayCanvas.height / rect.height;
    const endX = (e.clientX - rect.left) * scaleX;
    const endY = (e.clientY - rect.top) * scaleY;

    const px = Math.min(startX, endX);
    const py = Math.min(startY, endY);
    const pw = Math.abs(endX - startX);
    const ph = Math.abs(endY - startY);

    if (pw > 5 && ph > 5) {
      redactions.push({
        pageNumber: currentPageNum,
        x: px / overlayCanvas.width,
        y: py / overlayCanvas.height,
        width: pw / overlayCanvas.width,
        height: ph / overlayCanvas.height,
      });
      zeroBoxConfirmPanel.classList.add('hidden');
    }
    drawOverlayRedactions();
  });

  overlayCanvas.addEventListener('touchstart', (e) => {
    if (e.touches.length === 0) return;
    e.preventDefault();
    const rect = overlayCanvas.getBoundingClientRect();
    const scaleX = overlayCanvas.width / rect.width;
    const scaleY = overlayCanvas.height / rect.height;
    startX = (e.touches[0].clientX - rect.left) * scaleX;
    startY = (e.touches[0].clientY - rect.top) * scaleY;
    isDrawing = true;
  }, { passive: false });

  overlayCanvas.addEventListener('touchmove', (e) => {
    if (!isDrawing || e.touches.length === 0) return;
    e.preventDefault();
    const rect = overlayCanvas.getBoundingClientRect();
    const scaleX = overlayCanvas.width / rect.width;
    const scaleY = overlayCanvas.height / rect.height;
    const currentX = (e.touches[0].clientX - rect.left) * scaleX;
    const currentY = (e.touches[0].clientY - rect.top) * scaleY;

    drawOverlayRedactions();

    const ctx = overlayCanvas.getContext('2d');
    if (ctx) {
      const x = Math.min(startX, currentX);
      const y = Math.min(startY, currentY);
      const w = Math.abs(currentX - startX);
      const h = Math.abs(currentY - startY);

      ctx.fillStyle = 'rgba(15, 23, 42, 0.7)';
      ctx.fillRect(x, y, w, h);
      ctx.strokeStyle = '#0284c7';
      ctx.lineWidth = 2;
      ctx.strokeRect(x, y, w, h);
    }
  }, { passive: false });

  overlayCanvas.addEventListener('touchend', (e) => {
    if (!isDrawing) return;
    isDrawing = false;
    const rect = overlayCanvas.getBoundingClientRect();
    const scaleX = overlayCanvas.width / rect.width;
    const scaleY = overlayCanvas.height / rect.height;
    const touch = e.changedTouches[0];
    if (!touch) return;
    const endX = (touch.clientX - rect.left) * scaleX;
    const endY = (touch.clientY - rect.top) * scaleY;

    const px = Math.min(startX, endX);
    const py = Math.min(startY, endY);
    const pw = Math.abs(endX - startX);
    const ph = Math.abs(endY - startY);

    if (pw > 5 && ph > 5) {
      redactions.push({
        pageNumber: currentPageNum,
        x: px / overlayCanvas.width,
        y: py / overlayCanvas.height,
        width: pw / overlayCanvas.width,
        height: ph / overlayCanvas.height,
      });
      zeroBoxConfirmPanel.classList.add('hidden');
    }
    drawOverlayRedactions();
  });

  prevPageBtn.addEventListener('click', async () => {
    if (currentPageNum > 1) {
      currentPageNum--;
      await renderCurrentPage();
    }
  });
  nextPageBtn.addEventListener('click', async () => {
    if (currentPageNum < totalPages) {
      currentPageNum++;
      await renderCurrentPage();
    }
  });

  undoBtn.addEventListener('click', () => {
    for (let i = redactions.length - 1; i >= 0; i--) {
      if (redactions[i].pageNumber === currentPageNum) {
        redactions.splice(i, 1);
        drawOverlayRedactions();
        break;
      }
    }
  });

  clearBtn.addEventListener('click', () => {
    redactions = redactions.filter((r) => r.pageNumber !== currentPageNum);
    risksBanner.classList.add('hidden');
    drawOverlayRedactions();
  });

  autoDetectBtn.addEventListener('click', runAutoDetect);

  async function runAutoDetect() {
    if (!currentPdfBytes) return;
    hideStatus();
    const analysis = await analyzePdfRisks(currentPdfBytes.slice(0));
    if (analysis.detectedRisks.length > 0) {
      risksCountText.textContent = `⚠️ 個人情報・機密テキストを ${analysis.detectedRisks.length} 箇所検出しました（黒塗り枠を自動配置）`;
      risksBanner.classList.remove('hidden');
      zeroBoxConfirmPanel.classList.add('hidden');

      for (const risk of analysis.detectedRisks) {
        redactions.push({
          pageNumber: risk.pageNumber,
          x: risk.box.x,
          y: risk.box.y,
          width: risk.box.width,
          height: risk.box.height,
          textPreview: risk.text,
        });
      }
      drawOverlayRedactions();
    } else {
      showStatus('ℹ️ マイナンバー・電話・メール等の自動パターンは見つかりませんでした。プレビュー上で直接ドラッグして黒塗り枠を追加してください。', 'info');
    }
  }

  async function performRedaction() {
    if (!currentPdfBytes) return;
    zeroBoxConfirmPanel.classList.add('hidden');
    hideStatus();
    executeBtn.disabled = true;
    executeBtn.innerHTML = `<span>⏳</span><span>高精細ラスタライズ処理中...</span>`;

    try {
      const { pdfBytes, totalRedactionsApplied } = await renderRedactedPdf(currentPdfBytes.slice(0), redactions);

      const blob = new Blob([pdfBytes], { type: 'application/pdf' });
      const url = URL.createObjectURL(blob);
      const a = document.createElement('a');
      a.href = url;
      const dotIdx = currentFileName.lastIndexOf('.');
      a.download = dotIdx !== -1 ? `${currentFileName.slice(0, dotIdx)}_redacted.pdf` : `${currentFileName}_redacted.pdf`;
      document.body.appendChild(a);
      a.click();
      document.body.removeChild(a);
      URL.revokeObjectURL(url);

      showStatus(
        `✔ 不可逆黒塗り完了！${totalRedactionsApplied} 箇所の画素を破壊し、テキスト層を含まないPDFを保存しました。提出前にダウンロード結果を必ず目視確認してください。`,
        'success'
      );
    } catch (err: any) {
      showStatus(`❌ 処理中にエラーが発生しました: ${err?.message || 'PDFの変換に失敗しました'}`, 'error');
    } finally {
      executeBtn.disabled = false;
      executeBtn.innerHTML = `<span aria-hidden="true">⬛</span><span>完全黒塗りを実行してPDFを保存 (通信0バイト)</span>`;
    }
  }

  executeBtn.addEventListener('click', async () => {
    if (!currentPdfBytes) return;
    if (redactions.length === 0) {
      zeroBoxConfirmPanel.classList.remove('hidden');
      zeroBoxConfirmPanel.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
      return;
    }
    await performRedaction();
  });

  confirmZeroBoxBtn.addEventListener('click', performRedaction);
  cancelZeroBoxBtn.addEventListener('click', () => {
    zeroBoxConfirmPanel.classList.add('hidden');
  });
</script>
