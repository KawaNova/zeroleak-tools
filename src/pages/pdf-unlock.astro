---
import Layout from '../layouts/Layout.astro';
import SecuritySpecModal from '../components/SecuritySpecModal.astro';

// SGO / Googleリッチリザルト用 構造化データ
const extraSchemaGraph = [
  {
    "@type": "HowTo",
    "name": "給与明細・源泉徴収票のPDFパスワードを安全に解除する3ステップ",
    "description": "住宅ローンや確定申告(e-Tax)提出用に、ブラウザ内だけで外部送信0バイトでPDFから知っているパスワードを除去する手順。",
    "step": [
      {
        "@type": "HowToStep",
        "name": "暗号化PDFをドラッグ＆ドロップ",
        "text": "パスワード保護された給与明細や源泉徴収票のPDFファイルをドロップゾーンに配置します。"
      },
      {
        "@type": "HowToStep",
        "name": "知っているパスワードを入力",
        "text": "会社や給与ソフトから通知されている閲覧用パスワードを入力します。"
      },
      {
        "@type": "HowToStep",
        "name": "パスワードなしPDFをダウンロード",
        "text": "ブラウザ内で300DPI高精細再構築されたパスワード保護のないPDFを保存します。金融機関や税務署にそのまま提出可能です。"
      }
    ]
  },
  {
    "@type": "FAQPage",
    "mainEntity": [
      {
        "@type": "Question",
        "name": "なぜ住宅ローン審査やe-Taxでパスワード付きPDFが拒否されるのですか？",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "多くの金融機関（みずほ銀行、三菱UFJ銀行、三井住友銀行、住信SBIネット銀行など）や国税庁e-Taxのオンライン受付システムでは、アップロードされたPDFを機械的に自動仕分け・OCR解析するため、パスワード保護がかかっているとシステムエラーとなります。そのため、事前に正規のパスワードを除去した無防備な平文PDFの提出が必須となっています。"
        }
      },
      {
        "@type": "Question",
        "name": "iLovePDFやSmallpdfなどの無料Webサイトで給与明細を解除するのは危険ですか？",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "一般的な無料PDFツールは、一度ファイルを海外のクラウドサーバーへアップロードして処理します。源泉徴収票や給与明細には、年収、マイナンバー、家族構成、住所、勤務先などの極めて重大な個人情報が記載されており、外部サーバーへのアップロードは情報漏洩リスクや企業の就業規則違反（懲戒対象）となる恐れがあります。ZeroLeak Toolsはサーバー送信が0バイト（ブラウザ内メモリ完結）のため、漏洩リスク0%で安全に処理できます。"
        }
      },
      {
        "@type": "Question",
        "name": "パスワードがわからないPDFでも解除（クラッキング）できますか？",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "いいえ、できません。本ツールは不正アクセス防止のため、ご自身が正規の閲覧権限およびパスワードを知っているファイルから、提出便宜のためにパスワード保護を除去するための専用ツールです。総当たり攻撃等のクラッキング機能は備えていません。"
        }
      },
      {
        "@type": "Question",
        "name": "社内のパソコンや情シスの監視下でも安全に使えますか？",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "はい。ブラウザのF12開発者ツール（Networkタブ）でご確認いただける通り、本ツールの使用中に外部サーバーへの通信（POST/GETリクエスト）は1バイトも発生しません。インターネット回線を切断したオフライン状態（機内モード）でもそのまま動作します。"
        }
      }
    ]
  }
];
---

<Layout
  title="給与明細・源泉徴収票 PDF パスワード安全解除（知っているパスワードの除去）ツール"
  description="住宅ローンや確定申告提出用にPDFパスワードをローカル環境で安全解除。外部サーバー送信0バイト・情報漏洩リスク0%で知っているパスワードを除去。"
  canonicalPath="/pdf-unlock/"
  extraSchemaGraph={extraSchemaGraph}
>
  <div class="max-w-4xl mx-auto space-y-8">
    
    <!-- ツールタイトル & 狙い -->
    <div class="space-y-3">
      <div class="flex flex-wrap items-center justify-between gap-2">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-teal-500/10 border border-teal-500/30 text-teal-300 text-xs font-semibold">
          <span>完全ローカル処理</span>
          <span>•</span>
          <span>給与明細・源泉徴収票特化</span>
          <span>•</span>
          <span>サーバー送信0バイト</span>
        </div>
        
        <!-- 情シス向けセキュリティ仕様書 ボタン -->
        <button
          type="button"
          onclick="window.openSecurityModal && window.openSecurityModal()"
          class="inline-flex items-center gap-1.5 px-3 py-1 rounded-lg bg-slate-800 hover:bg-slate-700 text-slate-300 hover:text-white text-xs border border-slate-700 transition cursor-pointer"
        >
          <span>🏢</span>
          <span>社内利用・情シス申請用仕様書</span>
        </button>
      </div>

      <h1 class="text-3xl sm:text-4xl font-extrabold text-white tracking-tight">
        給与明細・源泉徴収票 PDF パスワード安全解除
      </h1>
      <p class="text-slate-300 text-sm sm:text-base leading-relaxed">
        住宅ローンの本審査や確定申告（e-Tax）への提出時に、パスワード付きPDFの受け入れを拒否される問題を一発解決。
        <strong>iLovePDF等の海外クラウドにアップロードせず、お使いのブラウザ内（WASM/JS）だけで既知のパスワードを安全に除去</strong>します。
      </p>
    </div>

    <!-- メイン操作カード -->
    <div class="bg-slate-900 border border-slate-800 rounded-2xl p-6 shadow-xl space-y-6">
      
      <!-- ファイルドロップゾーン -->
      <div id="dropZonePdf" class="border-2 border-dashed border-slate-700 hover:border-emerald-500/60 rounded-2xl p-8 text-center transition bg-slate-950/40 cursor-pointer group">
        <input type="file" id="fileInputPdf" accept=".pdf" class="hidden" />
        <div class="flex flex-col items-center gap-3 pointer-events-none">
          <div class="w-14 h-14 rounded-2xl bg-emerald-500/10 border border-emerald-500/30 flex items-center justify-center text-emerald-400 group-hover:scale-105 transition-transform">
            <svg class="w-7 h-7" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
            </svg>
          </div>
          <div>
            <p class="font-bold text-slate-200 text-base">パスワード保護されたPDFをここにドロップ</p>
            <p class="text-xs text-slate-400 mt-1">またはクリックしてファイルを選択 (.pdf)</p>
          </div>
          <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-slate-800 text-[11px] text-slate-400">
            <span>🔒 ファイルは端末の外へ一切送信されません</span>
          </div>
        </div>
      </div>

      <!-- テスト用サンプルPDF クイック投入ボタン（手元にファイルがない人向け） -->
      <div class="flex flex-col sm:flex-row items-center justify-between gap-3 p-3.5 rounded-xl bg-slate-950/70 border border-slate-800 text-xs">
        <div class="flex items-center gap-2 text-slate-300">
          <span class="text-base">🧪</span>
          <span><strong>テスト用PDFをお持ちでない場合：</strong> 暗号化済みサンプル給与明細（解除パスワード: <code class="text-emerald-400 bg-slate-900 px-1 py-0.5 rounded font-mono font-bold">test2026</code>）で今すぐ動作確認できます</span>
        </div>
        <div class="flex items-center gap-2 w-full sm:w-auto">
          <button
            id="loadSamplePdfBtn"
            type="button"
            class="flex-1 sm:flex-none px-4 py-2 rounded-lg bg-teal-500/20 hover:bg-teal-500/30 text-teal-300 border border-teal-500/40 font-bold transition flex items-center justify-center gap-1.5 cursor-pointer shadow-sm"
          >
            <span>サンプルPDFを読み込む</span>
          </button>
          <a
            href="/sample_payslip_protected.pdf"
            download="sample_payslip_protected.pdf"
            class="px-3 py-2 rounded-lg bg-slate-800 hover:bg-slate-700 text-slate-300 transition text-center whitespace-nowrap"
            title="暗号化サンプルPDFをPCに保存"
          >
            📥 PDF保存
          </a>
        </div>
      </div>

      <!-- 選択されたファイル表示 -->
      <div id="fileInfoPdf" class="hidden p-4 rounded-xl bg-slate-800/60 border border-slate-700 flex flex-col sm:flex-row items-center justify-between gap-3">
        <div class="flex items-center gap-3">
          <div class="w-9 h-9 rounded-lg bg-emerald-500/20 text-emerald-400 flex items-center justify-center font-bold text-xs">PDF</div>
          <div>
            <p id="fileNamePdf" class="text-sm font-semibold text-slate-200">pay_slip.pdf</p>
            <p id="fileMetaPdf" class="text-xs text-slate-400">サイズ: 0 KB</p>
          </div>
        </div>
        <button id="resetPdfBtn" type="button" class="text-xs text-slate-400 hover:text-rose-400 underline transition cursor-pointer">
          ファイルを変更
        </button>
      </div>

      <!-- パスワード入力フォーム -->
      <div id="passwordArea" class="hidden space-y-4 p-5 rounded-xl bg-slate-950/60 border border-slate-800">
        <div>
          <label for="pdfPasswordInput" class="block text-xs font-bold text-slate-200 mb-1.5">
            🔑 設定されているパスワードを入力してください：
          </label>
          <div class="relative">
            <input
              type="password"
              id="pdfPasswordInput"
              placeholder="知っているパスワード（誕生日、社員番号など）を入力"
              class="w-full bg-slate-900 border border-slate-700 focus:border-emerald-500 rounded-xl px-4 py-3 text-sm text-slate-100 focus:outline-none pr-10 font-mono"
            />
            <button
              type="button"
              id="togglePasswordVisibility"
              class="absolute right-3 top-3 text-slate-400 hover:text-slate-200 text-xs cursor-pointer"
            >
              👁️
            </button>
          </div>
          <p id="passwordHint" class="text-[11px] text-slate-400 mt-1.5">
            ※ 本ツールはパスワードクラッキング（総当たり攻撃）ツールではありません。ご自身が閲覧権限を持つパスワードを入力してください。
          </p>
        </div>

        <div id="errorMessage" class="hidden p-3 rounded-xl bg-rose-950/50 border border-rose-500/50 text-rose-300 text-xs font-semibold">
          <!-- エラー内容 -->
        </div>

        <button
          id="unlockBtn"
          type="button"
          class="w-full sm:w-auto px-8 py-3.5 rounded-xl font-bold text-white bg-gradient-to-r from-emerald-600 to-teal-600 hover:from-emerald-500 hover:to-teal-500 transition shadow-lg shadow-emerald-950/50 flex items-center justify-center gap-2 text-sm sm:text-base cursor-pointer"
        >
          <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 11V7a4 4 0 118 0m-4 8v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2z" />
          </svg>
          <span>パスワードを安全に解除して再生成 (ブラウザ内処理)</span>
        </button>
      </div>

      <!-- 処理中インジケータ -->
      <div id="processingIndicator" class="hidden text-center py-6 space-y-3">
        <div class="inline-block w-8 h-8 border-3 border-emerald-500 border-t-transparent rounded-full animate-spin"></div>
        <p class="text-xs text-emerald-400 font-semibold">ブラウザ内で高画質再生成中... (外部通信0件)</p>
      </div>

      <!-- 解除完了 ＆ ダウンロードカード -->
      <div id="successArea" class="hidden p-6 rounded-xl bg-emerald-950/30 border border-emerald-500/40 space-y-4">
        <div class="flex items-center gap-3">
          <div class="w-10 h-10 rounded-full bg-emerald-500/20 text-emerald-400 flex items-center justify-center text-xl">
            🎉
          </div>
          <div>
            <h2 class="text-base font-bold text-emerald-300">パスワードの解除が完了しました！</h2>
            <p id="successTimeText" class="text-xs text-slate-300 font-mono mt-0.5">処理完了: 0.8秒 (通信0バイト)</p>
          </div>
        </div>

        <p class="text-xs text-slate-300 leading-relaxed">
          パスワード保護のない無防備な状態の新しいPDFが生成されました。住宅ローンのマイページや確定申告（e-Tax）等へそのままアップロード可能です。
        </p>

        <div class="pt-2">
          <button
            id="downloadUnlockedPdfBtn"
            type="button"
            class="w-full sm:w-auto px-6 py-3 rounded-xl font-bold text-sm text-slate-950 bg-emerald-400 hover:bg-emerald-300 transition shadow flex items-center justify-center gap-2 cursor-pointer"
          >
            <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4" />
            </svg>
            <span>パスワード解除済みPDFをダウンロード</span>
          </button>
        </div>
      </div>

    </div>

    <!-- 【pSEO & SEO】主要提出先別（金融機関・e-Tax）の受領要件ガイド -->
    <section class="space-y-4 pt-4">
      <div class="border-b border-slate-800 pb-2">
        <h2 class="text-lg sm:text-xl font-bold text-white flex items-center gap-2">
          <span>🏛️</span>
          <span>主要金融機関 ＆ 確定申告（e-Tax）のPDF受領要件</span>
        </h2>
        <p class="text-xs text-slate-400 mt-1">「パスワード付きPDFでエラーが出る」各サービスの提出ルール一覧</p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-4 text-xs">
        <div class="p-4 rounded-xl bg-slate-900/60 border border-slate-800 space-y-2">
          <h3 class="font-bold text-teal-300 text-sm">ネット銀行（住信SBI / auじぶん / 楽天銀行 / PayPay銀行）</h3>
          <p class="text-slate-300 leading-relaxed">
            <strong>事前審査・本審査フォームでアップロード不可：</strong>
            マイページからの収入証明書類（源泉徴収票・給与明細）アップロード時、暗号化ファイルはシステムで即座にエラー判定されます。事前に本ツールでパスワードを解除したファイルをご用意ください。
          </p>
        </div>

        <div class="p-4 rounded-xl bg-slate-900/60 border border-slate-800 space-y-2">
          <h3 class="font-bold text-teal-300 text-sm">メガバンク（三菱UFJ / 三井住友 / みずほ銀行）</h3>
          <p class="text-slate-300 leading-relaxed">
            <strong>Web審査窓口での指定：</strong>
            各行のWeb完結型住宅ローン申し込みにおいて、「セキュリティ解除済みのPDFまたは画像」の提出が明記されています。パスワードをメモ書きで送ることは不可とされています。
          </p>
        </div>

        <div class="p-4 rounded-xl bg-slate-900/60 border border-slate-800 space-y-2">
          <h3 class="font-bold text-teal-300 text-sm">国税庁 e-Tax（確定申告・医療費控除）</h3>
          <p class="text-slate-300 leading-relaxed">
            <strong>電子申告での添付書類：</strong>
            マイナポータル連携外の源泉徴収票や支払調書PDFを添付する場合、暗号化PDFは税務署側の審査システムで開封できないため、パスワード解除後のPDF添付が必須です。
          </p>
        </div>

        <div class="p-4 rounded-xl bg-slate-900/60 border border-slate-800 space-y-2">
          <h3 class="font-bold text-teal-300 text-sm">給与明細SaaS（SmartHR / マネーフォワード / freee）</h3>
          <p class="text-slate-300 leading-relaxed">
            <strong>会社から配布される暗号化PDF：</strong>
            多くの人事労務SaaSからダウンロードされる給与明細は「誕生日4桁」や「社員番号」等で自動暗号化されています。本ツールで知っているパスワードを入力するだけで一瞬で解除できます。
          </p>
        </div>
      </div>
    </section>

    <!-- 【FAQPage】よくある質問アコーディオン -->
    <section class="space-y-4 pt-2">
      <div class="border-b border-slate-800 pb-2">
        <h2 class="text-lg sm:text-xl font-bold text-white flex items-center gap-2">
          <span>❓</span>
          <span>よくある質問（FAQ）</span>
        </h2>
      </div>

      <div class="space-y-3 text-xs sm:text-sm text-slate-300">
        <details class="group p-4 rounded-xl bg-slate-900/50 border border-slate-800 hover:border-slate-700">
          <summary class="font-bold text-slate-200 cursor-pointer flex items-center justify-between">
            <span>Q. なぜ住宅ローン審査でパスワード付きPDFが拒否されるのですか？</span>
            <span class="text-emerald-400 group-open:rotate-180 transition-transform">▼</span>
          </summary>
          <p class="mt-3 text-slate-400 leading-relaxed text-xs">
            多くの金融機関のオンライン事前審査システムでは、アップロードされたPDFを機械的にOCR処理・自動仕分けするため、パスワード保護がかかっているとシステムがエラーを吐き出して受け入れを拒否します。そのため事前にパスワードを解除した平文PDFの提出が求められます。
          </p>
        </details>

        <details class="group p-4 rounded-xl bg-slate-900/50 border border-slate-800 hover:border-slate-700">
          <summary class="font-bold text-slate-200 cursor-pointer flex items-center justify-between">
            <span>Q. iLovePDFやSmallpdfなどの無料Webサイトで解除するのは危険ですか？</span>
            <span class="text-emerald-400 group-open:rotate-180 transition-transform">▼</span>
          </summary>
          <p class="mt-3 text-slate-400 leading-relaxed text-xs">
            一般的な無料PDFツールは、一度ファイルを運営企業の海外クラウドサーバーへアップロードして処理します。源泉徴収票や給与明細には、年収、マイナンバー、家族構成、住所、勤務先などの極めて重大な個人情報が記載されており、外部サーバーへのアップロードは情報漏洩リスクや社内規定違反（懲戒対象）となる恐れがあります。ZeroLeak Toolsはサーバー送信が0バイト（ブラウザ内メモリ完結）のため、安全に処理できます。
          </p>
        </details>

        <details class="group p-4 rounded-xl bg-slate-900/50 border border-slate-800 hover:border-slate-700">
          <summary class="font-bold text-slate-200 cursor-pointer flex items-center justify-between">
            <span>Q. パスワードがわからないPDFでも解除（クラッキング）できますか？</span>
            <span class="text-emerald-400 group-open:rotate-180 transition-transform">▼</span>
          </summary>
          <p class="mt-3 text-slate-400 leading-relaxed text-xs">
            いいえ、できません。本ツールは不正アクセス防止のため、ご自身が正規の閲覧権限およびパスワードを知っているファイルから、提出便宜のためにパスワード保護を除去するための専用ツールです。総当たり攻撃等のクラッキング機能は備えていません。
          </p>
        </details>

        <details class="group p-4 rounded-xl bg-slate-900/50 border border-slate-800 hover:border-slate-700">
          <summary class="font-bold text-slate-200 cursor-pointer flex items-center justify-between">
            <span>Q. 社内のパソコンや情シスの監視下でも安全に使えますか？</span>
            <span class="text-emerald-400 group-open:rotate-180 transition-transform">▼</span>
          </summary>
          <p class="mt-3 text-slate-400 leading-relaxed text-xs">
            はい。ブラウザのF12開発者ツール（Networkタブ）でご確認いただける通り、本ツールの使用中に外部サーバーへの通信（POST/GETリクエスト）は1バイトも発生しません。インターネット回線を切断したオフライン状態（機内モード）でもそのまま動作します。
          </p>
        </details>
      </div>
    </section>

  </div>

  <!-- セキュリティ仕様書モーダル -->
  <SecuritySpecModal />

  <!-- クライアントサイドスクリプト -->
  <script>
    import * as pdfjsLib from 'pdfjs-dist';
    import { PDFDocument } from 'pdf-lib';

    try {
      pdfjsLib.GlobalWorkerOptions.workerSrc = new URL(
        'pdfjs-dist/build/pdf.worker.mjs',
        import.meta.url
      ).toString();
    } catch (e) {
      console.warn('Worker URL fallback initialized');
    }

    let selectedFile: { name: string; size: number } | null = null;
    let fileBuffer: ArrayBuffer | null = null;
    let unlockedPdfBytes: Uint8Array | null = null;

    // DOM要素
    const dropZone = document.getElementById('dropZonePdf')!;
    const fileInput = document.getElementById('fileInputPdf') as HTMLInputElement;
    const fileInfo = document.getElementById('fileInfoPdf')!;
    const fileName = document.getElementById('fileNamePdf')!;
    const fileMeta = document.getElementById('fileMetaPdf')!;
    const resetPdfBtn = document.getElementById('resetPdfBtn')!;
    const passwordArea = document.getElementById('passwordArea')!;
    const pdfPasswordInput = document.getElementById('pdfPasswordInput') as HTMLInputElement;
    const togglePasswordVisibility = document.getElementById('togglePasswordVisibility')!;
    const unlockBtn = document.getElementById('unlockBtn')!;
    const errorMessage = document.getElementById('errorMessage')!;
    const processingIndicator = document.getElementById('processingIndicator')!;
    const successArea = document.getElementById('successArea')!;
    const successTimeText = document.getElementById('successTimeText')!;
    const downloadUnlockedPdfBtn = document.getElementById('downloadUnlockedPdfBtn')!;
    const loadSamplePdfBtn = document.getElementById('loadSamplePdfBtn')!;

    // パスワード表示トグル
    togglePasswordVisibility.addEventListener('click', () => {
      if (pdfPasswordInput.type === 'password') {
        pdfPasswordInput.type = 'text';
        togglePasswordVisibility.textContent = '🙈';
      } else {
        pdfPasswordInput.type = 'password';
        togglePasswordVisibility.textContent = '👁️';
      }
    });

    // サンプルPDF読み込みボタン
    loadSamplePdfBtn.addEventListener('click', async () => {
      try {
        const res = await fetch('/sample_payslip_protected.pdf');
        fileBuffer = await res.arrayBuffer();
        selectedFile = {
          name: 'sample_payslip_protected.pdf',
          size: fileBuffer.byteLength,
        };
        fileName.textContent = selectedFile.name;
        fileMeta.textContent = `サイズ: ${(selectedFile.size / 1024).toFixed(1)} KB (暗号化サンプル)`;

        dropZone.classList.add('hidden');
        fileInfo.classList.remove('hidden');
        passwordArea.classList.remove('hidden');
        errorMessage.classList.add('hidden');
        successArea.classList.add('hidden');
        
        pdfPasswordInput.value = 'test2026';
        pdfPasswordInput.focus();
      } catch (err) {
        alert('サンプルPDFの取得に失敗しました。');
      }
    });

    // D&D & ファイル選択
    dropZone.addEventListener('click', () => fileInput.click());
    dropZone.addEventListener('dragover', (e) => {
      e.preventDefault();
      dropZone.classList.add('border-emerald-500');
    });
    dropZone.addEventListener('dragleave', () => dropZone.classList.remove('border-emerald-500'));
    dropZone.addEventListener('drop', (e) => {
      e.preventDefault();
      dropZone.classList.remove('border-emerald-500');
      if (e.dataTransfer?.files && e.dataTransfer.files[0]) {
        handlePdfFile(e.dataTransfer.files[0]);
      }
    });
    fileInput.addEventListener('change', () => {
      if (fileInput.files && fileInput.files[0]) {
        handlePdfFile(fileInput.files[0]);
      }
    });

    resetPdfBtn.addEventListener('click', () => {
      selectedFile = null;
      fileBuffer = null;
      unlockedPdfBytes = null;
      fileInput.value = '';
      pdfPasswordInput.value = '';
      fileInfo.classList.add('hidden');
      passwordArea.classList.add('hidden');
      errorMessage.classList.add('hidden');
      successArea.classList.add('hidden');
      dropZone.classList.remove('hidden');
    });

    function handlePdfFile(file: File) {
      if (!file.name.toLowerCase().endsWith('.pdf')) {
        alert('PDFファイルを選択してください。');
        return;
      }

      selectedFile = { name: file.name, size: file.size };
      fileName.textContent = file.name;
      fileMeta.textContent = `サイズ: ${(file.size / 1024).toFixed(1)} KB`;

      const reader = new FileReader();
      reader.onload = async (e) => {
        fileBuffer = e.target?.result as ArrayBuffer;
        dropZone.classList.add('hidden');
        fileInfo.classList.remove('hidden');
        passwordArea.classList.remove('hidden');
        errorMessage.classList.add('hidden');
        successArea.classList.add('hidden');
        pdfPasswordInput.value = '';
        pdfPasswordInput.focus();
      };
      reader.readAsArrayBuffer(file);
    }

    // パスワード解除処理
    unlockBtn.addEventListener('click', async () => {
      if (!fileBuffer) return;
      const password = pdfPasswordInput.value;
      if (!password) {
        showError('パスワードを入力してください。');
        return;
      }

      errorMessage.classList.add('hidden');
      passwordArea.classList.add('hidden');
      processingIndicator.classList.remove('hidden');

      const startTime = performance.now();

      try {
        const loadingTask = pdfjsLib.getDocument({
          data: new Uint8Array(fileBuffer),
          password: password,
          useWorkerFetch: false,
          isEvalSupported: false,
        });

        const pdfDoc = await loadingTask.promise;
        const numPages = pdfDoc.numPages;

        const outPdfDoc = await PDFDocument.create();

        for (let pageNum = 1; pageNum <= numPages; pageNum++) {
          const page = await pdfDoc.getPage(pageNum);
          const scale = 3.0; // 300 DPI 相当の高精細
          const viewport = page.getViewport({ scale });

          const canvas = document.createElement('canvas');
          canvas.width = viewport.width;
          canvas.height = viewport.height;
          const context = canvas.getContext('2d')!;

          await page.render({
            canvasContext: context,
            viewport: viewport,
          }).promise;

          const imgDataUrl = canvas.toDataURL('image/png');
          const pngImageBytes = await fetch(imgDataUrl).then(res => res.arrayBuffer());
          const embeddedImage = await outPdfDoc.embedPng(pngImageBytes);

          const originalViewport = page.getViewport({ scale: 1.0 });
          const newPage = outPdfDoc.addPage([originalViewport.width, originalViewport.height]);
          newPage.drawImage(embeddedImage, {
            x: 0,
            y: 0,
            width: originalViewport.width,
            height: originalViewport.height,
          });
        }

        unlockedPdfBytes = await outPdfDoc.save();

        const elapsed = ((performance.now() - startTime) / 1000).toFixed(2);
        successTimeText.textContent = `⚡ 処理完了: ${elapsed}秒 (${numPages}ページ処理・外部通信0バイト)`;
        
        processingIndicator.classList.add('hidden');
        successArea.classList.remove('hidden');
        successArea.scrollIntoView({ behavior: 'smooth' });

      } catch (err: any) {
        processingIndicator.classList.add('hidden');
        passwordArea.classList.remove('hidden');

        if (err?.name === 'PasswordException' || err?.message?.includes('Password') || err?.code === 1) {
          showError('パスワードが正しくありません。正しいパスワードをご確認の上、再度お試しください。');
        } else {
          showError(`PDFの解析・解除中にエラーが発生しました: ${err?.message || '不明なエラー'}`);
        }
      }
    });

    function showError(msg: string) {
      errorMessage.textContent = msg;
      errorMessage.classList.remove('hidden');
    }

    // ダウンロード
    downloadUnlockedPdfBtn.addEventListener('click', () => {
      if (!unlockedPdfBytes || !selectedFile) return;

      const blob = new Blob([unlockedPdfBytes], { type: 'application/pdf' });
      const url = URL.createObjectURL(blob);
      const a = document.createElement('a');
      a.href = url;
      a.download = selectedFile.name.replace(/\.[^/.]+$/, "") + "_unlocked.pdf";
      document.body.appendChild(a);
      a.click();
      document.body.removeChild(a);
      URL.revokeObjectURL(url);
    });
  </script>
</Layout>
