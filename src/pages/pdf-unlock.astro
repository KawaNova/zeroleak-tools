---
import Layout from '../layouts/Layout.astro';
import SecuritySpecModal from '../components/SecuritySpecModal.astro';
import RelatedTools from '../components/RelatedTools.astro';

// SGO / Googleリッチリザルト用 構造化データ
const extraSchemaGraph = [
  {
    "@type": "HowTo",
    "name": "給与明細・機密PDFのパスワード解除＆メタデータ削除をブラウザで一括完結する3ステップ（サーバー送信なし）",
    "description": "住宅ローンや確定申告(e-Tax)・取引先提出用に、外部サーバーへ1バイトも送信せずブラウザ内だけでPDFの既知パスワード解除および作成者名・ソフト名などのプロパティ（メタデータ）を一括抹消する手順。",
    "step": [
      {
        "@type": "HowToStep",
        "name": "PDFファイルをドラッグ＆ドロップ",
        "text": "パスワード保護された給与明細・源泉徴収票や、作成者メタデータを消去したい機密PDFをドロップゾーンに配置します。"
      },
      {
        "@type": "HowToStep",
        "name": "パスワード入力（暗号化PDFの場合）とメタデータ検出確認",
        "text": "パスワード付きPDFの場合は既知のパスワードを入力します。パスワードがない通常PDFの場合はそのままメタデータ（作成者・タイトル・作成ソフト・更新履歴）の消去に進めます。"
      },
      {
        "@type": "HowToStep",
        "name": "パスワード＆メタデータ完全抹消PDFをダウンロード",
        "text": "ブラウザ内で300DPI高精細再構築され、パスワードおよびAuthor/Creator/Producer等の全メタデータが初期化されたクリーンなPDFを保存します。"
      }
    ]
  },
  {
    "@type": "FAQPage",
    "mainEntity": [
      {
        "@type": "Question",
        "name": "なぜ住宅ローン審査やe-Taxでパスワード付きPDFが拒否されるのですか？",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "多くの金融機関（みずほ銀行、三菱UFJ銀行、三井住友銀行、住信SBIネット銀行など）や国税庁e-Taxのオンライン受付システムでは、アップロードされたPDFを機械的に自動仕分け・OCR解析するため、パスワード保護がかかっているとシステムエラーとなります。そのため、事前に正規のパスワードを除去した平文PDFの提出が必須となっています。"
        }
      },
      {
        "@type": "Question",
        "name": "PDFのメタデータ（プロパティ情報）を削除しないとどんな情報漏洩リスクがありますか？",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "WordやExcel、会計・人事ソフトから出力されたPDFの内部プロパティ（Document Information Dictionary / XMP）には、目に見えない『作成者名（個人のフルネームやPCのログインID）』『元のファイル名（例：〇〇社_裏見積.xlsx）』『使用ソフト・OS』『作成・更新日時』が自動的に記録されています。本ツールは白紙のPDF構造から再生成し、全プロパティを空文字に初期化するため、取引先や外部提出時のうっかり情報漏洩を100%防げます。"
        }
      },
      {
        "@type": "Question",
        "name": "iLovePDFやSmallpdfなどの無料Webサイトで給与明細を解除するのは危険ですか？",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "一般的な無料PDFツールは、一度ファイルを海外のクラウドサーバーへアップロードして処理します。源泉徴収票や給与明細には、年収、マイナンバー、家族構成、住所、勤務先などの極めて重大な個人情報が記載されており、外部サーバーへのアップロードは情報漏洩リスクや企業の就業規則違反（懲戒対象）となる恐れがあります。ZeroLeak Toolsはサーバー送信なし（0バイト・ブラウザ内メモリ完結）のため、漏洩リスク0%で安全に処理できます。"
        }
      },
      {
        "@type": "Question",
        "name": "パスワードがかかっていない普通のPDFのメタデータ（作成者名など）だけを削除することもできますか？",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "はい、可能です。パスワード保護されていないPDFをドロップした場合、パスワード入力欄を空欄のまま『パスワード解除＆メタデータ一括抹消を実行』ボタンを押すだけで、内部の作成者名・タイトル・作成ソフト・しおり・隠し注釈をすべて消去したクリーンなPDFを生成できます。"
        }
      }
    ]
  }
];
---

<Layout
  title="給与明細・機密PDF パスワード解除＆メタデータ削除｜一括・ブラウザ完結・サーバー送信なし"
  description="住宅ローンや確定申告(e-Tax)提出用のPDFパスワード解除と、作成者名・タイトル・ソフト名等のPDFメタデータ（プロパティ）削除をブラウザ内で一括実行。サーバー送信なし（0バイト保証）・情報漏洩リスク0%。"
  canonicalPath="/pdf-unlock/"
  extraSchemaGraph={extraSchemaGraph}
>
  <div class="max-w-4xl mx-auto space-y-8">
    
    <!-- ツールタイトル & 狙い（複合キーワード「一括 ブラウザ」「サーバー送信なし」明記） -->
    <div class="space-y-3">
      <div class="flex flex-wrap items-center justify-between gap-2">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-teal-500/10 border border-teal-500/30 text-teal-300 text-xs font-semibold">
          <span>完全ローカル処理</span>
          <span>•</span>
          <span>パスワード除去 ＆ 作成者メタデータ抹消</span>
          <span>•</span>
          <span>サーバー送信なし（0バイト）</span>
        </div>
        
        <!-- 情シス向けセキュリティ仕様書 ボタン -->
        <button
          type="button"
          onclick="window.openSecurityModal && window.openSecurityModal()"
          class="inline-flex items-center gap-1.5 px-3 py-1 rounded-lg bg-slate-800 hover:bg-slate-700 text-slate-300 hover:text-white text-xs border border-slate-700 transition cursor-pointer"
        >
          <span>🏢</span>
          <span>社内利用・情シス申請用仕様書</span>
        </button>
      </div>

      <h1 class="text-2xl sm:text-4xl font-extrabold text-white tracking-tight leading-tight">
        給与明細・機密PDF パスワード解除＆メタデータ削除｜一括・ブラウザ完結・サーバー送信なし
      </h1>
      <p class="text-slate-300 text-sm sm:text-base leading-relaxed">
        住宅ローン審査や確定申告（e-Tax）で拒否される<strong>「パスワード付きPDFの解除」</strong>と、社外提出時に漏洩原因となる<strong>「PDF内部メタデータ（作成者名・PCアカウント名・元ファイル名・作成ソフト履歴）の完全削除」</strong>をブラウザ内だけで一括処理。
        <strong>サーバー送信なし（0バイト）</strong>で安全なクリーンPDFを再生成します。
      </p>
    </div>

    <!-- メイン操作カード -->
    <div class="bg-slate-900 border border-slate-800 rounded-2xl p-6 shadow-xl space-y-6">
      
      <!-- ファイルドロップゾーン -->
      <div id="dropZonePdf" class="border-2 border-dashed border-slate-700 hover:border-emerald-500/60 rounded-2xl p-8 text-center transition bg-slate-950/40 cursor-pointer group">
        <input type="file" id="fileInputPdf" accept=".pdf,application/pdf" class="hidden" />
        <div class="flex flex-col items-center gap-3 pointer-events-none">
          <div class="w-14 h-14 rounded-2xl bg-emerald-500/10 border border-emerald-500/30 flex items-center justify-center text-emerald-400 group-hover:scale-105 transition-transform">
            <svg class="w-7 h-7" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
            </svg>
          </div>
          <div>
            <p class="font-bold text-slate-200 text-base">パスワード付きPDF または メタデータを消したいPDFをドロップ</p>
            <p class="text-xs text-slate-400 mt-1">またはクリックしてファイルを選択 (.pdf) • パスワードなしPDFのプロパティ消去単体にも対応</p>
          </div>
          <div class="flex flex-wrap items-center justify-center gap-2">
            <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-slate-800 text-[11px] text-emerald-300 border border-emerald-500/20">
              🔒 サーバー送信なし（0バイト保証）
            </span>
            <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-slate-800 text-[11px] text-slate-400">
              🧹 Author / Title / Creator / XMP 自動抹消
            </span>
          </div>
        </div>
      </div>

      <!-- テスト用サンプルPDF クイック投入ボタン（手元にファイルがない人向け） -->
      <div class="flex flex-col sm:flex-row items-center justify-between gap-3 p-3.5 rounded-xl bg-slate-950/70 border border-slate-800 text-xs">
        <div class="flex items-center gap-2 text-slate-300">
          <span class="text-base">🧪</span>
          <span><strong>テスト用PDFをお持ちでない場合：</strong> 暗号化済みサンプル給与明細（パスワード: <code class="text-emerald-400 bg-slate-900 px-1 py-0.5 rounded font-mono font-bold">test2026</code>）で今すぐパスワード解除＆メタデータ抹消を確認できます</span>
        </div>
        <div class="flex items-center gap-2 w-full sm:w-auto">
          <button
            id="loadSamplePdfBtn"
            type="button"
            class="flex-1 sm:flex-none px-4 py-2 rounded-lg bg-teal-500/20 hover:bg-teal-500/30 text-teal-300 border border-teal-500/40 font-bold transition flex items-center justify-center gap-1.5 cursor-pointer shadow-sm whitespace-nowrap"
          >
            <span>サンプルPDFを読み込む</span>
          </button>
          <a
            href="/sample_payslip_protected.pdf"
            download="sample_payslip_protected.pdf"
            class="px-3 py-2 rounded-lg bg-slate-800 hover:bg-slate-700 text-slate-300 transition text-center whitespace-nowrap"
            title="暗号化サンプルPDFをPCに保存"
          >
            📥 PDF保存
          </a>
        </div>
      </div>

      <!-- 選択されたファイル表示 -->
      <div id="fileInfoPdf" class="hidden p-4 rounded-xl bg-slate-800/60 border border-slate-700 flex flex-col sm:flex-row items-center justify-between gap-3">
        <div class="flex items-center gap-3">
          <div class="w-9 h-9 rounded-lg bg-emerald-500/20 text-emerald-400 flex items-center justify-center font-bold text-xs">PDF</div>
          <div>
            <p id="fileNamePdf" class="text-sm font-semibold text-slate-200">pay_slip.pdf</p>
            <p id="fileMetaPdf" class="text-xs text-slate-400">サイズ: 0 KB</p>
          </div>
        </div>
        <button id="resetPdfBtn" type="button" class="text-xs text-slate-400 hover:text-rose-400 underline transition cursor-pointer">
          ファイルを変更
        </button>
      </div>

      <!-- パスワード入力 ＆ メタデータ消去設定フォーム -->
      <div id="passwordArea" class="hidden space-y-4 p-5 rounded-xl bg-slate-950/60 border border-slate-800">
        <div>
          <label for="pdfPasswordInput" class="block text-xs font-bold text-slate-200 mb-1.5">
            🔑 設定されているパスワードを入力してください（パスワードなしPDFの場合は空欄のままでOK）：
          </label>
          <div class="relative">
            <input
              type="password"
              id="pdfPasswordInput"
              placeholder="知っているパスワード（誕生日、社員番号など）※暗号化なしPDFは空欄"
              class="w-full bg-slate-900 border border-slate-700 focus:border-emerald-500 rounded-xl px-4 py-3 text-sm text-slate-100 focus:outline-none pr-10 font-mono"
            />
            <button
              type="button"
              id="togglePasswordVisibility"
              class="absolute right-3 top-3 text-slate-400 hover:text-slate-200 text-xs cursor-pointer"
            >
              👁️
            </button>
          </div>
          <p id="passwordHint" class="text-[11px] text-slate-400 mt-1.5">
            ※ 本ツールはパスワードクラッキング（総当たり攻撃）ツールではありません。ご自身が閲覧権限を持つパスワードを入力してください。
          </p>
        </div>

        <!-- メタデータ・隠し情報 消去項目チェックリスト -->
        <div class="p-3.5 rounded-xl bg-slate-900/90 border border-slate-800 space-y-2">
          <div class="text-xs font-bold text-teal-300 flex items-center gap-1.5">
            <span>🧹</span>
            <span>同時に一括抹消されるPDF内部メタデータ・隠し構造：</span>
          </div>
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-1.5 text-[11px] text-slate-300">
            <div class="flex items-center gap-1.5">
              <span class="text-emerald-400 font-bold">✔</span>
              <span><strong>作成者名 (Author)</strong>：PCユーザー名・社員名</span>
            </div>
            <div class="flex items-center gap-1.5">
              <span class="text-emerald-400 font-bold">✔</span>
              <span><strong>タイトル・件名 (Title / Subject)</strong>：元ファイル名</span>
            </div>
            <div class="flex items-center gap-1.5">
              <span class="text-emerald-400 font-bold">✔</span>
              <span><strong>作成・変換ソフト (Creator / Producer)</strong></span>
            </div>
            <div class="flex items-center gap-1.5">
              <span class="text-emerald-400 font-bold">✔</span>
              <span><strong>XMPメタデータ・隠し注釈・JavaScript構造</strong></span>
            </div>
          </div>
        </div>

        <div id="errorMessage" class="hidden p-3 rounded-xl bg-rose-950/50 border border-rose-500/50 text-rose-300 text-xs font-semibold">
          <!-- エラー内容 -->
        </div>

        <button
          id="unlockBtn"
          type="button"
          class="w-full sm:w-auto px-8 py-3.5 rounded-xl font-bold text-white bg-gradient-to-r from-emerald-600 to-teal-600 hover:from-emerald-500 hover:to-teal-500 transition shadow-lg shadow-emerald-950/50 flex items-center justify-center gap-2 text-sm sm:text-base cursor-pointer"
        >
          <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 11V7a4 4 0 118 0m-4 8v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2z" />
          </svg>
          <span>パスワード解除 ＆ メタデータ一括抹消を実行 (ブラウザ内処理)</span>
        </button>
      </div>

      <!-- 処理中インジケータ -->
      <div id="processingIndicator" class="hidden text-center py-6 space-y-3">
        <div class="inline-block w-8 h-8 border-3 border-emerald-500 border-t-transparent rounded-full animate-spin"></div>
        <p class="text-xs text-emerald-400 font-semibold">ブラウザ内で高画質再生成 ＆ メタデータ完全消去中... (外部通信0件)</p>
      </div>

      <!-- 解除＆メタデータ削除完了 ＆ ダウンロードカード -->
      <div id="successArea" class="hidden p-6 rounded-xl bg-emerald-950/30 border border-emerald-500/40 space-y-4">
        <div class="flex items-center gap-3">
          <div class="w-10 h-10 rounded-full bg-emerald-500/20 text-emerald-400 flex items-center justify-center text-xl">
            🎉
          </div>
          <div>
            <h2 class="text-base font-bold text-emerald-300">パスワード解除 ＆ メタデータの完全抹消が完了しました！</h2>
            <p id="successTimeText" class="text-xs text-slate-300 font-mono mt-0.5">処理完了: 0.8秒 (通信0バイト)</p>
          </div>
        </div>

        <!-- 検出・抹消されたメタデータ監査レポート -->
        <div class="p-4 rounded-xl bg-slate-950/80 border border-slate-800 space-y-2 text-xs">
          <div class="font-bold text-teal-300 flex items-center justify-between">
            <span>🔍 PDF内部メタデータ（プロパティ）検査＆抹消レポート</span>
            <span class="px-2 py-0.5 rounded bg-emerald-500/20 text-emerald-300 text-[10px] font-bold">残存メタデータ 0件</span>
          </div>
          <div id="metadataReportList" class="grid grid-cols-1 sm:grid-cols-2 gap-2 text-[11px] text-slate-300 pt-1">
            <!-- JSでBefore/Afterを表示 -->
          </div>
        </div>

        <p class="text-xs text-slate-300 leading-relaxed">
          パスワード保護および内部プロパティ（作成者・タイトル・履歴）がすべて除去されたクリーンなPDFが生成されました。住宅ローン審査や確定申告（e-Tax）、社外取引先へそのまま安全に提出可能です。
        </p>

        <div class="pt-2">
          <button
            id="downloadUnlockedPdfBtn"
            type="button"
            class="w-full sm:w-auto px-6 py-3 rounded-xl font-bold text-sm text-slate-950 bg-emerald-400 hover:bg-emerald-300 transition shadow flex items-center justify-center gap-2 cursor-pointer"
          >
            <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4" />
            </svg>
            <span>パスワード解除＆メタデータ削除済みPDFを保存</span>
          </button>
        </div>
      </div>

    </div>

    <!-- 【pSEO & SEO】主要提出先別（金融機関・e-Tax）の受領要件ガイド -->
    <section class="space-y-4 pt-4">
      <div class="border-b border-slate-800 pb-2">
        <h2 class="text-lg sm:text-xl font-bold text-white flex items-center gap-2">
          <span>🏛️</span>
          <span>主要金融機関 ＆ 確定申告（e-Tax）・社外提出のPDF要件ガイド</span>
        </h2>
        <p class="text-xs text-slate-400 mt-1">パスワード解除とメタデータ削除が求められる代表的な4つのシーン</p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-4 text-xs">
        <div class="p-4 rounded-xl bg-slate-900/60 border border-slate-800 space-y-2">
          <h3 class="font-bold text-teal-300 text-sm">ネット銀行（住信SBI / auじぶん / 楽天銀行 / PayPay銀行）</h3>
          <p class="text-slate-300 leading-relaxed">
            <strong>事前審査・本審査フォームで暗号化PDFはアップロード不可：</strong>
            マイページからの収入証明書類（源泉徴収票・給与明細）アップロード時、暗号化ファイルはシステムで即座にエラー判定されます。事前に本ツールでパスワードを解除したファイルをご用意ください。
          </p>
        </div>

        <div class="p-4 rounded-xl bg-slate-900/60 border border-slate-800 space-y-2">
          <h3 class="font-bold text-teal-300 text-sm">メガバンク（三菱UFJ / 三井住友 / みずほ銀行）</h3>
          <p class="text-slate-300 leading-relaxed">
            <strong>Web審査窓口でのセキュリティ解除指定：</strong>
            各行のWeb完結型住宅ローン申し込みにおいて、「パスワード保護を解除したPDFまたは画像」の提出が明記されています。パスワードを別送する運用は受け付けられません。
          </p>
        </div>

        <div class="p-4 rounded-xl bg-slate-900/60 border border-slate-800 space-y-2">
          <h3 class="font-bold text-teal-300 text-sm">国税庁 e-Tax ＆ 給与明細SaaS（SmartHR / freee / MF）</h3>
          <p class="text-slate-300 leading-relaxed">
            <strong>人事SaaSの自動暗号化PDFを1クリック平文化：</strong>
            SmartHRやマネーフォワード等から出力される「誕生日4桁」や「社員番号」付きの給与明細PDFを、海外サーバーに送信せず手元のブラウザ内で安全に平文化できます。
          </p>
        </div>

        <div class="p-4 rounded-xl bg-slate-900/60 border border-slate-800 space-y-2">
          <h3 class="font-bold text-teal-300 text-sm">取引先への見積書・契約書PDF提出（メタデータ漏洩防止）</h3>
          <p class="text-slate-300 leading-relaxed">
            <strong>プロパティに残る「作成者名」「社内元ファイル名」を完全抹消：</strong>
            WordやExcelからPDF化したファイルには、作成した社員の氏名や社内管理用の元ファイル名がプロパティに残っています。本ツールを通すことで全メタデータを白紙化できます。
          </p>
        </div>
      </div>
    </section>

    <!-- 【FAQPage】よくある質問アコーディオン -->
    <section class="space-y-4 pt-2">
      <div class="border-b border-slate-800 pb-2">
        <h2 class="text-lg sm:text-xl font-bold text-white flex items-center gap-2">
          <span>❓</span>
          <span>よくある質問（FAQ）</span>
        </h2>
      </div>

      <div class="space-y-3 text-xs sm:text-sm text-slate-300">
        <details class="group p-4 rounded-xl bg-slate-900/50 border border-slate-800 hover:border-slate-700">
          <summary class="font-bold text-slate-200 cursor-pointer flex items-center justify-between">
            <span>Q. なぜ住宅ローン審査でパスワード付きPDFが拒否されるのですか？</span>
            <span class="text-emerald-400 group-open:rotate-180 transition-transform">▼</span>
          </summary>
          <p class="mt-3 text-slate-400 leading-relaxed text-xs">
            多くの金融機関のオンライン事前審査システムでは、アップロードされたPDFを機械的にOCR処理・自動仕分けするため、パスワード保護がかかっているとシステムがエラーを吐き出して受け入れを拒否します。そのため事前にパスワードを解除した平文PDFの提出が求められます。
          </p>
        </details>

        <details class="group p-4 rounded-xl bg-slate-900/50 border border-slate-800 hover:border-slate-700">
          <summary class="font-bold text-slate-200 cursor-pointer flex items-center justify-between">
            <span>Q. PDFのメタデータ（プロパティ）にはどんな危険な情報が入っていますか？</span>
            <span class="text-emerald-400 group-open:rotate-180 transition-transform">▼</span>
          </summary>
          <p class="mt-3 text-slate-400 leading-relaxed text-xs">
            PDFの「文書のプロパティ」には、作成者（Author：PCのアカウント名や社員の実名）、タイトル（Title：変換前のWord/Excelファイル名）、作成プログラム（Creator/Producer）、作成日・更新日が記録されています。本ツールは300DPI再構築とプロパティ空文字初期化により、これらをすべて抹消します。
          </p>
        </details>

        <details class="group p-4 rounded-xl bg-slate-900/50 border border-slate-800 hover:border-slate-700">
          <summary class="font-bold text-slate-200 cursor-pointer flex items-center justify-between">
            <span>Q. iLovePDFやSmallpdfなどの無料Webサイトで解除するのは危険ですか？</span>
            <span class="text-emerald-400 group-open:rotate-180 transition-transform">▼</span>
          </summary>
          <p class="mt-3 text-slate-400 leading-relaxed text-xs">
            一般的な無料PDFツールは、一度ファイルを運営企業の海外クラウドサーバーへアップロードして処理します。源泉徴収票や給与明細には、年収、マイナンバー、家族構成、住所、勤務先などの極めて重大な個人情報が記載されており、外部サーバーへのアップロードは情報漏洩リスクや社内規定違反（懲戒対象）となる恐れがあります。ZeroLeak Toolsはサーバー送信が0バイト（ブラウザ内メモリ完結）のため、安全に処理できます。
          </p>
        </details>

        <details class="group p-4 rounded-xl bg-slate-900/50 border border-slate-800 hover:border-slate-700">
          <summary class="font-bold text-slate-200 cursor-pointer flex items-center justify-between">
            <span>Q. パスワードがかかっていないPDFのメタデータ削除だけに使えますか？</span>
            <span class="text-emerald-400 group-open:rotate-180 transition-transform">▼</span>
          </summary>
          <p class="mt-3 text-slate-400 leading-relaxed text-xs">
            はい。パスワード保護されていないPDFを読み込んだ場合、パスワード欄を空欄にしたまま実行ボタンを押すだけで、作成者名やソフトウェア履歴などの全メタデータを消去したクリーンなPDFを出力できます。
          </p>
        </details>
      </div>
    </section>

    <RelatedTools currentPath="/pdf-unlock/" />
  </div>

  <!-- セキュリティ仕様書モーダル -->
  <SecuritySpecModal />

  <!-- クライアントサイドスクリプト -->
  <script>
    import * as pdfjsLib from 'pdfjs-dist';
    import { PDFDocument } from 'pdf-lib';

    try {
      pdfjsLib.GlobalWorkerOptions.workerSrc = new URL(
        'pdfjs-dist/build/pdf.worker.mjs',
        import.meta.url
      ).toString();
    } catch (e) {
      console.warn('Worker URL fallback initialized');
    }

    let selectedFile: { name: string; size: number } | null = null;
    let fileBuffer: ArrayBuffer | null = null;
    let unlockedPdfBytes: Uint8Array | null = null;

    // DOM要素
    const dropZone = document.getElementById('dropZonePdf')!;
    const fileInput = document.getElementById('fileInputPdf') as HTMLInputElement;
    const fileInfo = document.getElementById('fileInfoPdf')!;
    const fileName = document.getElementById('fileNamePdf')!;
    const fileMeta = document.getElementById('fileMetaPdf')!;
    const resetPdfBtn = document.getElementById('resetPdfBtn')!;
    const passwordArea = document.getElementById('passwordArea')!;
    const pdfPasswordInput = document.getElementById('pdfPasswordInput') as HTMLInputElement;
    const togglePasswordVisibility = document.getElementById('togglePasswordVisibility')!;
    const unlockBtn = document.getElementById('unlockBtn')!;
    const errorMessage = document.getElementById('errorMessage')!;
    const processingIndicator = document.getElementById('processingIndicator')!;
    const successArea = document.getElementById('successArea')!;
    const successTimeText = document.getElementById('successTimeText')!;
    const metadataReportList = document.getElementById('metadataReportList')!;
    const downloadUnlockedPdfBtn = document.getElementById('downloadUnlockedPdfBtn')!;
    const loadSamplePdfBtn = document.getElementById('loadSamplePdfBtn')!;

    function escapeHtml(str: string): string {
      return str
        .replace(/&/g, '&amp;')
        .replace(/</g, '&lt;')
        .replace(/>/g, '&gt;')
        .replace(/"/g, '&quot;');
    }

    // パスワード表示トグル
    togglePasswordVisibility.addEventListener('click', () => {
      if (pdfPasswordInput.type === 'password') {
        pdfPasswordInput.type = 'text';
        togglePasswordVisibility.textContent = '🙈';
      } else {
        pdfPasswordInput.type = 'password';
        togglePasswordVisibility.textContent = '👁️';
      }
    });

    // サンプルPDF読み込みボタン
    loadSamplePdfBtn.addEventListener('click', async () => {
      try {
        const res = await fetch('/sample_payslip_protected.pdf');
        fileBuffer = await res.arrayBuffer();
        selectedFile = {
          name: 'sample_payslip_protected.pdf',
          size: fileBuffer.byteLength,
        };
        fileName.textContent = selectedFile.name;
        fileMeta.textContent = `サイズ: ${(selectedFile.size / 1024).toFixed(1)} KB (暗号化サンプル)`;

        dropZone.classList.add('hidden');
        fileInfo.classList.remove('hidden');
        passwordArea.classList.remove('hidden');
        errorMessage.classList.add('hidden');
        successArea.classList.add('hidden');
        
        pdfPasswordInput.value = 'test2026';
        pdfPasswordInput.focus();
      } catch (err) {
        alert('サンプルPDFの取得に失敗しました。');
      }
    });

    // D&D & ファイル選択
    dropZone.addEventListener('click', () => fileInput.click());
    dropZone.addEventListener('dragover', (e) => {
      e.preventDefault();
      dropZone.classList.add('border-emerald-500');
    });
    dropZone.addEventListener('dragleave', () => dropZone.classList.remove('border-emerald-500'));
    dropZone.addEventListener('drop', (e) => {
      e.preventDefault();
      dropZone.classList.remove('border-emerald-500');
      if (e.dataTransfer?.files && e.dataTransfer.files[0]) {
        handlePdfFile(e.dataTransfer.files[0]);
      }
    });
    fileInput.addEventListener('change', () => {
      if (fileInput.files && fileInput.files[0]) {
        handlePdfFile(fileInput.files[0]);
      }
    });

    resetPdfBtn.addEventListener('click', () => {
      selectedFile = null;
      fileBuffer = null;
      unlockedPdfBytes = null;
      fileInput.value = '';
      pdfPasswordInput.value = '';
      fileInfo.classList.add('hidden');
      passwordArea.classList.add('hidden');
      errorMessage.classList.add('hidden');
      successArea.classList.add('hidden');
      dropZone.classList.remove('hidden');
    });

    function handlePdfFile(file: File) {
      if (!file.name.toLowerCase().endsWith('.pdf')) {
        alert('PDFファイルを選択してください。');
        return;
      }

      selectedFile = { name: file.name, size: file.size };
      fileName.textContent = file.name;
      fileMeta.textContent = `サイズ: ${(file.size / 1024).toFixed(1)} KB`;

      const reader = new FileReader();
      reader.onload = async (e) => {
        fileBuffer = e.target?.result as ArrayBuffer;
        dropZone.classList.add('hidden');
        fileInfo.classList.remove('hidden');
        passwordArea.classList.remove('hidden');
        errorMessage.classList.add('hidden');
        successArea.classList.add('hidden');
        pdfPasswordInput.value = '';
        pdfPasswordInput.focus();
      };
      reader.readAsArrayBuffer(file);
    }

    // パスワード解除 ＆ メタデータ完全抹消処理
    unlockBtn.addEventListener('click', async () => {
      if (!fileBuffer) return;
      const password = pdfPasswordInput.value;

      errorMessage.classList.add('hidden');
      passwordArea.classList.add('hidden');
      processingIndicator.classList.remove('hidden');

      const startTime = performance.now();

      try {
        const loadingTask = pdfjsLib.getDocument({
          data: new Uint8Array(fileBuffer),
          password: password || undefined,
          useWorkerFetch: false,
          isEvalSupported: false,
        });

        const pdfDoc = await loadingTask.promise;
        const numPages = pdfDoc.numPages;

        // 元PDFのメタデータ（Info辞書）を検査取得
        let rawInfo: Record<string, any> = {};
        try {
          const meta = await pdfDoc.getMetadata();
          rawInfo = (meta?.info as Record<string, any>) || {};
        } catch (_) {
          rawInfo = {};
        }

        const outPdfDoc = await PDFDocument.create();

        for (let pageNum = 1; pageNum <= numPages; pageNum++) {
          const page = await pdfDoc.getPage(pageNum);
          const scale = 3.0; // 300 DPI 相当の高精細
          const viewport = page.getViewport({ scale });

          const canvas = document.createElement('canvas');
          canvas.width = viewport.width;
          canvas.height = viewport.height;
          const context = canvas.getContext('2d')!;

          await page.render({
            canvasContext: context,
            viewport: viewport,
          }).promise;

          const imgDataUrl = canvas.toDataURL('image/png');
          const pngImageBytes = await fetch(imgDataUrl).then(res => res.arrayBuffer());
          const embeddedImage = await outPdfDoc.embedPng(pngImageBytes);

          const originalViewport = page.getViewport({ scale: 1.0 });
          const newPage = outPdfDoc.addPage([originalViewport.width, originalViewport.height]);
          newPage.drawImage(embeddedImage, {
            x: 0,
            y: 0,
            width: originalViewport.width,
            height: originalViewport.height,
          });
        }

        // PDFメタデータ（Info辞書）を明示的にすべて空文字へ初期化（pdf-libデフォルトのProducer文字列も消去）
        outPdfDoc.setTitle('');
        outPdfDoc.setAuthor('');
        outPdfDoc.setSubject('');
        outPdfDoc.setKeywords([]);
        outPdfDoc.setCreator('');
        outPdfDoc.setProducer('');

        unlockedPdfBytes = await outPdfDoc.save();

        // 検出＆消去レポートの描画
        const reportItems = [
          { label: 'パスワード暗号化', val: password ? '設定あり → 解除済' : 'なし (平文)' },
          { label: '作成者 (Author)', val: rawInfo.Author ? `${rawInfo.Author} → 抹消済` : '検出なし (空初期化済)' },
          { label: 'タイトル (Title)', val: rawInfo.Title ? `${rawInfo.Title} → 抹消済` : '検出なし (空初期化済)' },
          { label: '作成ソフト (Creator)', val: rawInfo.Creator ? `${rawInfo.Creator} → 抹消済` : '検出なし (空初期化済)' },
          { label: '変換エンジン (Producer)', val: rawInfo.Producer ? `${rawInfo.Producer} → 抹消済` : '空文字へ完全消去済' },
          { label: '隠し注釈・XMP・しおり', val: 'ページ再構築により完全除去済' },
        ];

        metadataReportList.innerHTML = reportItems
          .map(
            (item) => `
            <div class="p-2 rounded-lg bg-slate-900 border border-slate-800/80 flex items-center justify-between gap-2">
              <span class="text-slate-400 font-medium">${escapeHtml(item.label)}:</span>
              <span class="text-emerald-300 font-mono truncate">${escapeHtml(String(item.val))}</span>
            </div>
          `
          )
          .join('');

        const elapsed = ((performance.now() - startTime) / 1000).toFixed(2);
        successTimeText.textContent = `⚡ 処理完了: ${elapsed}秒 (${numPages}ページ再構築・メタデータ0件化・外部通信0バイト)`;
        
        processingIndicator.classList.add('hidden');
        successArea.classList.remove('hidden');
        successArea.scrollIntoView({ behavior: 'smooth' });

      } catch (err: any) {
        processingIndicator.classList.add('hidden');
        passwordArea.classList.remove('hidden');

        if (err?.name === 'PasswordException' || err?.message?.includes('Password') || err?.code === 1 || err?.code === 2) {
          showError(
            password
              ? 'パスワードが正しくありません。正しいパスワードをご確認の上、再度お試しください。'
              : 'このPDFはパスワード保護されています。設定されているパスワードを入力してください。'
          );
        } else {
          showError(`PDFの解析・解除中にエラーが発生しました: ${err?.message || '不明なエラー'}`);
        }
      }
    });

    function showError(msg: string) {
      errorMessage.textContent = msg;
      errorMessage.classList.remove('hidden');
    }

    // ダウンロード
    downloadUnlockedPdfBtn.addEventListener('click', () => {
      if (!unlockedPdfBytes || !selectedFile) return;

      const buf = unlockedPdfBytes.buffer.slice(
        unlockedPdfBytes.byteOffset,
        unlockedPdfBytes.byteOffset + unlockedPdfBytes.byteLength
      ) as ArrayBuffer;
      const blob = new Blob([buf], { type: 'application/pdf' });
      const url = URL.createObjectURL(blob);
      const a = document.createElement('a');
      a.href = url;
      a.download = selectedFile.name.replace(/\.[^/.]+$/, "") + "_cleaned.pdf";
      document.body.appendChild(a);
      a.click();
      document.body.removeChild(a);
      URL.revokeObjectURL(url);
    });
  </script>
</Layout>
