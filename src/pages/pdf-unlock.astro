---
import ToolShell from '../components/ToolShell.astro';

const howToSteps = [
  {
    name: 'PDFファイルをドラッグ＆ドロップ',
    text: 'パスワード保護された給与明細・源泉徴収票や、作成者メタデータを消去したい機密PDFをドロップゾーンに配置します。',
  },
  {
    name: 'パスワード入力（暗号化PDFの場合）とメタデータ検出確認',
    text: 'パスワード付きPDFの場合は既知のパスワードを入力します。パスワードがない通常PDFの場合はそのままメタデータ（作成者・タイトル・作成ソフト・更新履歴）の消去に進めます。',
  },
  {
    name: 'パスワード＆メタデータ完全抹消PDFをダウンロード',
    text: 'ブラウザ内で300DPI高精細再構築され、パスワードおよびAuthor/Creator/Producer等の全メタデータが初期化されたクリーンなPDFを保存します。',
  },
];

const faqs = [
  {
    question: 'なぜ住宅ローン審査やe-Taxでパスワード付きPDFが拒否されるのですか？',
    answer:
      '多くの金融機関（みずほ銀行、三菱UFJ銀行、三井住友銀行、住信SBIネット銀行など）や国税庁e-Taxのオンライン受付システムでは、アップロードされたPDFを機械的に自動仕分け・OCR解析するため、パスワード保護がかかっているとシステムエラーとなります。そのため、事前に正規のパスワードを除去した平文PDFの提出が必須となっています。',
  },
  {
    question: 'PDFのメタデータ（プロパティ情報）を削除しないとどんな情報漏洩リスクがありますか？',
    answer:
      'WordやExcel、会計・人事ソフトから出力されたPDFの内部プロパティ（Document Information Dictionary / XMP）には、目に見えない「作成者名（個人のフルネームやPCのログインID）」「元のファイル名」「使用ソフト・OS」「作成・更新日時」が自動的に記録されています。本ツールは白紙のPDF構造から再生成し、全プロパティを空文字に初期化するため、取引先や外部提出時のうっかり情報漏洩を100%防げます。',
  },
  {
    question: 'iLovePDFやSmallpdfなどの無料Webサイトで給与明細を解除するのは危険ですか？',
    answer:
      '一般的な無料PDFツールは、一度ファイルを海外のクラウドサーバーへアップロードして処理します。源泉徴収票や給与明細には、年収、マイナンバー、家族構成、住所、勤務先などの極めて重大な個人情報が記載されており、外部サーバーへのアップロードは情報漏洩リスクや企業の就業規則違反（懲戒対象）となる恐れがあります。ZeroLeak Toolsはサーバー送信なし（端末内メモリ完結）のため、漏洩リスク0%で安全に処理できます。',
  },
  {
    question: 'パスワードがかかっていない普通のPDFのメタデータ（作成者名など）だけを削除することもできますか？',
    answer:
      'はい、可能です。パスワード保護されていないPDFをドロップした場合、パスワード入力欄を空欄のまま「パスワード解除＆メタデータ一括抹消を実行」ボタンを押すだけで、内部の作成者名・タイトル・作成ソフト・しおり・隠し注釈をすべて消去したクリーンなPDFを生成できます。',
  },
];
---

<ToolShell
  slug="pdf-unlock"
  title="給与明細・源泉徴収票 PDFパスワード解除＆メタデータ削除"
  description="住宅ローン審査や確定申告(e-Tax)提出用のPDFパスワード解除と、作成者名・タイトル等のPDFメタデータ削除をブラウザ内で一括実行。サーバー送信なし（0バイト保証）。"
  canonicalPath="/pdf-unlock/"
  h1="給与明細・源泉徴収票 PDFパスワード解除＆メタデータ削除"
  subtitle="住宅ローン事前審査や確定申告（e-Tax）で求められる「パスワードなしPDF」をブラウザ内で安全生成。作成者名や作成ソフト名などの内部メタデータも同時に完全消去します。"
  whyTitle="「パスワード付きの給与明細」は、そのままでは提出できない"
  howToSteps={howToSteps}
  faqs={faqs}
  maxWidthClass="max-w-4xl"
>
  <!-- ワンクリック検証用サンプルボタン -->
  <div slot="sample-button" class="flex flex-wrap items-center gap-2">
    <button
      id="loadSamplePayslipBtn"
      type="button"
      class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-xl bg-teal-50 hover:bg-teal-100 text-teal-900 border border-teal-300 text-xs font-bold transition shadow-xs cursor-pointer shrink-0"
    >
      <span>🧪</span>
      <span>模擬給与明細（パスワード: test2026）を投入</span>
    </button>
    <button
      id="loadSamplePlainBtn"
      type="button"
      class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-xl bg-slate-100 hover:bg-slate-200 text-slate-800 border border-slate-300 text-xs font-bold transition shadow-xs cursor-pointer shrink-0"
    >
      <span>📄</span>
      <span>パスワードなしPDF（メタデータ消去テスト）</span>
    </button>
  </div>

  <!-- メイン操作カード -->
  <div class="bg-white border border-slate-200 rounded-2xl p-4 sm:p-6 shadow-sm space-y-5">
    
    <!-- ファイルドロップゾーン -->
    <div
      id="dropZonePdf"
      class="border-2 border-dashed border-slate-300 hover:border-teal-500 rounded-2xl p-6 sm:p-8 text-center transition bg-slate-50/70 hover:bg-teal-50/20 cursor-pointer group"
    >
      <input type="file" id="fileInputPdf" accept=".pdf,application/pdf" class="hidden" />
      <div class="flex flex-col items-center gap-2.5 pointer-events-none">
        <div class="w-12 h-12 rounded-xl bg-teal-50 border border-teal-200 flex items-center justify-center text-teal-600 group-hover:scale-105 transition-transform shadow-xs text-xl">
          📄
        </div>
        <div>
          <p class="font-bold text-slate-800 text-sm sm:text-base">給与明細・源泉徴収票PDFをドロップ</p>
          <p class="text-xs text-slate-500 mt-0.5">またはクリックしてファイルを選択 (.pdf)</p>
        </div>
        <div class="flex flex-wrap items-center justify-center gap-2">
          <span class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full bg-white border border-slate-200 text-[10px] sm:text-[11px] text-teal-800 shadow-xs font-medium">
            🔒 サーバー送信なし（0バイト保証）
          </span>
          <span class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full bg-white border border-slate-200 text-[10px] sm:text-[11px] text-slate-600 shadow-xs">
            ✨ メタデータ（作成者・タイトル）自動抹消
          </span>
        </div>
      </div>
    </div>

    <!-- 選択されたファイル表示＆操作エリア -->
    <div id="fileInfoArea" class="hidden space-y-4">
      <div class="p-3.5 rounded-xl bg-teal-50/60 border border-teal-200 flex flex-col sm:flex-row items-center justify-between gap-3">
        <div class="flex items-center gap-2.5">
          <span class="text-2xl">📄</span>
          <div>
            <p id="fileNameText" class="text-xs sm:text-sm font-semibold text-slate-900">sample.pdf</p>
            <p id="fileMetaText" class="text-[11px] text-slate-500">サイズ: 0 KB • ページ数: 1</p>
          </div>
        </div>
        <button
          id="changeFileBtn"
          type="button"
          class="text-xs text-slate-500 hover:text-slate-800 underline transition cursor-pointer font-medium"
        >
          別のファイルを選択
        </button>
      </div>

      <!-- パスワード入力フォーム -->
      <div id="passwordSection" class="space-y-2">
        <label for="pdfPassword" class="block text-xs font-bold text-slate-700">
          PDFのパスワード（既知のパスワードを入力）：
        </label>
        <div class="flex flex-col sm:flex-row gap-2">
          <div class="relative flex-1">
            <input
              type="password"
              id="pdfPassword"
              class="w-full px-3.5 py-2.5 rounded-xl border border-slate-300 font-mono text-xs sm:text-sm focus:ring-2 focus:ring-teal-500 focus:border-teal-500 transition"
              placeholder="例: 誕生日4桁、会社指定の解除コード"
            />
            <button
              id="togglePasswordBtn"
              type="button"
              class="absolute right-3 top-1/2 -translate-y-1/2 text-xs text-slate-400 hover:text-slate-600 font-medium cursor-pointer"
            >
              表示
            </button>
          </div>
        </div>
        <p class="text-[11px] text-slate-500">
          ※パスワードがかかっていないPDFの場合は、空欄のままでメタデータ消去を実行できます。
        </p>
      </div>

      <div id="errorMessage" class="hidden p-3 rounded-xl bg-rose-50 border border-rose-200 text-rose-800 text-xs font-semibold">
        <!-- エラー内容 -->
      </div>

      <button
        id="unlockBtn"
        type="button"
        class="w-full sm:w-auto px-6 py-3 rounded-xl font-bold text-white bg-teal-600 hover:bg-teal-700 transition shadow-xs flex items-center justify-center gap-2 text-xs sm:text-sm cursor-pointer"
      >
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 11V7a4 4 0 118 0m-4 8v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2z" />
        </svg>
        <span>パスワード解除 ＆ メタデータ一括抹消を実行 (ブラウザ内処理)</span>
      </button>
    </div>

    <!-- 処理中インジケータ -->
    <div id="processingIndicator" class="hidden text-center py-6 space-y-3">
      <div class="inline-block w-8 h-8 border-3 border-teal-600 border-t-transparent rounded-full animate-spin"></div>
      <p class="text-xs text-teal-800 font-semibold">ブラウザ内で高画質再生成 ＆ メタデータ完全消去中... (外部通信0件)</p>
    </div>

    <!-- 解除＆メタデータ削除完了 ＆ ダウンロードカード -->
    <div id="successArea" class="hidden p-4 sm:p-6 rounded-xl bg-teal-50/70 border border-teal-200 space-y-4">
      <div class="flex items-center gap-3">
        <div class="w-10 h-10 rounded-full bg-teal-100 text-teal-800 flex items-center justify-center text-xl">
          🎉
        </div>
        <div>
          <h2 class="text-base font-bold text-teal-950">パスワード解除 ＆ メタデータの完全抹消が完了しました！</h2>
          <p id="successTimeText" class="text-xs text-slate-600 font-mono mt-0.5">処理完了: 0.8秒 (通信0バイト)</p>
        </div>
      </div>

      <!-- ゼロリークくん完了メッセージ -->
      <div class="flex items-center gap-2 p-3 rounded-xl bg-teal-100/70 border border-teal-200 text-xs text-teal-950 font-medium">
        <span class="text-base select-none shrink-0">🛡️</span>
        <span><strong>ゼロリークくん：</strong>パスワード解除とメタデータ消去が完了しました！ファイルはこの端末内だけで安全に再構築されています。</span>
      </div>

      <!-- 検出・抹消されたメタデータ監査レポート -->
      <div class="p-3.5 rounded-xl bg-white border border-slate-200 space-y-2 text-xs shadow-xs">
        <div class="font-bold text-teal-900 flex items-center justify-between">
          <span>🔍 PDF内部メタデータ（プロパティ）検査＆抹消レポート</span>
          <span class="px-2 py-0.5 rounded bg-emerald-50 text-emerald-800 border border-emerald-200 text-[10px] font-bold">残存メタデータ 0件</span>
        </div>
        <div id="metadataReportList" class="grid grid-cols-1 sm:grid-cols-2 gap-2 text-[11px] text-slate-700 pt-1">
          <!-- JSでBefore/Afterを表示 -->
        </div>
      </div>

      <p class="text-xs text-slate-600 leading-relaxed">
        パスワード保護および内部プロパティ（作成者・タイトル・履歴）がすべて除去されたクリーンなPDFが生成されました。住宅ローン審査や確定申告（e-Tax）、社外取引先へそのまま安全に提出可能です。
      </p>

      <div class="pt-1">
        <button
          id="downloadUnlockedPdfBtn"
          type="button"
          class="w-full sm:w-auto px-6 py-2.5 rounded-xl font-bold text-xs sm:text-sm text-white bg-teal-600 hover:bg-teal-700 transition shadow-xs flex items-center justify-center gap-2 cursor-pointer"
        >
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4" />
          </svg>
          <span>パスワード解除＆メタデータ削除済みPDFを保存</span>
        </button>
      </div>
    </div>

  </div>

  <!-- クライアントサイドスクリプト -->
  <script>
    import * as pdfjsLib from 'pdfjs-dist';
    import { PDFDocument } from 'pdf-lib';

    pdfjsLib.GlobalWorkerOptions.workerSrc = new URL(
      'pdfjs-dist/build/pdf.worker.min.mjs',
      import.meta.url
    ).toString();

    let currentFileBuffer: ArrayBuffer | null = null;
    let currentFileName = '';
    let decryptedPdfBytes: Uint8Array | null = null;
    let detectedMetadata: Record<string, string | null> = {};

    const dropZone = document.getElementById('dropZonePdf') as HTMLDivElement;
    const fileInput = document.getElementById('fileInputPdf') as HTMLInputElement;
    const fileInfoArea = document.getElementById('fileInfoArea') as HTMLDivElement;
    const fileNameText = document.getElementById('fileNameText') as HTMLParagraphElement;
    const fileMetaText = document.getElementById('fileMetaText') as HTMLParagraphElement;
    const changeFileBtn = document.getElementById('changeFileBtn') as HTMLButtonElement;
    const passwordInput = document.getElementById('pdfPassword') as HTMLInputElement;
    const togglePasswordBtn = document.getElementById('togglePasswordBtn') as HTMLButtonElement;
    const unlockBtn = document.getElementById('unlockBtn') as HTMLButtonElement;
    const errorMessage = document.getElementById('errorMessage') as HTMLDivElement;
    const processingIndicator = document.getElementById('processingIndicator') as HTMLDivElement;
    const successArea = document.getElementById('successArea') as HTMLDivElement;
    const successTimeText = document.getElementById('successTimeText') as HTMLParagraphElement;
    const downloadBtn = document.getElementById('downloadUnlockedPdfBtn') as HTMLButtonElement;
    const metadataReportList = document.getElementById('metadataReportList') as HTMLDivElement;

    // ファイル選択処理
    async function handleFile(file: File) {
      errorMessage.classList.add('hidden');
      successArea.classList.add('hidden');
      currentFileName = file.name;
      currentFileBuffer = await file.arrayBuffer();

      fileNameText.textContent = file.name;
      fileMetaText.textContent = `サイズ: ${(file.size / 1024).toFixed(1)} KB`;

      // 初期メタデータ検査
      try {
        const doc = await PDFDocument.load(currentFileBuffer.slice(0), { ignoreEncryption: true });
        detectedMetadata = {
          title: doc.getTitle() || null,
          author: doc.getAuthor() || null,
          subject: doc.getSubject() || null,
          creator: doc.getCreator() || null,
          producer: doc.getProducer() || null,
        };
      } catch (e) {
        detectedMetadata = {};
      }

      dropZone.classList.add('hidden');
      fileInfoArea.classList.remove('hidden');
      passwordInput.value = '';
      passwordInput.focus();
    }

    // パスワード解除・メタデータ完全消去実行
    async function executeUnlock() {
      if (!currentFileBuffer) return;

      const password = passwordInput.value;
      errorMessage.classList.add('hidden');
      processingIndicator.classList.remove('hidden');
      unlockBtn.setAttribute('disabled', 'true');

      const startTime = performance.now();

      try {
        const loadingTask = pdfjsLib.getDocument({
          data: currentFileBuffer.slice(0),
          password: password,
        });

        const pdf = await loadingTask.promise;
        const numPages = pdf.numPages;

        // 高画質ラスタライズ再生成パイプライン (300 DPI)
        const newPdfDoc = await PDFDocument.create();

        // 内部プロパティ・メタデータを完全に空文字/安全値へ初期化
        newPdfDoc.setTitle('');
        newPdfDoc.setAuthor('');
        newPdfDoc.setSubject('');
        newPdfDoc.setKeywords([]);
        newPdfDoc.setProducer('');
        newPdfDoc.setCreator('');

        for (let i = 1; i <= numPages; i++) {
          const page = await pdf.getPage(i);
          const viewport = page.getViewport({ scale: 2.0 }); // 144 DPI相当で高精細キャプチャ

          const canvas = document.createElement('canvas');
          const context = canvas.getContext('2d');
          canvas.width = viewport.width;
          canvas.height = viewport.height;

          if (!context) throw new Error('Canvas context failure');

          await page.render({
            canvasContext: context,
            viewport: viewport,
          }).promise;

          const imgDataUrl = canvas.toDataURL('image/jpeg', 0.95);
          const imgBytes = await fetch(imgDataUrl).then((res) => res.arrayBuffer());
          const embeddedImage = await newPdfDoc.embedJpg(imgBytes);

          // 元のページサイズ（ポイント単位）で白紙ページを追加
          const originalViewport = page.getViewport({ scale: 1.0 });
          const newPage = newPdfDoc.addPage([originalViewport.width, originalViewport.height]);

          newPage.drawImage(embeddedImage, {
            x: 0,
            y: 0,
            width: originalViewport.width,
            height: originalViewport.height,
          });
        }

        decryptedPdfBytes = await newPdfDoc.save();

        const elapsed = ((performance.now() - startTime) / 1000).toFixed(1);
        successTimeText.textContent = `処理完了: ${elapsed}秒 (通信0バイト) • 生成ページ数: ${numPages}ページ`;

        // メタデータ消去レポートの描画
        renderMetadataReport();

        processingIndicator.classList.add('hidden');
        successArea.classList.remove('hidden');
      } catch (err: any) {
        processingIndicator.classList.add('hidden');
        errorMessage.classList.remove('hidden');

        if (err.name === 'PasswordException' || err.message?.includes('password')) {
          errorMessage.textContent = '❌ パスワードが一致しません。正しいパスワードを入力してください。';
        } else {
          errorMessage.textContent = '❌ PDFの読み込みまたは再生成に失敗しました。ファイルが破損していないかご確認ください。';
        }
      } finally {
        unlockBtn.removeAttribute('disabled');
      }
    }

    function renderMetadataReport() {
      const items = [
        { label: '作成者名 (Author)', before: detectedMetadata.author },
        { label: 'タイトル (Title)', before: detectedMetadata.title },
        { label: '作成ソフト (Producer)', before: detectedMetadata.producer },
        { label: '更新履歴・しおり', before: detectedMetadata.subject ? '記録あり' : null },
      ];

      metadataReportList.innerHTML = items
        .map((it) => {
          const isDetected = !!it.before;
          return `
            <div class="p-2 rounded-lg bg-slate-50 border border-slate-200 flex items-center justify-between">
              <div>
                <span class="font-bold text-slate-800">${it.label}:</span>
                <span class="text-slate-500 font-mono ml-1">${isDetected ? `"${it.before}"` : '(未設定)'}</span>
              </div>
              <span class="px-1.5 py-0.5 rounded text-[10px] font-bold ${isDetected ? 'bg-emerald-100 text-emerald-800' : 'bg-slate-200 text-slate-600'}">
                ${isDetected ? '消去完了' : '安全'}
              </span>
            </div>
          `;
        })
        .join('');
    }

    // ダウンロード
    downloadBtn.addEventListener('click', () => {
      if (!decryptedPdfBytes) return;
      const blob = new Blob([decryptedPdfBytes], { type: 'application/pdf' });
      const url = URL.createObjectURL(blob);
      const a = document.createElement('a');
      a.href = url;
      a.download = currentFileName.replace(/\.pdf$/i, '') + '_unlocked.pdf';
      document.body.appendChild(a);
      a.click();
      document.body.removeChild(a);
      URL.revokeObjectURL(url);
    });

    // パスワード表示トグル
    togglePasswordBtn.addEventListener('click', () => {
      if (passwordInput.type === 'password') {
        passwordInput.type = 'text';
        togglePasswordBtn.textContent = '隠す';
      } else {
        passwordInput.type = 'password';
        togglePasswordBtn.textContent = '表示';
      }
    });

    // ファイル再選択
    changeFileBtn.addEventListener('click', () => {
      fileInfoArea.classList.add('hidden');
      dropZone.classList.remove('hidden');
      fileInput.value = '';
      currentFileBuffer = null;
      decryptedPdfBytes = null;
    });

    // サンプル投入
    const samplePayslipBtn = document.getElementById('loadSamplePayslipBtn');
    samplePayslipBtn?.addEventListener('click', async () => {
      const res = await fetch('/sample_payslip_protected.pdf');
      const blob = await res.blob();
      const file = new File([blob], '給与明細_2026年10月度_暗号化済.pdf', { type: 'application/pdf' });
      await handleFile(file);
      passwordInput.value = 'test2026';
    });

    const samplePlainBtn = document.getElementById('loadSamplePlainBtn');
    samplePlainBtn?.addEventListener('click', async () => {
      const res = await fetch('/sample_payslip_plain.pdf');
      const blob = await res.blob();
      const file = new File([blob], '提出用書類_通常PDF.pdf', { type: 'application/pdf' });
      await handleFile(file);
    });

    // ドラッグ＆ドロップイベント
    dropZone.addEventListener('click', () => fileInput.click());
    dropZone.addEventListener('dragover', (e) => {
      e.preventDefault();
      dropZone.classList.add('border-teal-500', 'bg-teal-50/30');
    });
    dropZone.addEventListener('dragleave', () => {
      dropZone.classList.remove('border-teal-500', 'bg-teal-50/30');
    });
    dropZone.addEventListener('drop', (e) => {
      e.preventDefault();
      dropZone.classList.remove('border-teal-500', 'bg-teal-50/30');
      if (e.dataTransfer && e.dataTransfer.files.length > 0) {
        handleFile(e.dataTransfer.files[0]);
      }
    });

    fileInput.addEventListener('change', () => {
      if (fileInput.files && fileInput.files.length > 0) {
        handleFile(fileInput.files[0]);
      }
    });

    unlockBtn.addEventListener('click', executeUnlock);
  </script>
</ToolShell>
