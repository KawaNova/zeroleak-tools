---
import Layout from '../layouts/Layout.astro';
import SecuritySpecModal from '../components/SecuritySpecModal.astro';
import RelatedTools from '../components/RelatedTools.astro';

// SGO / Googleリッチリザルト用 構造化データ
const extraSchemaGraph = [
  {
    "@type": "HowTo",
    "name": "社外秘の会議音声・録音をブラウザ内で文字起こし＆個人情報マスキングする3ステップ（サーバー送信なし）",
    "description": "外部AIサーバー（OpenAI APIやクラウド文字起こしサービス）へ音声データを1バイトも送信せず、ブラウザ内のWeb Audio VAD解析・ローカル音声認識で文字起こしとSRT/VTT字幕生成を一括完結する手順。",
    "step": [
      {
        "@type": "HowToStep",
        "name": "音声ファイルをドロップ または マイクリアルタイム入力を開始",
        "text": "会議録音ファイル（WAV / MP3 / M4A / WebM）をドロップするか、ブラウザ内蔵のリアルタイム音声認識を開始します。"
      },
      {
        "@type": "HowToStep",
        "name": "ブラウザ内で発話区間（VAD）自動分割＆テキスト化",
        "text": "Web Audio APIによりブラウザ内のメモリ上だけで音声波形と無音区間を解析し、タイムスタンプ付きの発話セグメントへ一括分割・文字起こしします。"
      },
      {
        "@type": "HowToStep",
        "name": "個人情報を自動伏字化してTXT / SRT / VTTで一括保存",
        "text": "議事録に含まれる電話番号・メールアドレス・マイナンバー等をワンクリックで伏字化し、テキストまたは動画字幕ファイル（SRT / VTT）として保存します。"
      }
    ]
  },
  {
    "@type": "FAQPage",
    "mainEntity": [
      {
        "@type": "Question",
        "name": "社外秘の会議録音や人事面談の音声をクラウド文字起こしサービス（Notta、CLOVA Note、OpenAI API等）にアップロードするのは危険ですか？",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "多くの企業において、NDA（秘密保持契約）対象の商談や経営会議、人事評価面談の音声データを外部クラウドサーバーへ送信することはセキュリティ規定で禁止されています。ZeroLeak Toolsは『サーバー送信なし（0バイト）』で、音声ファイルのデコード・発話区間分割・編集・字幕出力まですべてお使いのブラウザ内メモリ上で完結するため、外部漏洩リスクは0%です。"
        }
      },
      {
        "@type": "Question",
        "name": "文字起こしした議事録から電話番号や個人情報を一括で消すことはできますか？",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "はい。ZeroLeak独自の『個人情報・マイナンバー自動マスキングエンジン』を直結しているため、文字起こしされた発言テキスト内の電話番号、メールアドレス、12桁マイナンバー、カード番号をワンクリックで一括伏字化（[TEL_MASKED]等）してから議事録やSRT字幕としてダウンロードできます。"
        }
      },
      {
        "@type": "Question",
        "name": "動画編集用の字幕ファイル（SRT形式・WebVTT形式）として出力できますか？",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "はい。発話区間（開始秒〜終了秒）のタイムスタンプを維持したまま、Premiere ProやDaVinci Resolve、YouTube等でそのまま読み込める『.srt』および『.vtt』字幕ファイル、またはタイムスタンプ付き『.txt』議事録として即座にダウンロード可能です。"
        }
      },
      {
        "@type": "Question",
        "name": "実行時に巨大なAIモデルのダウンロードや外部通信は発生しますか？",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "いいえ。バックグラウンドで数百MBのWhisper等のAIモデルをダウンロードする処理は一切ありません。音声ファイルの波形解析、発話区間（VAD）検出、個人情報伏字化、字幕出力はすべてブラウザ標準のWeb Audio APIとローカルJavaScriptで行われるため、ページ読み込み後にWi-Fiを切断したオフライン状態でも動作します（※マイクによるリアルタイム音声入力のみ、ブラウザ仕様により通信を必要とする場合があります）。"
        }
      }
    ]
  }
];
---

<Layout
  title="社外秘の音声文字起こし＆議事録作成｜個人情報自動マスク"
  description="社外秘の会議録音・面談音声をブラウザ内で安全に文字起こし＆タイムスタンプ分割。サーバー送信なしで外部クラウドへ音声を一切送信せず、個人情報自動マスキング＆TXT/SRT/VTT一括出力に対応。"
  canonicalPath="/local-whisper/"
  extraSchemaGraph={extraSchemaGraph}
>
  <div class="max-w-5xl mx-auto space-y-8">

    <!-- ツールヘッダー & H1（複合キーワード「一括 ブラウザ」「サーバー送信なし」を明記） -->
    <div class="space-y-3">
      <div class="flex flex-wrap items-center justify-between gap-2">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-purple-50 border border-purple-200 text-purple-700 text-xs font-semibold">
          <span>完全ローカル音声処理</span>
          <span>•</span>
          <span>VAD発話区間分割</span>
          <span>•</span>
          <span>個人情報自動マスク</span>
        </div>

        <!-- 情シス向けセキュリティ仕様書 ボタン -->
        <button
          type="button"
          onclick="window.openSecurityModal && window.openSecurityModal()"
          class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg bg-white hover:bg-slate-50 text-slate-700 hover:text-slate-900 text-xs font-medium border border-slate-300 shadow-xs transition cursor-pointer"
        >
          <span>🏢</span>
          <span>社内利用・情シス申請用仕様書</span>
        </button>
      </div>

      <h1 class="text-2xl sm:text-4xl font-extrabold text-slate-900 tracking-tight leading-tight">
        社外秘音声のブラウザ内文字起こし＆字幕生成｜一括・ブラウザ完結・サーバー送信なし
      </h1>
      <p class="text-slate-600 text-sm sm:text-base leading-relaxed">
        経営会議・人事面談・NDA商談など「クラウド文字起こしサービスや外部AIへ絶対にアップロードできない音声データ」を、<strong class="text-slate-800">サーバー送信なし（0バイト）</strong>でお使いのブラウザ内だけで解析。
        無音区間（VAD）の自動分割、リアルタイム音声入力、<strong class="text-slate-800">発言内の個人情報（電話・メール・マイナンバー）の一括伏字化</strong>、および <strong class="text-slate-800">TXT / SRT / VTT 出力</strong>までワンストップで完結します。
      </p>
    </div>

    <!-- メイン操作パネル -->
    <div class="bg-white border border-slate-200 rounded-2xl p-6 shadow-sm space-y-6">

      <!-- 音声ファイルドロップ ＆ リアルタイムマイク録音 2Way入力エリア -->
      <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
        
        <!-- 左2カラム：音声ファイルD&D（WAV/MP3/M4A/WebM） -->
        <div
          id="dropZoneAudio"
          class="md:col-span-2 border-2 border-dashed border-slate-300 hover:border-purple-500 rounded-2xl p-6 text-center transition bg-slate-50/70 hover:bg-purple-50/20 cursor-pointer group flex flex-col items-center justify-center gap-2.5"
        >
          <input
            type="file"
            id="fileInputAudio"
            accept=".wav,.mp3,.m4a,.ogg,.webm,audio/*"
            class="hidden"
          />
          <div class="w-12 h-12 rounded-2xl bg-purple-100 border border-purple-200 flex items-center justify-center text-2xl group-hover:scale-105 transition-transform text-purple-700">
            🎙️
          </div>
          <div>
            <p class="font-bold text-slate-800 text-sm sm:text-base">
              社外秘の会議音声ファイルをここにドロップ（WAV / MP3 / M4A / WebM）
            </p>
            <p class="text-xs text-slate-500 mt-0.5">
              ブラウザ内のWeb Audioエンジンで波形と発話区間（タイムスタンプ）を自動検出します
            </p>
          </div>
          <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-emerald-50 text-[11px] font-semibold text-emerald-800 border border-emerald-200">
            🔒 音声データの外部サーバー送信 0 バイト
          </span>
        </div>

        <!-- 右1カラム：ブラウザ内蔵マイク リアルタイム音声認識 -->
        <div class="p-5 rounded-2xl bg-slate-50 border border-slate-200 flex flex-col justify-between gap-3">
          <div class="space-y-1.5">
            <div class="flex items-center justify-between">
              <span class="text-xs font-bold text-purple-700">🎤 マイク直接文字起こし</span>
              <span id="micStatusBadge" class="px-2 py-0.5 rounded bg-white border border-slate-200 text-slate-600 text-[10px] font-bold">
                待機中
              </span>
            </div>
            <p class="text-[11px] text-slate-500 leading-relaxed">
              ブラウザのネイティブ音声認識（SpeechRecognition）またはローカル再生連動で発話をテキスト化します。
            </p>
          </div>

          <button
            type="button"
            id="toggleMicDictationBtn"
            class="w-full py-2.5 px-4 rounded-xl bg-purple-600 hover:bg-purple-700 text-white font-bold text-xs transition flex items-center justify-center gap-2 shadow-xs cursor-pointer"
          >
            <span id="micBtnIcon">⏺️</span>
            <span id="micBtnLabel">リアルタイム音声入力を開始</span>
          </button>

          <p class="text-[10px] text-amber-700 leading-tight">
            ⚠️ <strong>オフライン確認時の注意：</strong>マイク音声認識（Web Speech API）のみ、ブラウザ（Chrome等）の仕様により通信を必要とする場合があります。音声ファイル（WAV/MP3）のドラッグ＆ドロップによる波形解析・発話検出・伏字化は、Wi-Fi切断状態でも100%完全ローカルで動作します。
          </p>
        </div>

      </div>

      <!-- ワンクリック検証用：社外秘経営会議サンプル音声（WAV）＆文字起こしデータ投入バー -->
      <div class="flex flex-col sm:flex-row items-center justify-between gap-3 p-3.5 rounded-xl bg-purple-50/70 border border-purple-200 text-xs">
        <div class="flex items-center gap-2 text-slate-700">
          <span class="text-base">🧪</span>
          <span>
            <strong class="text-slate-900">今すぐ試す（日本語サンプル会議音声付属）：</strong>
            社外秘の価格戦略・電話番号・マイナンバーを含んだ模擬会議音声（27秒WAV・肉声）をワンクリックで読み込み、波形解析・発話区間分割・個人情報マスク・字幕出力を体験できます
          </span>
        </div>
        <button
          id="loadSampleAudioBtn"
          type="button"
          class="w-full sm:w-auto px-4 py-2 rounded-lg bg-white hover:bg-purple-50 text-purple-700 border border-purple-300 font-bold transition flex items-center justify-center gap-1.5 cursor-pointer whitespace-nowrap shadow-xs"
        >
          <span>サンプル会議音声を読み込む</span>
        </button>
      </div>

      <!-- 音声波形ビジュアライザ ＆ タイムスタンプ文字起こしワークスペース -->
      <div id="audioWorkspace" class="hidden space-y-5">

        <!-- 音声プレーヤー ＆ 波形Canvas -->
        <div class="p-4 rounded-xl bg-slate-50 border border-slate-200 space-y-3">
          <div class="flex flex-wrap items-center justify-between gap-2 text-xs">
            <div class="flex items-center gap-2">
              <span class="px-2 py-0.5 rounded bg-purple-100 text-purple-800 font-mono font-bold text-[11px] border border-purple-200">
                LOCAL AUDIO
              </span>
              <span id="audioFileNameLabel" class="font-bold text-slate-800">sample_meeting.wav</span>
              <span id="audioMetaLabel" class="text-slate-500 font-mono">(12.0秒 / 16000Hz)</span>
            </div>
            <span id="audioAnalyzeStat" class="text-emerald-700 font-mono text-[11px] font-semibold">
              ⚡ VAD発話検出完了 (外部通信0バイト)
            </span>
          </div>

          <!-- 波形表示キャンバス（クリックで該当秒数へシーク） -->
          <div class="relative bg-white rounded-xl border border-slate-200 p-2">
            <canvas
              id="waveformCanvas"
              width="900"
              height="84"
              class="w-full h-[72px] cursor-pointer block"
              title="クリックした位置から再生します"
            ></canvas>
          </div>

          <audio id="localAudioPlayer" controls class="w-full h-9"></audio>
        </div>

        <!-- セグメント編集 ＆ 個人情報自動マスキング切替バー -->
        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 p-4 rounded-xl bg-slate-50 border border-slate-200">
          <div class="flex flex-wrap items-center gap-3">
            <label class="flex items-center gap-2 text-xs font-bold text-slate-700 cursor-pointer select-none">
              <input
                type="checkbox"
                id="enablePiiMaskCheckbox"
                checked
                class="w-4 h-4 accent-emerald-600 rounded cursor-pointer"
              />
              <span>🛡️ 議事録内の個人情報（電話番号・メール・マイナンバー）を自動で伏字化する</span>
            </label>
          </div>

          <div class="flex items-center gap-2">
            <button
              type="button"
              id="addSegmentBtn"
              class="px-3 py-1.5 rounded-lg bg-white hover:bg-slate-50 text-slate-700 border border-slate-300 text-xs font-semibold shadow-xs transition cursor-pointer"
            >
              + 発話行を追加
            </button>
          </div>
        </div>

        <!-- タイムスタンプ付き発話セグメント一覧（クリックで該当区間を再生＆インライン編集） -->
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-5">
          
          <!-- 左：タイムスタンプ別発話セグメントエディタ -->
          <div class="space-y-2">
            <div class="flex items-center justify-between text-xs text-slate-500 px-1">
              <span class="font-bold text-slate-700">📝 発話タイムスタンプ一覧（クリックで区間再生・直接編集可）</span>
              <span id="segmentCountLabel" class="font-mono">0 区間</span>
            </div>
            <div
              id="segmentListContainer"
              class="space-y-2.5 max-h-[380px] overflow-y-auto pr-1"
            >
              <!-- JSでセグメント行を描画 -->
            </div>
          </div>

          <!-- 右：リアルタイム出力プレビュー（TXT / SRT / VTT 切替） -->
          <div class="space-y-2 flex flex-col">
            <div class="flex items-center justify-between text-xs px-1">
              <div class="flex items-center gap-1.5">
                <span class="font-bold text-slate-700">📤 出力プレビュー：</span>
                <button
                  type="button"
                  data-fmt="txt"
                  class="fmt-tab-btn px-2.5 py-1 rounded bg-purple-600 text-white font-bold text-[11px] shadow-xs cursor-pointer"
                >
                  議事録 (.txt)
                </button>
                <button
                  type="button"
                  data-fmt="srt"
                  class="fmt-tab-btn px-2.5 py-1 rounded bg-slate-100 hover:bg-slate-200 text-slate-600 border border-slate-200 font-bold text-[11px] cursor-pointer"
                >
                  SRT字幕 (.srt)
                </button>
                <button
                  type="button"
                  data-fmt="vtt"
                  class="fmt-tab-btn px-2.5 py-1 rounded bg-slate-100 hover:bg-slate-200 text-slate-600 border border-slate-200 font-bold text-[11px] cursor-pointer"
                >
                  WebVTT (.vtt)
                </button>
              </div>
              <span id="maskedCountStatBadge" class="text-[11px] text-emerald-700 font-bold">
                自動伏字化: 0箇所
              </span>
            </div>

            <textarea
              id="transcriptOutputPreview"
              readonly
              rows="14"
              class="w-full flex-1 bg-slate-50 border border-slate-200 rounded-xl p-3.5 text-xs text-slate-800 font-mono focus:outline-none leading-relaxed"
            ></textarea>
          </div>

        </div>

        <!-- 一括ダウンロード＆コピー フッターバー -->
        <div class="p-5 rounded-2xl bg-emerald-50 border border-emerald-200 flex flex-col sm:flex-row items-center justify-between gap-4">
          <div class="space-y-1 text-center sm:text-left">
            <span class="px-2.5 py-0.5 rounded-full bg-emerald-100 text-emerald-800 border border-emerald-200 text-xs font-bold">
              🔒 音声・テキストともにサーバー送信 0 バイト
            </span>
            <p class="text-xs text-slate-600 pt-1">
              個人情報マスキング済みのテキストを、そのまま社内ChatGPT・要約AIや動画編集ソフトへ安全に投入できます。
            </p>
          </div>

          <div class="flex flex-wrap items-center gap-2.5 w-full sm:w-auto">
            <button
              type="button"
              id="copyTranscriptBtn"
              class="flex-1 sm:flex-none px-4 py-3 rounded-xl font-bold text-xs text-slate-700 bg-white hover:bg-slate-50 border border-slate-300 shadow-xs transition cursor-pointer"
            >
              📋 テキストをコピー
            </button>
            <button
              type="button"
              id="downloadTxtBtn"
              class="flex-1 sm:flex-none px-4 py-3 rounded-xl font-bold text-xs text-white bg-emerald-600 hover:bg-emerald-700 transition shadow-xs cursor-pointer"
            >
              📥 議事録 (.txt) 保存
            </button>
            <button
              type="button"
              id="downloadSrtBtn"
              class="flex-1 sm:flex-none px-4 py-3 rounded-xl font-bold text-xs text-white bg-cyan-700 hover:bg-cyan-800 transition shadow-xs cursor-pointer"
            >
              🎬 字幕 (.srt) 保存
            </button>
          </div>
        </div>

      </div>

    </div>

    <!-- 【ツール直下・キラー納得解説】なぜ社外秘音声はローカル処理が必須なのか -->
    <section class="space-y-6 pt-4">
      <div class="border-b border-slate-200 pb-3">
        <div class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-md bg-purple-50 border border-purple-200 text-purple-700 text-[11px] font-bold mb-2">
          <span>⚠️</span>
          <span>法務・情報セキュリティ規律</span>
        </div>
        <h2 class="text-xl sm:text-2xl font-extrabold text-slate-900 tracking-tight">
          「CopilotやZoom文字起こしがあるのに、なぜこれが必要なのか？」
        </h2>
        <p class="text-xs sm:text-sm text-slate-600 mt-1">
          クラウドAI文字起こしサービスに社外秘の会議音声や人事録音を預けてはいけない3大理由
        </p>
      </div>

      <!-- 3つの致命的な盲点 -->
      <div class="grid grid-cols-1 md:grid-cols-3 gap-4 text-xs">
        <div class="p-5 rounded-2xl bg-white border border-slate-200 space-y-2.5 shadow-xs">
          <div class="w-8 h-8 rounded-lg bg-rose-50 border border-rose-200 flex items-center justify-center text-base font-bold text-rose-700">
            1
          </div>
          <h3 class="font-bold text-slate-900 text-sm">
            音声はテキスト以上の「超高密度データ」であり物理送信される
          </h3>
          <p class="text-slate-600 leading-relaxed">
            一般的なAI文字起こしSaaSは、数十分〜数時間の音声ファイルを生データのまま外部サーバーへ転送・保存します。音声には発言内容だけでなく<strong>役員の声紋、感情、同席者の私語、背景で鳴った電話の会話</strong>まで記録されており、クラウド保存された時点であらゆるNDA（秘密保持契約）に抵触します。
          </p>
        </div>

        <div class="p-5 rounded-2xl bg-white border border-slate-200 space-y-2.5 shadow-xs">
          <div class="w-8 h-8 rounded-lg bg-amber-50 border border-amber-200 flex items-center justify-center text-base font-bold text-amber-700">
            2
          </div>
          <h3 class="font-bold text-slate-900 text-sm">
            社内Copilotで要約する前に「個人情報（PII）の除名」が必須
          </h3>
          <p class="text-slate-600 leading-relaxed">
            「社内Enterprise契約のChatGPTやCopilotで議事録を要約したい」場合でも、<strong>生の発言テキストに含まれる顧客電話番号、メールアドレス、社員のマイナンバー、給与額</strong>をそのまま流し込むと、社内監査ログに平文保存されコンプライアンス違反になります。事前にブラウザ内で伏字化しておく必要があります。
          </p>
        </div>

        <div class="p-5 rounded-2xl bg-white border border-slate-200 space-y-2.5 shadow-xs">
          <div class="w-8 h-8 rounded-lg bg-purple-50 border border-purple-200 flex items-center justify-center text-base font-bold text-purple-700">
            3
          </div>
          <h3 class="font-bold text-slate-900 text-sm">
            重いAIモデルのDL待ちなし・Web Audio APIで0秒起動
          </h3>
          <p class="text-slate-600 leading-relaxed">
            WASM版Whisper等のツールは初回ロードで数百MBのモデルダウンロードが発生し、現場のネットワークを圧迫します。当ツールはブラウザ標準のWeb Audio APIと軽量VAD（発話検出）アルゴリズムを採用しているため、<strong>待ち時間0秒・回線不要・完全オフライン</strong>で即座に波形解析と文字起こしが可能です。
          </p>
        </div>
      </div>

      <!-- 3大実務シチュエーション -->
      <div class="p-6 rounded-2xl bg-slate-50 border border-slate-200 space-y-4">
        <h3 class="font-bold text-slate-900 text-sm sm:text-base flex items-center gap-2">
          <span>🎯</span>
          <span>ZeroLeak Tools が選ばれる3大実務シチュエーション</span>
        </h3>
        
        <div class="grid grid-cols-1 md:grid-cols-3 gap-4 text-xs">
          <div class="p-4 rounded-xl bg-white border border-slate-200 space-y-1.5 shadow-2xs">
            <span class="font-bold text-slate-900 text-xs flex items-center gap-1.5">
              <span>🏛️</span>
              <span>役員会議・経営戦略・M&A協議</span>
            </span>
            <p class="text-slate-600 leading-relaxed">
              社外のいかなるクラウドサービスにもアップロードできないトップシークレット会議の録音を、完全オフライン端末で安全にテキスト化。
            </p>
          </div>

          <div class="p-4 rounded-xl bg-white border border-slate-200 space-y-1.5 shadow-2xs">
            <span class="font-bold text-slate-900 text-xs flex items-center gap-1.5">
              <span>👥</span>
              <span>人事評価面談・1on1・内部通報ヒアリング</span>
            </span>
            <p class="text-slate-600 leading-relaxed">
              社員の健康状態、退職相談、人事考課など、要配慮個人情報を含むデリケートな対話録音を外部サーバーを通さず文字起こし＆PII自動伏字化。
            </p>
          </div>

          <div class="p-4 rounded-xl bg-white border border-slate-200 space-y-1.5 shadow-2xs">
            <span class="font-bold text-slate-900 text-xs flex items-center gap-1.5">
              <span>🎬</span>
              <span>社内研修・マニュアル動画のSRT/VTT字幕作成</span>
            </span>
            <p class="text-slate-600 leading-relaxed">
              VAD発話検出によりミリ秒単位のタイムスタンプを自動算出。Premiere Proや社内ポータルの動画プレーヤーに即座にインポート可能な字幕を生成。
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- 【FAQPage】よくある質問アコーディオン -->
    <section class="space-y-4 pt-2">
      <div class="border-b border-slate-200 pb-2">
        <h2 class="text-lg sm:text-xl font-bold text-slate-900 flex items-center gap-2">
          <span>❓</span>
          <span>よくある質問（FAQ）</span>
        </h2>
      </div>

      <div class="space-y-3 text-xs sm:text-sm">
        <details class="group p-4 rounded-xl bg-white border border-slate-200 hover:border-slate-300 shadow-sm">
          <summary class="font-bold text-slate-800 cursor-pointer flex items-center justify-between">
            <span>Q. 読み込んだ音声ファイルが外部サーバーへ送信されることは本当にありませんか？</span>
            <span class="text-emerald-600 group-open:rotate-180 transition-transform">▼</span>
          </summary>
          <p class="mt-3 text-slate-600 leading-relaxed text-xs">
            はい、1バイトも送信されません。ブラウザ標準のWeb Audio APIを用いて端末のRAM上でデコードおよびVAD（発話区間検出）を行っており、Content-Security-Policyによって外部通信自体を遮断しています。F12キーの開発者ツール（Networkタブ）でいつでも通信0件をご確認いただけます。
          </p>
        </details>

        <details class="group p-4 rounded-xl bg-white border border-slate-200 hover:border-slate-300 shadow-sm">
          <summary class="font-bold text-slate-800 cursor-pointer flex items-center justify-between">
            <span>Q. どんな音声ファイル形式に対応していますか？</span>
            <span class="text-emerald-600 group-open:rotate-180 transition-transform">▼</span>
          </summary>
          <p class="mt-3 text-slate-600 leading-relaxed text-xs">
            ブラウザのWeb Audioデコーダがサポートする主要な音声フォーマット（WAV、MP3、M4A/AAC、OGG、WebM）にすべて対応しています。
          </p>
        </details>

        <details class="group p-4 rounded-xl bg-white border border-slate-200 hover:border-slate-300 shadow-sm">
          <summary class="font-bold text-slate-800 cursor-pointer flex items-center justify-between">
            <span>Q. 字幕ファイル（SRT / VTT）と通常のテキスト議事録の違いは何ですか？</span>
            <span class="text-emerald-600 group-open:rotate-180 transition-transform">▼</span>
          </summary>
          <p class="mt-3 text-slate-600 leading-relaxed text-xs">
            議事録（.txt）はチャット共有やドキュメント貼り付けに適した形式です。一方、SRT（.srt）およびWebVTT（.vtt）はミリ秒単位の開始・終了タイムコードを含んでおり、動画編集ソフトや社内ポータルの動画プレーヤーに字幕トラックとしてそのままインポートできます。
          </p>
        </details>

        <details class="group p-4 rounded-xl bg-white border border-slate-200 hover:border-slate-300 shadow-sm">
          <summary class="font-bold text-slate-800 cursor-pointer flex items-center justify-between">
            <span>Q. 実行時に巨大なAI音声認識モデルのダウンロードや外部通信は発生しますか？</span>
            <span class="text-emerald-600 group-open:rotate-180 transition-transform">▼</span>
          </summary>
          <p class="mt-3 text-slate-600 leading-relaxed text-xs">
            いいえ。バックグラウンドで数百MBのWhisper等のAIモデルをダウンロードする処理は一切ありません。音声ファイルの波形解析、発話区間（VAD）検出、個人情報伏字化、字幕出力はすべてブラウザ標準のWeb Audio APIとローカルJavaScriptで行われるため、ページ読み込み後にWi-Fiを切断したオフライン状態でも動作します（※マイクによるリアルタイム音声入力のみ、ブラウザ仕様により通信を必要とする場合があります）。
          </p>
        </details>
      </div>
    </section>

    <RelatedTools currentPath="/local-whisper/" />
  </div>

  <!-- セキュリティ仕様書モーダル -->
  <SecuritySpecModal />

  <!-- クライアントサイドスクリプト -->
  <script>
    import {
      analyzeAudioBufferLocal,
      exportToPlainText,
      exportToSrt,
      exportToVtt,
      formatTimestamp,
      generateSampleMeetingWavAndTranscript,
      type TranscriptSegment,
    } from '../utils/audio-transcribe';

    let segments: TranscriptSegment[] = [];
    let currentPeaks: number[] = [];
    let currentDurationSec = 0;
    let currentPreviewFormat: 'txt' | 'srt' | 'vtt' = 'txt';
    let currentAudioUrl: string | null = null;
    let currentBaseFileName = 'meeting_transcript';

    // DOM要素
    const dropZone = document.getElementById('dropZoneAudio')!;
    const fileInput = document.getElementById('fileInputAudio') as HTMLInputElement;
    const loadSampleBtn = document.getElementById('loadSampleAudioBtn')!;
    const toggleMicBtn = document.getElementById('toggleMicDictationBtn')!;
    const micStatusBadge = document.getElementById('micStatusBadge')!;
    const micBtnIcon = document.getElementById('micBtnIcon')!;
    const micBtnLabel = document.getElementById('micBtnLabel')!;

    const workspace = document.getElementById('audioWorkspace')!;
    const audioFileNameLabel = document.getElementById('audioFileNameLabel')!;
    const audioMetaLabel = document.getElementById('audioMetaLabel')!;
    const audioAnalyzeStat = document.getElementById('audioAnalyzeStat')!;
    const waveformCanvas = document.getElementById('waveformCanvas') as HTMLCanvasElement;
    const waveCtx = waveformCanvas.getContext('2d')!;
    const audioPlayer = document.getElementById('localAudioPlayer') as HTMLAudioElement;

    const enablePiiMaskCheckbox = document.getElementById(
      'enablePiiMaskCheckbox'
    ) as HTMLInputElement;
    const addSegmentBtn = document.getElementById('addSegmentBtn')!;
    const segmentCountLabel = document.getElementById('segmentCountLabel')!;
    const segmentListContainer = document.getElementById('segmentListContainer')!;
    const transcriptOutputPreview = document.getElementById(
      'transcriptOutputPreview'
    ) as HTMLTextAreaElement;
    const maskedCountStatBadge = document.getElementById('maskedCountStatBadge')!;

    const copyTranscriptBtn = document.getElementById('copyTranscriptBtn')!;
    const downloadTxtBtn = document.getElementById('downloadTxtBtn')!;
    const downloadSrtBtn = document.getElementById('downloadSrtBtn')!;

    // フォーマット切替タブ
    document.querySelectorAll('.fmt-tab-btn').forEach((btn) => {
      btn.addEventListener('click', (e) => {
        const target = e.currentTarget as HTMLElement;
        const fmt = target.getAttribute('data-fmt') as 'txt' | 'srt' | 'vtt';
        if (!fmt) return;
        currentPreviewFormat = fmt;

        document.querySelectorAll('.fmt-tab-btn').forEach((b) => {
          b.className =
            'fmt-tab-btn px-2.5 py-1 rounded bg-slate-100 hover:bg-slate-200 text-slate-600 border border-slate-200 font-bold text-[11px] cursor-pointer';
        });
        target.className =
          'fmt-tab-btn px-2.5 py-1 rounded bg-purple-600 text-white font-bold text-[11px] shadow-xs cursor-pointer';

        updateOutputPreview();
      });
    });

    enablePiiMaskCheckbox.addEventListener('change', () => {
      updateOutputPreview();
    });

    // D&D ＆ ファイル選択
    dropZone.addEventListener('click', () => fileInput.click());
    dropZone.addEventListener('dragover', (e) => {
      e.preventDefault();
      dropZone.classList.add('border-emerald-500');
    });
    dropZone.addEventListener('dragleave', () => {
      dropZone.classList.remove('border-emerald-500');
    });
    dropZone.addEventListener('drop', async (e) => {
      e.preventDefault();
      dropZone.classList.remove('border-emerald-500');
      if (e.dataTransfer?.files && e.dataTransfer.files[0]) {
        await handleAudioFile(e.dataTransfer.files[0]);
      }
    });

    fileInput.addEventListener('change', async () => {
      if (fileInput.files && fileInput.files[0]) {
        await handleAudioFile(fileInput.files[0]);
        fileInput.value = '';
      }
    });

    // サンプル会議音声読み込み（Windows SAPI生成の日本語音声ファイルを直接再生）
    loadSampleBtn.addEventListener('click', async () => {
      loadSampleBtn.setAttribute('disabled', 'true');
      try {
        const startTime = performance.now();
        let wavBuf: ArrayBuffer;
        let fileName = 'sample_confidential_meeting.wav';
        let sampleSegments: { id: number; startSec: number; endSec: number; text: string }[] = [];

        try {
          const resp = await fetch('/sample_confidential_meeting.wav');
          if (!resp.ok) throw new Error(`HTTP ${resp.status}`);
          wavBuf = await resp.arrayBuffer();
          sampleSegments = [
            {
              id: 1,
              startSec: 0.0,
              endSec: 9.25,
              text: '本日の社外秘経営会議を始めます。新製品の想定単価は月額4万9800円、目標は300社です。',
            },
            {
              id: 2,
              startSec: 9.25,
              endSec: 18.08,
              text: '法務窓口の直通番号は090-1234-5678、連絡先は legal@example.com です。',
            },
            {
              id: 3,
              startSec: 18.08,
              endSec: 27.01,
              text: 'マイナンバー1234-5678-9012などの重要機密は、外部送信せずローカルで安全に処理してください。',
            },
          ];
        } catch {
          // フォールバック: メモリ上でサイン波合成
          const fallback = generateSampleMeetingWavAndTranscript();
          fileName = fallback.fileName;
          wavBuf = fallback.wavBytes.buffer.slice(
            fallback.wavBytes.byteOffset,
            fallback.wavBytes.byteOffset + fallback.wavBytes.byteLength
          ) as ArrayBuffer;
          sampleSegments = fallback.segments.map((s) => ({ ...s }));
        }

        currentBaseFileName = fileName.replace(/\.[^.]+$/, '');
        const analysis = await analyzeAudioBufferLocal(wavBuf);
        currentPeaks = analysis.peaks;
        currentDurationSec = analysis.durationSec;
        segments = sampleSegments;

        setAudioSource(new Uint8Array(wavBuf), 'audio/wav');
        audioFileNameLabel.textContent = fileName;
        audioMetaLabel.textContent = `(${analysis.durationSec.toFixed(1)}秒 / ${analysis.sampleRate}Hz)`;
        const elapsed = ((performance.now() - startTime) / 1000).toFixed(2);
        audioAnalyzeStat.textContent = `⚡ 日本語会議音声＆波形解析完了: ${elapsed}秒 (通信0バイト)`;

        workspace.classList.remove('hidden');
        drawWaveform(0);
        renderSegments();
        updateOutputPreview();
        workspace.scrollIntoView({ behavior: 'smooth', block: 'start' });
      } finally {
        loadSampleBtn.removeAttribute('disabled');
      }
    });

    async function handleAudioFile(file: File) {
      const startTime = performance.now();
      try {
        const buf = await file.arrayBuffer();
        const analysis = await analyzeAudioBufferLocal(buf);
        currentPeaks = analysis.peaks;
        currentDurationSec = analysis.durationSec;
        currentBaseFileName = file.name.replace(/\.[^.]+$/, '');

        segments = analysis.detectedVoiceSegments.map((seg, idx) => ({
          id: idx + 1,
          startSec: seg.startSec,
          endSec: seg.endSec,
          text: `（発話区間 #${idx + 1}：再生しながらここへ発言内容を入力、またはマイク音声入力を使用）`,
        }));

        setAudioSource(new Uint8Array(buf), file.type || 'audio/wav');
        audioFileNameLabel.textContent = file.name;
        audioMetaLabel.textContent = `(${analysis.durationSec.toFixed(1)}秒 / ${analysis.sampleRate}Hz)`;
        const elapsed = ((performance.now() - startTime) / 1000).toFixed(2);
        audioAnalyzeStat.textContent = `⚡ VAD発話区間 ${segments.length}箇所を自動検出 (${elapsed}秒・通信0バイト)`;

        workspace.classList.remove('hidden');
        drawWaveform(0);
        renderSegments();
        updateOutputPreview();
      } catch (err: any) {
        alert(`音声ファイルのデコードに失敗しました: ${err?.message || '未対応の形式です'}`);
      }
    }

    function setAudioSource(bytes: Uint8Array, mimeType: string) {
      if (currentAudioUrl) {
        URL.revokeObjectURL(currentAudioUrl);
      }
      const buf = bytes.buffer.slice(
        bytes.byteOffset,
        bytes.byteOffset + bytes.byteLength
      ) as ArrayBuffer;
      const blob = new Blob([buf], { type: mimeType });
      currentAudioUrl = URL.createObjectURL(blob);
      audioPlayer.src = currentAudioUrl;
    }

    // 波形描画＆再生位置連動
    function drawWaveform(progressRatio: number) {
      const w = waveformCanvas.width;
      const h = waveformCanvas.height;
      waveCtx.clearRect(0, 0, w, h);

      if (currentPeaks.length === 0) return;

      const barCount = currentPeaks.length;
      const gap = 2;
      const barWidth = Math.max(2, (w - gap * barCount) / barCount);

      for (let i = 0; i < barCount; i++) {
        const ratio = i / barCount;
        const val = currentPeaks[i];
        const barH = Math.max(4, val * (h - 14));
        const x = i * (barWidth + gap);
        const y = (h - barH) / 2;

        waveCtx.fillStyle = ratio <= progressRatio ? '#9333ea' : '#cbd5e1';
        waveCtx.fillRect(x, y, barWidth, barH);
      }
    }

    audioPlayer.addEventListener('timeupdate', () => {
      if (currentDurationSec > 0) {
        drawWaveform(audioPlayer.currentTime / currentDurationSec);
      }
    });

    waveformCanvas.addEventListener('click', (e) => {
      if (currentDurationSec <= 0) return;
      const rect = waveformCanvas.getBoundingClientRect();
      const ratio = Math.max(0, Math.min(1, (e.clientX - rect.left) / rect.width));
      audioPlayer.currentTime = ratio * currentDurationSec;
      audioPlayer.play().catch(() => {});
      drawWaveform(ratio);
    });

    function escapeHtml(str: string): string {
      return str
        .replace(/&/g, '&amp;')
        .replace(/</g, '&lt;')
        .replace(/>/g, '&gt;')
        .replace(/"/g, '&quot;');
    }

    function renderSegments() {
      segmentCountLabel.textContent = `${segments.length} 区間`;
      segmentListContainer.innerHTML = segments
        .map(
          (seg, idx) => `
          <div class="p-3 rounded-xl bg-white border border-slate-200 shadow-xs space-y-2">
            <div class="flex items-center justify-between gap-2 text-[11px]">
              <button
                type="button"
                data-seek-sec="${seg.startSec}"
                class="seek-seg-btn px-2.5 py-0.5 rounded bg-purple-50 hover:bg-purple-100 text-purple-700 border border-purple-200 font-mono font-bold transition cursor-pointer"
                title="この発話区間を再生"
              >
                ▶ ${formatTimestamp(seg.startSec)} - ${formatTimestamp(seg.endSec)}
              </button>
              <button
                type="button"
                data-del-idx="${idx}"
                class="del-seg-btn text-slate-400 hover:text-rose-600 transition cursor-pointer"
                title="この行を削除"
              >
                ✕ 削除
              </button>
            </div>
            <textarea
              data-seg-idx="${idx}"
              rows="2"
              class="seg-text-input w-full bg-slate-50 border border-slate-200 focus:border-purple-500 focus:bg-white rounded-lg p-2 text-xs text-slate-800 focus:outline-none leading-relaxed"
            >${escapeHtml(seg.text)}</textarea>
          </div>
        `
        )
        .join('');

      document.querySelectorAll('.seek-seg-btn').forEach((btn) => {
        btn.addEventListener('click', (e) => {
          const target = e.currentTarget as HTMLElement;
          const sec = Number(target.getAttribute('data-seek-sec'));
          audioPlayer.currentTime = sec;
          audioPlayer.play().catch(() => {});
        });
      });

      document.querySelectorAll('.del-seg-btn').forEach((btn) => {
        btn.addEventListener('click', (e) => {
          const target = e.currentTarget as HTMLElement;
          const idx = Number(target.getAttribute('data-del-idx'));
          segments.splice(idx, 1);
          renderSegments();
          updateOutputPreview();
        });
      });

      document.querySelectorAll('.seg-text-input').forEach((ta) => {
        ta.addEventListener('input', (e) => {
          const target = e.currentTarget as HTMLTextAreaElement;
          const idx = Number(target.getAttribute('data-seg-idx'));
          if (segments[idx]) {
            segments[idx].text = target.value;
            updateOutputPreview();
          }
        });
      });
    }

    addSegmentBtn.addEventListener('click', () => {
      const lastEnd = segments.length > 0 ? segments[segments.length - 1].endSec : 0;
      segments.push({
        id: segments.length + 1,
        startSec: Number(lastEnd.toFixed(1)),
        endSec: Number((lastEnd + 3.0).toFixed(1)),
        text: '',
      });
      renderSegments();
      updateOutputPreview();
    });

    function updateOutputPreview() {
      const maskOn = enablePiiMaskCheckbox.checked;
      const plainRes = exportToPlainText(segments, maskOn, true);
      maskedCountStatBadge.textContent = maskOn
        ? `🛡️ 自動伏字化: ${plainRes.maskedCount}箇所`
        : '自動伏字化: OFF';

      if (currentPreviewFormat === 'srt') {
        transcriptOutputPreview.value = exportToSrt(segments, maskOn);
      } else if (currentPreviewFormat === 'vtt') {
        transcriptOutputPreview.value = exportToVtt(segments, maskOn);
      } else {
        transcriptOutputPreview.value = plainRes.text;
      }
    }

    // ブラウザ内蔵 SpeechRecognition によるリアルタイム音声入力
    let recognition: any = null;
    let isRecognizing = false;

    toggleMicBtn.addEventListener('click', () => {
      const SpeechRec =
        (window as any).SpeechRecognition || (window as any).webkitSpeechRecognition;
      if (!SpeechRec) {
        alert(
          'お使いのブラウザはネイティブ音声認識APIに対応していません。ChromeまたはEdgeをご利用いただくか、音声ファイルのドロップ機能をご利用ください。'
        );
        return;
      }

      if (isRecognizing && recognition) {
        recognition.stop();
        return;
      }

      recognition = new SpeechRec();
      recognition.lang = 'ja-JP';
      recognition.continuous = true;
      recognition.interimResults = false;

      recognition.onstart = () => {
        isRecognizing = true;
        micStatusBadge.textContent = '● 音声認識中';
        micStatusBadge.className =
          'px-2 py-0.5 rounded bg-rose-500/20 text-rose-300 text-[10px] font-bold animate-pulse';
        micBtnIcon.textContent = '⏹️';
        micBtnLabel.textContent = '音声認識を停止';
        workspace.classList.remove('hidden');
      };

      recognition.onresult = (event: any) => {
        for (let i = event.resultIndex; i < event.results.length; i++) {
          if (event.results[i].isFinal) {
            const transcript = event.results[i][0].transcript.trim();
            if (transcript) {
              const lastEnd =
                segments.length > 0 ? segments[segments.length - 1].endSec : 0;
              segments.push({
                id: segments.length + 1,
                startSec: lastEnd,
                endSec: lastEnd + 4,
                text: transcript,
              });
              renderSegments();
              updateOutputPreview();
            }
          }
        }
      };

      recognition.onend = () => {
        isRecognizing = false;
        micStatusBadge.textContent = '待機中';
        micStatusBadge.className =
          'px-2 py-0.5 rounded bg-slate-800 text-slate-400 text-[10px] font-bold';
        micBtnIcon.textContent = '⏺️';
        micBtnLabel.textContent = 'リアルタイム音声入力を開始';
      };

      recognition.start();
    });

    // コピー ＆ 保存ボタン
    copyTranscriptBtn.addEventListener('click', () => {
      navigator.clipboard.writeText(transcriptOutputPreview.value).then(() => {
        copyTranscriptBtn.textContent = '✔ コピーしました！';
        setTimeout(() => {
          copyTranscriptBtn.textContent = '📋 テキストをコピー';
        }, 2000);
      });
    });

    downloadTxtBtn.addEventListener('click', () => {
      const maskOn = enablePiiMaskCheckbox.checked;
      const content = exportToPlainText(segments, maskOn, true).text;
      downloadTextFile(content, `${currentBaseFileName}_minutes.txt`, 'text/plain;charset=utf-8');
    });

    downloadSrtBtn.addEventListener('click', () => {
      const maskOn = enablePiiMaskCheckbox.checked;
      const content = exportToSrt(segments, maskOn);
      downloadTextFile(content, `${currentBaseFileName}.srt`, 'text/plain;charset=utf-8');
    });

    function downloadTextFile(content: string, filename: string, mime: string) {
      const blob = new Blob([content], { type: mime });
      const url = URL.createObjectURL(blob);
      const a = document.createElement('a');
      a.href = url;
      a.download = filename;
      document.body.appendChild(a);
      a.click();
      document.body.removeChild(a);
      URL.revokeObjectURL(url);
    }
  </script>
</Layout>
