---
import Layout from '../layouts/Layout.astro';
import SecuritySpecModal from './SecuritySpecModal.astro';
import RelatedTools from './RelatedTools.astro';
import WhySection from './WhySection.astro';
import Mascot from './Mascot.astro';
import { toolBySlug } from '../data/tools';

export interface FaqItem {
  question: string;
  answer: string;
}

export interface HowToStepItem {
  name: string;
  text: string;
}

interface Props {
  slug: string;
  title: string;
  description: string;
  canonicalPath: string;
  h1: string;
  subtitle: string;
  mascotName?: string;
  mascotFallback?: string;
  whyTitle?: string;
  howToSteps?: HowToStepItem[];
  faqs?: FaqItem[];
  customSchema?: any[];
  maxWidthClass?: string; // デフォルトは max-w-5xl
}

const {
  slug,
  title,
  description,
  canonicalPath,
  h1,
  subtitle,
  mascotName,
  mascotFallback = '🛡️',
  whyTitle,
  howToSteps = [],
  faqs = [],
  customSchema = [],
  maxWidthClass = 'max-w-5xl',
} = Astro.props;

// 構造化データの自動生成（HowTo + FAQPage）
const schemaGraph: any[] = [...customSchema];

if (howToSteps.length > 0) {
  schemaGraph.push({
    '@type': 'HowTo',
    name: `${h1}をブラウザで安全に実行する手順（サーバー送信なし）`,
    description,
    step: howToSteps.map((step) => ({
      '@type': 'HowToStep',
      name: step.name,
      text: step.text,
    })),
  });
}

if (faqs.length > 0) {
  schemaGraph.push({
    '@type': 'FAQPage',
    mainEntity: faqs.map((f) => ({
      '@type': 'Question',
      name: f.question,
      acceptedAnswer: {
        '@type': 'Answer',
        text: f.answer,
      },
    })),
  });
}

// ツールマスコットの決定
const effectiveMascotName = mascotName || (slug ? toolBySlug(slug)?.image : undefined);
---

<Layout
  title={title}
  description={description}
  canonicalPath={canonicalPath}
  extraSchemaGraph={schemaGraph}
  allowAds={false}
>
  <div class={`${maxWidthClass} mx-auto space-y-5 sm:space-y-7`}>
    
    <!-- ツールヘッダー（ファーストビュー最優先・3秒作業開始 Above the Fold） -->
    <div class="space-y-2 text-left">
      <!-- 最上部メタバー：信頼バナー（実測ステータス） ＆ 情シス仕様書ボタンを横並び1行に集約 -->
      <div class="flex items-center justify-between gap-2">
        <div
          id="liveNetStatusPill"
          class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full bg-emerald-50 border border-emerald-200 text-emerald-900 text-[11px] sm:text-xs font-semibold"
        >
          <span class="w-2 h-2 rounded-full bg-emerald-600 shrink-0" aria-hidden="true"></span>
          <span>サーバー送信0バイト保証</span>
          <span id="liveNetAuditText" class="text-[11px] text-emerald-800 font-semibold hidden sm:inline">・外部通信 0件（F12確認済）</span>
        </div>
        <button
          type="button"
          onclick="window.openSecurityModal && window.openSecurityModal()"
          class="inline-flex items-center gap-1 px-2.5 py-1 min-h-[36px] sm:min-h-[40px] rounded-lg bg-white hover:bg-slate-50 text-slate-700 hover:text-slate-900 text-xs font-semibold border border-slate-200 shadow-sm transition cursor-pointer shrink-0"
        >
          <span aria-hidden="true">🏢</span>
          <span class="hidden sm:inline">社内利用・</span><span>情シス仕様書</span>
        </button>
      </div>

      <!-- タイトル ＆ マスコット ＆ サンプル投入スロット -->
      <div class="flex items-center justify-between gap-3 sm:gap-6 pt-0.5">
        <div class="min-w-0 flex-1 space-y-1">
          <h1 class="text-xl sm:text-2xl lg:text-3xl font-extrabold text-slate-900 tracking-tight leading-tight">
            {h1}
          </h1>
          <p class="text-slate-700 text-xs leading-snug line-clamp-2 sm:line-clamp-none">
            {subtitle}
          </p>
          {Astro.slots.has('sample-button') && (
            <div class="pt-1.5 flex flex-wrap items-center gap-2">
              <slot name="sample-button" />
            </div>
          )}
        </div>
        {effectiveMascotName && (
          <Mascot
            name={effectiveMascotName}
            fallback={mascotFallback}
            width={160}
            eager
            class="w-16 sm:w-28 aspect-[4/3] object-cover rounded-xl shadow-sm border border-slate-100 shrink-0"
          />
        )}
      </div>
    </div>

    <!-- メイン操作エリア（各ツール固有のWASM/JSワークスペース＆ファイルドロップゾーン） -->
    <slot />

    <!-- 3コマ図解パネル（WhySection） -->
    {slug && (
      <WhySection
        slug={slug}
        title={whyTitle || '「無料サイトだから」とアップロードする前に知るべき重大リスク'}
      />
    )}

    <!-- 【FAQPage】利用前・社外共有前の重要チェックポイント（よくある質問・重複排除＆第1問展開） -->
    {faqs.length > 0 && (
      <section class="space-y-3 pt-2 text-left">
        <div class="border-b border-slate-200 pb-2 flex items-center justify-between">
          <h2 class="text-base sm:text-lg font-bold text-slate-900 flex items-center gap-2">
            <span aria-hidden="true">💡</span>
            <span>利用前・社外共有前の重要チェックポイント（よくある質問）</span>
          </h2>
          <span class="text-xs text-slate-600 font-mono">全{faqs.length}問</span>
        </div>

        <div class="space-y-2.5 text-xs sm:text-sm text-slate-700">
          {faqs.map((f, i) => (
            <details class="group p-3.5 sm:p-4 rounded-xl bg-white border border-slate-200 hover:border-slate-300 shadow-sm transition" open={i === 0}>
              <summary class="font-bold text-slate-900 cursor-pointer flex items-center justify-between gap-2 list-none select-none min-h-[44px]">
                <span class="flex items-start gap-2">
                  <span class="text-emerald-700 font-bold shrink-0">Q.</span>
                  <span>{f.question}</span>
                </span>
                <span class="text-slate-600 group-open:rotate-180 transition-transform text-xs shrink-0">▼</span>
              </summary>
              <div class="mt-2 pt-2.5 border-t border-slate-100 text-slate-700 leading-relaxed text-xs sm:text-sm">
                <span class="font-bold text-emerald-800 mr-1.5">A.</span>
                {f.answer}
              </div>
            </details>
          ))}
        </div>
      </section>
    )}

    <!-- 相互回遊リンク -->
    <RelatedTools currentPath={canonicalPath} />

  </div>

  <!-- セキュリティ仕様書モーダル -->
  <SecuritySpecModal />

  <script is:inline>
    (function () {
      function countExternalRequests() {
        if (!('performance' in window) || !performance.getEntriesByType) return 0;
        var entries = performance.getEntriesByType('resource');
        var ext = 0;
        for (var i = 0; i < entries.length; i++) {
          try {
            var u = new URL(entries[i].name, location.href);
            if ((u.protocol === 'http:' || u.protocol === 'https:') && u.origin !== location.origin) {
              ext++;
            }
          } catch (e) {}
        }
        return ext;
      }
      window.addEventListener('load', function () {
        var el = document.getElementById('liveNetAuditText');
        if (!el) return;
        var ext = countExternalRequests();
        el.textContent = '・外部通信 ' + ext + '件（F12実測確認済）';
      });
    })();
  </script>
</Layout>
