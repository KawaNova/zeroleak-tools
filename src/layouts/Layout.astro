---
interface Props {
  title: string;
  description: string;
  canonicalPath?: string;
  extraSchemaGraph?: any[];
}

const { title, description, canonicalPath = '/', extraSchemaGraph = [] } = Astro.props;
const siteUrl = 'https://zeroleaktools.com';
const fullCanonical = `${siteUrl}${canonicalPath.startsWith('/') ? canonicalPath : `/${canonicalPath}`}`;

const schemaOrg = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebSite",
      "@id": `${siteUrl}/#website`,
      "url": siteUrl,
      "name": "ZeroLeak Tools (ゼロリーク・ツールズ)",
      "description": "サーバー送信0バイト・完全ブラウザ完結のセキュア業務ツール群。給与明細PDFパスワード解除、個人情報CSV伏字化など。",
      "inLanguage": "ja"
    },
    {
      "@type": "WebApplication",
      "@id": fullCanonical,
      "url": fullCanonical,
      "name": title,
      "description": description,
      "applicationCategory": "BusinessApplication",
      "operatingSystem": "All",
      "offers": {
        "@type": "Offer",
        "price": "0",
        "priceCurrency": "JPY"
      }
    },
    ...extraSchemaGraph
  ]
};
---

<!doctype html>
<html lang="ja" class="h-full bg-slate-900 text-slate-100">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title} | ZeroLeak Tools (完全ローカル完結)</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={fullCanonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    
    <!-- Google AdSense -->
    <script async src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-9978047733183188" crossorigin="anonymous"></script>

    <!-- CSP: AdSense表示およびローカル処理の整合性維持 -->
    <meta http-equiv="Content-Security-Policy" content="default-src 'self' 'unsafe-inline' 'unsafe-eval' blob: data: https://*.googlesyndication.com https://*.google.com https://*.doubleclick.net; connect-src 'self' blob: data: https://*.googlesyndication.com https://*.google.com https://*.doubleclick.net; img-src 'self' data: blob: https://*.googlesyndication.com https://*.doubleclick.net https://*.google.com; frame-src 'self' https://*.google.com https://*.doubleclick.net https://*.googlesyndication.com; script-src 'self' 'unsafe-inline' 'unsafe-eval' blob: https://*.googlesyndication.com https://*.google.com https://pagead2.googlesyndication.com; worker-src 'self' blob:;" />

    <!-- OGP -->
    <meta property="og:title" content={`${title} | ZeroLeak Tools`} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={fullCanonical} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="ZeroLeak Tools" />

    <!-- JSON-LD -->
    <script type="application/ld+json" set:html={JSON.stringify(schemaOrg)} />
  </head>
  <body class="flex flex-col min-h-screen bg-slate-50 text-slate-800 font-sans antialiased selection:bg-emerald-500 selection:text-white">
    <!-- 常設: F12検証・サーバー送信0バイト保証バナー（スマホ超スリム化対応・クリーンライト配色） -->
    <aside aria-label="サーバー送信0バイト保証案内" class="bg-emerald-50/90 border-b border-emerald-200/80 text-emerald-900 text-[11px] sm:text-xs py-1.5 px-3 sm:px-4 shadow-[0_1px_2px_rgba(0,0,0,0.03)]">
      <div class="max-w-6xl mx-auto flex items-center justify-between gap-2">
        <div class="flex items-center gap-1.5 font-medium truncate">
          <span class="text-xs">🛡️</span>
          <span class="truncate"><strong>サーバー送信0バイト保証</strong><span class="hidden sm:inline">：ファイルは一切外部へ送信されません</span></span>
        </div>
        <div class="flex items-center gap-1 text-[10px] sm:text-[11px] text-emerald-800 bg-white/90 px-2 py-0.5 rounded-full border border-emerald-300 shadow-xs shrink-0 font-medium">
          <span>✈️</span>
          <span>Wi-Fi切断でも動作</span>
          <span class="text-[10px] text-emerald-600 hidden md:inline">(F12で通信0件検証可)</span>
        </div>
      </div>
    </aside>

    <!-- ヘッダーナビゲーション（スマホ横スクロール＆現在地ハイライト対応・白基調） -->
    <header class="border-b border-slate-200/90 bg-white/95 backdrop-blur-md sticky top-0 z-50 shadow-[0_1px_3px_rgba(0,0,0,0.04)]">
      <div class="max-w-6xl mx-auto px-4 py-2.5 flex flex-col lg:flex-row lg:items-center lg:justify-between gap-2">
        <div class="flex items-center justify-between">
          <a href="/" class="flex items-center gap-2.5 group shrink-0">
            <div class="w-8 h-8 rounded-lg bg-emerald-50 border border-emerald-200 flex items-center justify-center group-hover:border-emerald-400 group-hover:bg-emerald-100 transition-colors shadow-xs">
              <svg class="w-4 h-4 text-emerald-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z" />
              </svg>
            </div>
            <div class="flex flex-col">
              <span class="font-bold text-base sm:text-lg text-slate-900 tracking-tight flex items-center gap-1.5">
                ZeroLeak <span class="text-[10px] font-semibold px-1.5 py-0.5 rounded bg-emerald-100 text-emerald-800 border border-emerald-200">WASM</span>
              </span>
              <span class="text-[10px] text-slate-500 -mt-0.5 font-medium">完全ローカル・機密漏洩リスク0%</span>
            </div>
          </a>
          <a href="/legal/" class="lg:hidden px-2.5 py-1 rounded-lg text-[11px] text-slate-600 hover:text-slate-900 border border-slate-200 bg-slate-50 font-medium">
            免責・法務
          </a>
        </div>

        <nav aria-label="ツールナビゲーション" class="flex items-center gap-1 sm:gap-1.5 overflow-x-auto no-scrollbar pb-1 lg:pb-0 text-xs font-medium">
          <a
            href="/csv-masking/"
            class={`px-2.5 py-1.5 rounded-lg whitespace-nowrap transition ${canonicalPath === '/csv-masking/' ? 'bg-emerald-100/80 text-emerald-900 border border-emerald-300 font-bold' : 'text-slate-600 hover:text-slate-900 hover:bg-slate-100'}`}
          >
            📄 CSVマスク
          </a>
          <a
            href="/pdf-unlock/"
            class={`px-2.5 py-1.5 rounded-lg whitespace-nowrap transition ${canonicalPath === '/pdf-unlock/' ? 'bg-teal-100/80 text-teal-900 border border-teal-300 font-bold' : 'text-slate-600 hover:text-slate-900 hover:bg-slate-100'}`}
          >
            🔓 PDF解除
          </a>
          <a
            href="/exif-remover/"
            class={`px-2.5 py-1.5 rounded-lg whitespace-nowrap transition ${canonicalPath === '/exif-remover/' ? 'bg-cyan-100/80 text-cyan-900 border border-cyan-300 font-bold' : 'text-slate-600 hover:text-slate-900 hover:bg-slate-100'}`}
          >
            📍 EXIF削除
          </a>
          <a
            href="/local-mosaic/"
            class={`px-2.5 py-1.5 rounded-lg whitespace-nowrap transition ${canonicalPath === '/local-mosaic/' ? 'bg-indigo-100/80 text-indigo-900 border border-indigo-300 font-bold' : 'text-slate-600 hover:text-slate-900 hover:bg-slate-100'}`}
          >
            🕶️ 画像モザイク
          </a>
          <a
            href="/local-whisper/"
            class={`px-2.5 py-1.5 rounded-lg whitespace-nowrap transition ${canonicalPath === '/local-whisper/' ? 'bg-purple-100/80 text-purple-900 border border-purple-300 font-bold' : 'text-slate-600 hover:text-slate-900 hover:bg-slate-100'}`}
          >
            🎙️ 音声文字起こし
          </a>
          <a
            href="/ai-prompt-sanitizer/"
            class={`px-2.5 py-1.5 rounded-lg whitespace-nowrap transition ${canonicalPath === '/ai-prompt-sanitizer/' ? 'bg-amber-100/80 text-amber-900 border border-amber-300 font-bold' : 'text-slate-600 hover:text-slate-900 hover:bg-slate-100'}`}
          >
            🤖 AI匿名化
          </a>
          <a href="/legal/" class="hidden lg:inline-block px-2 py-1.5 rounded-lg text-slate-500 hover:text-slate-800 transition whitespace-nowrap">
            免責・法務
          </a>
        </nav>
      </div>
    </header>

    <!-- メインコンテンツ -->
    <main class="flex-1 max-w-6xl w-full mx-auto px-4 py-8">
      <slot />
    </main>

    <!-- フッター（白基調・信頼感デザイン） -->
    <footer class="border-t border-slate-200 bg-white py-8 text-xs text-slate-500 mt-auto">
      <div class="max-w-6xl mx-auto px-4 flex flex-col sm:flex-row items-center justify-between gap-4">
        <div class="flex flex-col gap-1 text-center sm:text-left">
          <p class="font-bold text-slate-800">ZeroLeak Tools（ゼロリーク・ツールズ）</p>
          <p class="text-[11px] text-slate-500">
            すべての処理はお使いのブラウザ内部（メモリ上）でのみ実行されます。サーバーログへの保存、外部転送は技術的に一切行われません。
          </p>
        </div>
        <div class="flex flex-wrap items-center gap-4 text-slate-600 font-medium">
          <a href="/csv-masking/" class="hover:text-emerald-700 transition">CSVマスキング</a>
          <a href="/pdf-unlock/" class="hover:text-emerald-700 transition">PDFパスワード解除</a>
          <a href="/exif-remover/" class="hover:text-emerald-700 transition">写真EXIF・GPS一括削除</a>
          <a href="/local-mosaic/" class="hover:text-emerald-700 transition">画像モザイク・黒塗り</a>
          <a href="/local-whisper/" class="hover:text-emerald-700 transition">社外秘音声文字起こし</a>
          <a href="/ai-prompt-sanitizer/" class="hover:text-amber-700 transition">AIプロンプト匿名化＆復元</a>
          <a href="/legal/" class="hover:text-emerald-700 transition">免責事項・プライバシー規約</a>
        </div>
      </div>
      <div class="max-w-6xl mx-auto px-4 mt-6 pt-4 border-t border-slate-100 text-center text-[10px] text-slate-400">
        &copy; 2026 ZeroLeak Tools. All rights reserved. Powered by Astro &amp; Client-side WASM.
      </div>
    </footer>
  </body>
</html>
