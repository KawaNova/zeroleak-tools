---
interface Props {
  title: string;
  description: string;
  canonicalPath?: string;
  extraSchemaGraph?: any[];
}

const { title, description, canonicalPath = '/', extraSchemaGraph = [] } = Astro.props;
const siteUrl = 'https://zeroleaktools.com';
const fullCanonical = `${siteUrl}${canonicalPath.startsWith('/') ? canonicalPath : `/${canonicalPath}`}`;

const fullTitle = canonicalPath === '/' || title.includes('ZeroLeak')
  ? title
  : `${title} - ZeroLeak Tools`;

const schemaOrg = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebSite",
      "@id": `${siteUrl}/#website`,
      "url": siteUrl,
      "name": "ZeroLeak Tools (ゼロリーク・ツールズ)",
      "description": "サーバー送信0バイト・完全ブラウザ完結のセキュア業務ツール群。給与明細PDFパスワード解除、個人情報CSV伏字化など。",
      "inLanguage": "ja"
    },
    {
      "@type": "WebApplication",
      "@id": fullCanonical,
      "url": fullCanonical,
      "name": title,
      "description": description,
      "applicationCategory": "BusinessApplication",
      "operatingSystem": "All",
      "offers": {
        "@type": "Offer",
        "price": "0",
        "priceCurrency": "JPY"
      }
    },
    ...extraSchemaGraph
  ]
};
---

<!doctype html>
<html lang="ja" class="h-full bg-slate-900 text-slate-100">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={fullCanonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    
    <!-- Google AdSense -->
    <script async src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-9978047733183188" crossorigin="anonymous"></script>

    <!-- CSP: AdSense表示およびローカル処理の整合性維持 -->
    <meta http-equiv="Content-Security-Policy" content="default-src 'self' 'unsafe-inline' 'unsafe-eval' blob: data: https://*.googlesyndication.com https://*.google.com https://*.doubleclick.net; connect-src 'self' blob: data: https://*.googlesyndication.com https://*.google.com https://*.doubleclick.net; img-src 'self' data: blob: https://*.googlesyndication.com https://*.doubleclick.net https://*.google.com; frame-src 'self' https://*.google.com https://*.doubleclick.net https://*.googlesyndication.com; script-src 'self' 'unsafe-inline' 'unsafe-eval' blob: https://*.googlesyndication.com https://*.google.com https://pagead2.googlesyndication.com; worker-src 'self' blob:;" />

    <!-- OGP -->
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={fullCanonical} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="ZeroLeak Tools" />

    <!-- JSON-LD -->
    <script type="application/ld+json" set:html={JSON.stringify(schemaOrg)} />
  </head>
  <body class="flex flex-col min-h-screen bg-slate-50 text-slate-800 font-sans antialiased selection:bg-emerald-500 selection:text-white overflow-x-hidden">
    <!-- ヘッダー（清潔感ある白基調・スライドバー完全撤去・スマホ最適化） -->
    <header class="border-b border-slate-200/90 bg-white/95 backdrop-blur-md sticky top-0 z-50 shadow-[0_1px_3px_rgba(0,0,0,0.04)]">
      <div class="max-w-6xl mx-auto px-3 sm:px-4 py-2.5 sm:py-3 flex items-center justify-between gap-2">
        <a href="/" class="flex items-center gap-1.5 sm:gap-2 group shrink-0">
          <div class="w-7 h-7 sm:w-8 sm:h-8 rounded-lg bg-emerald-50 border border-emerald-200 flex items-center justify-center group-hover:border-emerald-400 group-hover:bg-emerald-100 transition-colors shadow-xs shrink-0">
            <svg class="w-3.5 h-3.5 sm:w-4 sm:h-4 text-emerald-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z" />
            </svg>
          </div>
          <div class="flex flex-col">
            <span class="font-bold text-sm sm:text-base text-slate-900 tracking-tight flex items-center gap-1.5 leading-none">
              <span>ZeroLeak Tools</span>
              <span class="text-xs font-normal text-slate-400 hidden md:inline">|</span>
              <span class="text-xs font-semibold text-emerald-800 hidden md:inline">機密ファイル安心処理</span>
            </span>
            <span class="text-[9px] text-slate-500 mt-0.5 font-medium hidden sm:block">外部送信なし・完全ローカル処理</span>
          </div>
        </a>

        <div class="flex items-center gap-1.5 sm:gap-2 shrink-0">
          <a
            href="/"
            class={`text-xs font-semibold px-2.5 py-1.5 rounded-lg transition ${canonicalPath === '/' ? 'text-emerald-800 bg-emerald-50' : 'text-slate-600 hover:text-slate-900 hover:bg-slate-50'}`}
          >
            <span class="sm:hidden">ツール</span>
            <span class="hidden sm:inline">ツール一覧</span>
          </a>
          <a
            href="/legal/"
            class={`text-xs font-semibold px-2.5 py-1.5 rounded-lg transition ${canonicalPath === '/legal/' ? 'text-emerald-800 bg-emerald-50' : 'text-slate-600 hover:text-slate-900 hover:bg-slate-50'}`}
          >
            <span class="sm:hidden">利用規約</span>
            <span class="hidden sm:inline">利用規約・プライバシー</span>
          </a>
        </div>
      </div>
    </header>

    <!-- メインコンテンツ -->
    <main class="flex-1 max-w-6xl w-full mx-auto px-3 sm:px-4 py-4 sm:py-8 overflow-x-hidden">
      <slot />
    </main>

    <!-- フッター（白基調・信頼感デザイン） -->
    <footer class="border-t border-slate-200 bg-white py-8 text-xs text-slate-500 mt-auto">
      <div class="max-w-6xl mx-auto px-4 flex flex-col sm:flex-row items-center justify-between gap-4">
        <div class="flex flex-col gap-1 text-center sm:text-left">
          <p class="font-bold text-slate-800">ZeroLeak Tools（ゼロリーク・ツールズ）</p>
          <p class="text-[11px] text-slate-500">
            すべての処理はお使いのブラウザ内部（メモリ上）でのみ実行されます。サーバーログへの保存、外部転送は技術的に一切行われません（サーバー送信0バイト保証）。
          </p>
        </div>
        <div class="flex flex-wrap items-center gap-4 text-slate-600 font-medium">
          <a href="/csv-masking/" class="hover:text-emerald-700 transition">CSVマスキング</a>
          <a href="/pdf-unlock/" class="hover:text-emerald-700 transition">PDFパスワード解除</a>
          <a href="/exif-remover/" class="hover:text-emerald-700 transition">写真EXIF・GPS一括削除</a>
          <a href="/local-mosaic/" class="hover:text-emerald-700 transition">画像モザイク・黒塗り</a>
          <a href="/ai-prompt-sanitizer/" class="hover:text-amber-700 transition">AIプロンプト匿名化＆復元</a>
          <a href="/log-masking/" class="hover:text-cyan-700 transition">HAR・ログ・.envマスク</a>
          <a href="/pdf-redaction/" class="hover:text-slate-900 transition">機密PDF完全黒塗り</a>
          <a href="/contract-diff/" class="hover:text-violet-700 transition">契約書・NDA Diff比較</a>
          <a href="/id-watermark/" class="hover:text-blue-700 transition">身分証透かし焼き込み</a>
          <a href="/office-metadata-wiper/" class="hover:text-teal-700 transition">Officeメタデータ消去</a>
          <a href="/legal/" class="hover:text-emerald-700 transition">免責事項・プライバシー規約</a>
        </div>
      </div>
      <div class="max-w-6xl mx-auto px-4 mt-6 pt-4 border-t border-slate-100 text-center text-[10px] text-slate-400">
        &copy; 2026 ZeroLeak Tools. All rights reserved. 完全ブラウザ完結・プライバシー保護設計
      </div>
    </footer>
  </body>
</html>
